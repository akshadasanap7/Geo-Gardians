        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap');\n  .sy-responder * { box-sizing: border-box; }\n  .sy-responder { --ink:#08121D; --slate:#0E1D2C; --elevated:#152A3D; --line:#29465C; --text:#EDF5F8; --muted:#9BAEBD; --mint:#1BD1A5; --cyan:#5AA7FF; --amber:#E7B84B; --coral:#FF6870; background:var(--ink); color:var(--text); font-family:Inter,ui-sans-serif,system-ui,sans-serif; min-height:100vh; padding:24px 28px 40px; }\n  .sy-responder button { font:inherit; cursor:pointer; }\n  .sy-responder .mono { font-family:'JetBrains Mono',ui-monospace,monospace; }\n  .sy-responder .topbar { display:flex; align-items:center; justify-content:space-between; gap:18px; min-height:62px; border-bottom:1px solid var(--line); padding-bottom:18px; }\n  .sy-responder .brand { display:flex; align-items:center; gap:12px; min-width:0; }\n  .sy-responder .brand-mark { width:34px; height:34px; display:grid; place-items:center; color:var(--mint); border:1px solid rgba(27,209,165,.45); border-radius:9px; background:rgba(27,209,165,.08); }\n  .sy-responder .brand-name { font-size:14px; font-weight:800; letter-spacing:-.02em; }\n  .sy-responder .brand-name span { color:var(--mint); }\n  .sy-responder .brand-sub { color:var(--muted); font-size:10px; margin-top:3px; letter-spacing:.12em; text-transform:uppercase; }\n  .sy-responder .top-meta { display:flex; align-items:center; justify-content:flex-end; gap:10px; flex-wrap:wrap; }\n  .sy-responder .pill { display:inline-flex; align-items:center; gap:7px; min-height:34px; padding:0 11px; border:1px solid var(--line); border-radius:8px; background:rgba(21,42,61,.72); color:var(--muted); font-size:11px; font-weight:700; }\n  .sy-responder .pill.good { border-color:rgba(27,209,165,.38); color:#8BEAD1; background:rgba(27,209,165,.08); }\n  .sy-responder .pill.warn { border-color:rgba(231,184,75,.42); color:#F4D98B; background:rgba(231,184,75,.08); }\n  .sy-responder .dot { width:7px; height:7px; border-radius:50%; background:var(--mint); }\n  .sy-responder .dot.amber { background:var(--amber); }\n  .sy-responder .eyebrow { color:var(--muted); font-size:10px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; }\n  .sy-responder .mono-label { color:var(--muted); font-size:10px; letter-spacing:.1em; text-transform:uppercase; }\n  .sy-responder .hero { display:flex; align-items:flex-end; justify-content:space-between; gap:22px; padding:30px 0 24px; }\n  .sy-responder h1 { margin:8px 0 0; font-size:clamp(24px,3vw,36px); line-height:1.08; letter-spacing:-.045em; }\n  .sy-responder .hero-copy { max-width:680px; color:var(--muted); font-size:13px; line-height:1.65; margin-top:10px; }\n  .sy-responder .hero-actions { display:flex; align-items:center; gap:9px; flex-wrap:wrap; justify-content:flex-end; }\n  .sy-responder .btn { min-height:42px; padding:0 14px; border:1px solid var(--line); border-radius:8px; background:transparent; color:var(--text); font-size:12px; font-weight:800; display:inline-flex; align-items:center; justify-content:center; gap:8px; }\n  .sy-responder .btn:hover { border-color:var(--mint); color:var(--mint); }\n  .sy-responder .btn.primary { border-color:var(--mint); background:var(--mint); color:var(--ink); }\n  .sy-responder .btn.primary:hover { background:#8BEAD1; }\n  .sy-responder .btn.critical { border-color:rgba(255,104,112,.55); color:#FFB5B9; background:rgba(255,104,112,.1); }\n  .sy-responder .btn.critical:hover { background:rgba(255,104,112,.2); }\n  .sy-responder .btn.small { min-height:36px; padding:0 11px; font-size:11px; }\n  .sy-responder .kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; margin-bottom:14px; }\n  .sy-responder .kpi { border:1px solid var(--line); border-radius:10px; background:var(--slate); padding:14px 15px; }\n  .sy-responder .kpi-top { display:flex; justify-content:space-between; align-items:center; gap:8px; }\n  .sy-responder .kpi-value { margin-top:12px; color:var(--text); font-family:'JetBrains Mono',monospace; font-size:24px; font-weight:700; letter-spacing:-.04em; }\n  .sy-responder .kpi-value.mint { color:var(--mint); }\n  .sy-responder .kpi-value.cyan { color:var(--cyan); }\n  .sy-responder .kpi-value.coral { color:var(--coral); }\n  .sy-responder .kpi-detail { color:var(--muted); font-size:11px; margin-top:5px; }\n  .sy-responder .workspace { display:grid; grid-template-columns:290px minmax(420px,1fr) 320px; gap:14px; align-items:start; }\n  .sy-responder .panel { min-width:0; border:1px solid var(--line); border-radius:10px; background:var(--slate); overflow:hidden; }\n  .sy-responder .panel-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; padding:16px; border-bottom:1px solid var(--line); }\n  .sy-responder .panel-title { margin-top:5px; font-size:14px; font-weight:800; letter-spacing:-.02em; }\n  .sy-responder .panel-body { padding:14px; }\n  .sy-responder .queue { min-height:608px; }\n  .sy-responder .queue-summary { color:var(--muted); font-size:11px; line-height:1.5; }\n  .sy-responder .incident { display:block; width:100%; border:1px solid var(--line); border-radius:8px; background:#102337; color:var(--text); text-align:left; padding:13px; margin-bottom:9px; }\n  .sy-responder .incident.active { border-color:rgba(255,104,112,.7); background:rgba(255,104,112,.08); }\n  .sy-responder .incident:hover { border-color:var(--mint); }\n  .sy-responder .incident-row { display:flex; justify-content:space-between; align-items:flex-start; gap:8px; }\n  .sy-responder .incident-id { font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:700; }\n  .sy-responder .severity { border:1px solid rgba(255,104,112,.45); border-radius:999px; padding:4px 7px; color:#FFB5B9; font-size:9px; font-weight:800; letter-spacing:.08em; }\n  .sy-responder .severity.high { border-color:rgba(231,184,75,.45); color:#F4D98B; }\n  .sy-responder .incident-name { margin-top:11px; font-size:13px; font-weight:800; }\n  .sy-responder .incident-copy { margin-top:5px; color:var(--muted); font-size:11px; line-height:1.5; }\n  .sy-responder .incident-foot { display:flex; justify-content:space-between; gap:10px; margin-top:12px; padding-top:10px; border-top:1px solid rgba(41,70,92,.7); color:var(--muted); font-size:10px; }\n  .sy-responder .map-panel { background:var(--slate); }\n  .sy-responder .map-wrap { padding:14px; }\n  .sy-responder .map { position:relative; height:420px; border:1px solid var(--line); border-radius:8px; overflow:hidden; background:#0B2535; }\n  .sy-responder .map svg { width:100%; height:100%; display:block; }\n  .sy-responder .map-label { position:absolute; color:#B7CAD5; font-size:10px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; }\n  .sy-responder .map-label.start { left:13%; bottom:18%; }\n  .sy-responder .map-label.target { right:12%; top:18%; color:#FFB5B9; }\n  .sy-responder .map-chip { position:absolute; top:12px; left:12px; display:flex; align-items:center; gap:8px; border:1px solid rgba(27,209,165,.35); border-radius:8px; padding:9px 10px; background:rgba(8,18,29,.9); font-size:11px; font-weight:800; }\n  .sy-responder .map-chip .dot { box-shadow:0 0 0 4px rgba(27,209,165,.13); }\n  .sy-responder .map-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-top:10px; }\n  .sy-responder .map-stat { border:1px solid var(--line); border-radius:8px; padding:10px; background:#102337; }\n  .sy-responder .map-stat strong { display:block; margin-top:5px; font-family:'JetBrains Mono',monospace; font-size:13px; }\n  .sy-responder .map-stat span { color:var(--muted); font-size:10px; }\n  .sy-responder .legend { display:flex; gap:14px; flex-wrap:wrap; margin-top:10px; color:var(--muted); font-size:10px; }\n  .sy-responder .legend i { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:5px; }\n  .sy-responder .legend .route { background:var(--cyan); }\n  .sy-responder .legend .target { background:var(--coral); }\n  .sy-responder .legend .safe { background:var(--mint); }\n  .sy-responder .fallback { display:flex; align-items:flex-start; gap:9px; border:1px solid rgba(231,184,75,.35); border-radius:8px; background:rgba(231,184,75,.08); padding:11px; margin-top:10px; color:#F4D98B; font-size:11px; line-height:1.5; }\n  .sy-responder .fallback strong { display:block; color:#FFE4A7; }\n  .sy-responder .dispatch { min-height:608px; }\n  .sy-responder .dispatch-risk { display:flex; align-items:center; justify-content:space-between; gap:12px; border-bottom:1px solid var(--line); padding-bottom:14px; }\n  .sy-responder .risk-score { color:var(--coral); font-family:'JetBrains Mono',monospace; font-size:25px; font-weight:700; }\n  .sy-responder .risk-score small { color:#FFB5B9; font-size:10px; font-family:Inter,sans-serif; letter-spacing:.08em; }\n  .sy-responder .fact-list { margin-top:9px; }\n  .sy-responder .fact { display:flex; justify-content:space-between; gap:12px; padding:11px 0; border-bottom:1px solid rgba(41,70,92,.7); }\n  .sy-responder .fact:last-child { border-bottom:0; }\n  .sy-responder .fact span:first-child { color:var(--muted); font-size:11px; }\n  .sy-responder .fact span:last-child { color:var(--text); font-size:11px; font-weight:700; text-align:right; }\n  .sy-responder .verified { display:flex; align-items:center; gap:9px; border:1px solid rgba(27,209,165,.32); border-radius:8px; background:rgba(27,209,165,.08); padding:11px; margin-top:14px; }\n  .sy-responder .verified strong { display:block; color:#8BEAD1; font-size:11px; }\n  .sy-responder .verified span { display:block; color:var(--muted); font-size:10px; margin-top:3px; }\n  .sy-responder .dispatch-actions { display:grid; grid-template-columns:1fr; gap:8px; margin-top:14px; }\n  .sy-responder .timeline { margin-top:18px; border-top:1px solid var(--line); padding-top:15px; }\n  .sy-responder .step { position:relative; display:flex; gap:10px; padding-bottom:16px; }\n  .sy-responder .step:last-child { padding-bottom:0; }\n  .sy-responder .step-line { position:absolute; left:6px; top:16px; height:calc(100% - 4px); width:1px; background:var(--line); }\n  .sy-responder .step-dot { position:relative; z-index:1; flex:0 0 13px; height:13px; border:2px solid var(--mint); border-radius:50%; background:var(--slate); }\n  .sy-responder .step.pending .step-dot { border-color:var(--line); }\n  .sy-responder .step strong { font-size:11px; }\n  .sy-responder .step span { display:block; color:var(--muted); font-size:10px; margin-top:3px; }\n  .sy-responder .offline { display:flex; align-items:center; justify-content:space-between; gap:10px; border:1px solid rgba(231,184,75,.35); border-radius:8px; background:rgba(231,184,75,.08); padding:10px 11px; margin-top:14px; color:#F4D98B; font-size:10px; }\n  .sy-responder .offline strong { display:block; color:#FFE4A7; font-size:11px; margin-bottom:3px; }\n  .sy-responder .feedback { min-height:36px; margin-top:13px; border:1px solid rgba(27,209,165,.35); border-radius:8px; background:rgba(27,209,165,.08); color:#8BEAD1; padding:9px 11px; font-size:11px; }\n  .sy-responder .feedback.hidden { display:none; }\n  @media (max-width:1050px) { .sy-responder .workspace { grid-template-columns:250px minmax(360px,1fr); } .sy-responder .dispatch { grid-column:1 / -1; min-height:auto; } }\n  @media (max-width:720px) { .sy-responder { padding:16px 14px 28px; } .sy-responder .topbar, .sy-responder .hero { align-items:flex-start; flex-direction:column; } .sy-responder .top-meta, .sy-responder .hero-actions { justify-content:flex-start; } .sy-responder .kpis { grid-template-columns:repeat(2,minmax(0,1fr)); } .sy-responder .workspace { grid-template-columns:1fr; } .sy-responder .queue, .sy-responder .dispatch { min-height:auto; } .sy-responder .map { height:340px; } }\n</style>\n<div class=\"sy-responder\" data-kid=\"1\">\n    <header class=\"topbar\" data-kid=\"1-1\">\n        <div class=\"brand\" data-kid=\"1-1-1\">\n            <div class=\"brand-mark\" data-kid=\"1-1-1-1\">\n                <i data-kid=\"1-1-1-1-1\" data-lucide=\"shield-check\" style=\"width:18px;height:18px\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\">\n                <div class=\"brand-name\" data-kid=\"1-1-1-2-1\">\n                    SafeYatra\n                    <span data-kid=\"1-1-1-2-1-1\">\n                        AI\n                    </span>\n                </div>\n                <div class=\"brand-sub\" data-kid=\"1-1-1-2-2\">\n                    Responder dispatch\n                </div>\n            </div>\n        </div>\n        <div class=\"top-meta\" data-kid=\"1-1-2\">\n            <span class=\"pill good\" data-kid=\"1-1-2-1\">\n                <span class=\"dot\" data-kid=\"1-1-2-1-1\">\n                </span>\n                Unit Alpha-07 online\n            </span>\n            <span class=\"pill\" data-kid=\"1-1-2-2\">\n                <i data-kid=\"1-1-2-2-1\" data-lucide=\"radio\" style=\"width:14px;height:14px\">\n                </i>\n                Radio channel 04\n            </span>\n            <span class=\"pill warn\" data-kid=\"1-1-2-3\">\n                <span class=\"dot amber\" data-kid=\"1-1-2-3-1\">\n                </span>\n                1 offline update\n            </span>\n            <span class=\"pill mono\" data-dynamic=\"true\" data-kid=\"1-1-2-4\" data-name=\"current time display\" data-reason=\"text updated via JavaScript\">\n                08:42 UTC\n            </span>\n        </div>\n    </header>\n    <section class=\"hero\" data-kid=\"1-2\">\n        <div data-kid=\"1-2-1\">\n            <div class=\"eyebrow\" data-kid=\"1-2-1-1\">\n                Field response / Ravi Patil\n            </div>\n            <h1 data-kid=\"1-2-1-2\">\n                Move from alert to action.\n            </h1>\n            <p class=\"hero-copy\" data-kid=\"1-2-1-3\">\n                Your queue is ordered by risk and time. Confirm the route, verify the tourist, then close the incident with an auditable status update.\n            </p>\n        </div>\n        <div class=\"hero-actions\" data-kid=\"1-2-2\">\n            <button class=\"btn\" data-kid=\"1-2-2-1\" id=\"radioBtn\">\n                <i data-kid=\"1-2-2-1-1\" data-lucide=\"radio\" style=\"width:15px;height:15px\">\n                </i>\n                Test radio\n            </button>\n            <button class=\"btn primary\" data-kid=\"1-2-2-2\" id=\"routeBtn\">\n                <i data-kid=\"1-2-2-2-1\" data-lucide=\"navigation\" style=\"width:15px;height:15px\">\n                </i>\n                Start navigation\n            </button>\n        </div>\n    </section>\n    <section aria-label=\"Dispatch summary\" class=\"kpis\" data-kid=\"1-3\">\n        <div class=\"kpi\" data-kid=\"1-3-1\">\n            <div class=\"kpi-top\" data-kid=\"1-3-1-1\">\n                <span class=\"mono-label\" data-kid=\"1-3-1-1-1\">\n                    Assigned\n                </span>\n                <i data-kid=\"1-3-1-1-2\" data-lucide=\"siren\" style=\"width:16px;height:16px;color:var(--coral)\">\n                </i>\n            </div>\n            <div class=\"kpi-value coral\" data-kid=\"1-3-1-2\">\n                3\n            </div>\n            <div class=\"kpi-detail\" data-kid=\"1-3-1-3\">\n                Active incidents\n            </div>\n        </div>\n        <div class=\"kpi\" data-kid=\"1-3-2\">\n            <div class=\"kpi-top\" data-kid=\"1-3-2-1\">\n                <span class=\"mono-label\" data-kid=\"1-3-2-1-1\">\n                    In progress\n                </span>\n                <i data-kid=\"1-3-2-1-2\" data-lucide=\"navigation\" style=\"width:16px;height:16px;color:var(--cyan)\">\n                </i>\n            </div>\n            <div class=\"kpi-value cyan\" data-kid=\"1-3-2-2\">\n                1\n            </div>\n            <div class=\"kpi-detail\" data-kid=\"1-3-2-3\">\n                Units on route\n            </div>\n        </div>\n        <div class=\"kpi\" data-kid=\"1-3-3\">\n            <div class=\"kpi-top\" data-kid=\"1-3-3-1\">\n                <span class=\"mono-label\" data-kid=\"1-3-3-1-1\">\n                    Average ETA\n                </span>\n                <i data-kid=\"1-3-3-1-2\" data-lucide=\"timer\" style=\"width:16px;height:16px;color:var(--mint)\">\n                </i>\n            </div>\n            <div class=\"kpi-value mint\" data-kid=\"1-3-3-2\">\n                06m\n            </div>\n            <div class=\"kpi-detail\" data-kid=\"1-3-3-3\">\n                Current dispatch\n            </div>\n        </div>\n        <div class=\"kpi\" data-kid=\"1-3-4\">\n            <div class=\"kpi-top\" data-kid=\"1-3-4-1\">\n                <span class=\"mono-label\" data-kid=\"1-3-4-1-1\">\n                    Coverage\n                </span>\n                <i data-kid=\"1-3-4-1-2\" data-lucide=\"shield-check\" style=\"width:16px;height:16px;color:var(--mint)\">\n                </i>\n            </div>\n            <div class=\"kpi-value mint\" data-kid=\"1-3-4-2\">\n                86%\n            </div>\n            <div class=\"kpi-detail\" data-kid=\"1-3-4-3\">\n                Nashik response zone\n            </div>\n        </div>\n    </section>\n    <main class=\"workspace\" data-kid=\"1-4\">\n        <section class=\"panel queue\" data-kid=\"1-4-1\">\n            <div class=\"panel-head\" data-kid=\"1-4-1-1\">\n                <div data-kid=\"1-4-1-1-1\">\n                    <div class=\"eyebrow\" data-kid=\"1-4-1-1-1-1\">\n                        Priority queue\n                    </div>\n                    <div class=\"panel-title\" data-kid=\"1-4-1-1-1-2\">\n                        3 assigned incidents\n                    </div>\n                </div>\n                <span class=\"pill\" data-kid=\"1-4-1-1-2\" data-name=\"incident queue sort status\" style=\"min-height:28px;padding:0 8px;font-size:10px\">\n                    SORTED BY RISK\n                </span>\n            </div>\n            <div class=\"panel-body\" data-kid=\"1-4-1-2\">\n                <p class=\"queue-summary\" data-kid=\"1-4-1-2-1\">\n                    Select an incident to focus the route and update the response lifecycle.\n                </p>\n                <button class=\"incident active\" data-incident=\"INC-2026-001\" data-kid=\"1-4-1-2-2\">\n                    <div class=\"incident-row\" data-kid=\"1-4-1-2-2-1\">\n                        <span class=\"incident-id\" data-kid=\"1-4-1-2-2-1-1\">\n                            INC-2026-001\n                        </span>\n                        <span class=\"severity\" data-kid=\"1-4-1-2-2-1-2\">\n                            CRITICAL 94%\n                        </span>\n                    </div>\n                    <div class=\"incident-name\" data-kid=\"1-4-1-2-2-2\">\n                        Aarav Mehta\n                    </div>\n                    <div class=\"incident-copy\" data-kid=\"1-4-1-2-2-3\">\n                        SOS + live GPS captured · Gangapur Dam Service Road\n                    </div>\n                    <div class=\"incident-foot\" data-kid=\"1-4-1-2-2-4\">\n                        <span data-kid=\"1-4-1-2-2-4-1\">\n                            2.4 km away\n                        </span>\n                        <span data-kid=\"1-4-1-2-2-4-2\">\n                            ETA 06 min\n                        </span>\n                    </div>\n                </button>\n                <button class=\"incident\" data-incident=\"INC-2026-004\" data-kid=\"1-4-1-2-3\">\n                    <div class=\"incident-row\" data-kid=\"1-4-1-2-3-1\">\n                        <span class=\"incident-id\" data-kid=\"1-4-1-2-3-1-1\">\n                            INC-2026-004\n                        </span>\n                        <span class=\"severity high\" data-kid=\"1-4-1-2-3-1-2\">\n                            HIGH 78%\n                        </span>\n                    </div>\n                    <div class=\"incident-name\" data-kid=\"1-4-1-2-3-2\">\n                        Meera Shah\n                    </div>\n                    <div class=\"incident-copy\" data-kid=\"1-4-1-2-3-3\">\n                        No movement detected · Kalsubai trail\n                    </div>\n                    <div class=\"incident-foot\" data-kid=\"1-4-1-2-3-4\">\n                        <span data-kid=\"1-4-1-2-3-4-1\">\n                            6.8 km away\n                        </span>\n                        <span data-kid=\"1-4-1-2-3-4-2\">\n                            ETA 14 min\n                        </span>\n                    </div>\n                </button>\n                <button class=\"incident\" data-incident=\"INC-2026-006\" data-kid=\"1-4-1-2-4\">\n                    <div class=\"incident-row\" data-kid=\"1-4-1-2-4-1\">\n                        <span class=\"incident-id\" data-kid=\"1-4-1-2-4-1-1\">\n                            INC-2026-006\n                        </span>\n                        <span class=\"severity high\" data-kid=\"1-4-1-2-4-1-2\">\n                            HIGH 71%\n                        </span>\n                    </div>\n                    <div class=\"incident-name\" data-kid=\"1-4-1-2-4-2\">\n                        Kabir Rao\n                    </div>\n                    <div class=\"incident-copy\" data-kid=\"1-4-1-2-4-3\">\n                        Geo-fence warning · Temple corridor\n                    </div>\n                    <div class=\"incident-foot\" data-kid=\"1-4-1-2-4-4\">\n                        <span data-kid=\"1-4-1-2-4-4-1\">\n                            9.1 km away\n                        </span>\n                        <span data-kid=\"1-4-1-2-4-4-2\">\n                            ETA 19 min\n                        </span>\n                    </div>\n                </button>\n                <div class=\"offline\" data-kid=\"1-4-1-2-5\" data-name=\"offline sync notification panel\">\n                    <div data-kid=\"1-4-1-2-5-1\">\n                        <strong data-kid=\"1-4-1-2-5-1-1\">\n                            Offline-ready updates\n                        </strong>\n                        1 status update will sync automatically.\n                    </div>\n                    <i data-kid=\"1-4-1-2-5-2\" data-lucide=\"cloud-off\" style=\"width:16px;height:16px\">\n                    </i>\n                </div>\n            </div>\n        </section>\n        <section class=\"panel map-panel\" data-kid=\"1-4-2\">\n            <div class=\"panel-head\" data-kid=\"1-4-2-1\">\n                <div data-kid=\"1-4-2-1-1\">\n                    <div class=\"eyebrow\" data-kid=\"1-4-2-1-1-1\">\n                        Responder navigation\n                    </div>\n                    <div class=\"panel-title\" data-kid=\"1-4-2-1-1-2\">\n                        Route to Gangapur Dam Service Road\n                    </div>\n                </div>\n                <span class=\"pill good\" data-kid=\"1-4-2-1-2\">\n                    <span class=\"dot\" data-kid=\"1-4-2-1-2-1\">\n                    </span>\n                    GPS active\n                </span>\n            </div>\n            <div class=\"map-wrap\" data-kid=\"1-4-2-2\">\n                <div aria-label=\"Route map from Unit Alpha-07 to Aarav Mehta\" class=\"map\" data-kid=\"1-4-2-2-1\" data-name=\"route map visualization\">\n                    <svg aria-label=\"Stylized route map\" data-kid=\"1-4-2-2-1-1\" preserveaspectratio=\"none\" role=\"img\" viewbox=\"0 0 720 420\">\n                        <rect fill=\"#0B2535\" height=\"420\" width=\"720\">\n                        </rect>\n                        <path d=\"M0 86 C120 44 160 128 270 106 S444 52 720 120\" fill=\"none\" stroke=\"#173C4C\" stroke-width=\"22\">\n                        </path>\n                        <path d=\"M0 300 C110 260 160 344 274 302 S490 260 720 335\" fill=\"none\" stroke=\"#173C4C\" stroke-width=\"18\">\n                        </path>\n                        <path d=\"M105 0 C170 86 122 170 218 240 S320 356 300 420\" fill=\"none\" stroke=\"#173C4C\" stroke-width=\"16\">\n                        </path>\n                        <path d=\"M550 0 C490 92 566 156 474 225 S430 338 480 420\" fill=\"none\" stroke=\"#173C4C\" stroke-width=\"14\">\n                        </path>\n                        <path d=\"M106 348 C198 322 263 287 329 242 S452 170 612 85\" fill=\"none\" stroke=\"#5AA7FF\" stroke-dasharray=\"10 8\" stroke-linecap=\"round\" stroke-width=\"5\">\n                        </path>\n                        <path d=\"M106 348 C198 322 263 287 329 242 S452 170 612 85\" fill=\"none\" stroke=\"#5AA7FF\" stroke-linecap=\"round\" stroke-opacity=\".2\" stroke-width=\"15\">\n                        </path>\n                        <circle cx=\"612\" cy=\"85\" fill=\"#FF6870\" fill-opacity=\".12\" r=\"54\" stroke=\"#FF6870\" stroke-opacity=\".55\" stroke-width=\"2\">\n                        </circle>\n                        <circle cx=\"612\" cy=\"85\" fill=\"#FF6870\" fill-opacity=\".25\" r=\"13\">\n                        </circle>\n                        <circle cx=\"612\" cy=\"85\" fill=\"#FF6870\" r=\"6\">\n                        </circle>\n                        <circle cx=\"106\" cy=\"348\" fill=\"#1BD1A5\" fill-opacity=\".2\" r=\"12\">\n                        </circle>\n                        <circle cx=\"106\" cy=\"348\" fill=\"#1BD1A5\" r=\"5\">\n                        </circle>\n                        <circle cx=\"294\" cy=\"170\" fill=\"#E7B84B\" r=\"7\">\n                        </circle>\n                        <circle cx=\"425\" cy=\"288\" fill=\"#1BD1A5\" r=\"7\">\n                        </circle>\n                    </svg>\n                    <div class=\"map-chip\" data-kid=\"1-4-2-2-1-2\">\n                        <span class=\"dot\" data-kid=\"1-4-2-2-1-2-1\">\n                        </span>\n                        Route ready · 2.4 km\n                    </div>\n                    <div class=\"map-label start\" data-kid=\"1-4-2-2-1-3\">\n                        Unit Alpha-07\n                    </div>\n                    <div class=\"map-label target\" data-kid=\"1-4-2-2-1-4\">\n                        Aarav · critical\n                    </div>\n                </div>\n                <div class=\"map-stats\" data-kid=\"1-4-2-2-2\">\n                    <div class=\"map-stat\" data-kid=\"1-4-2-2-2-1\">\n                        <span data-kid=\"1-4-2-2-2-1-1\">\n                            Distance\n                        </span>\n                        <strong data-kid=\"1-4-2-2-2-1-2\">\n                            2.4 km\n                        </strong>\n                    </div>\n                    <div class=\"map-stat\" data-kid=\"1-4-2-2-2-2\">\n                        <span data-kid=\"1-4-2-2-2-2-1\">\n                            Estimated arrival\n                        </span>\n                        <strong data-kid=\"1-4-2-2-2-2-2\">\n                            06 min\n                        </strong>\n                    </div>\n                    <div class=\"map-stat\" data-kid=\"1-4-2-2-2-3\">\n                        <span data-kid=\"1-4-2-2-2-3-1\">\n                            Terrain\n                        </span>\n                        <strong data-kid=\"1-4-2-2-2-3-2\">\n                            Wet road\n                        </strong>\n                    </div>\n                </div>\n                <div class=\"legend\" data-kid=\"1-4-2-2-3\">\n                    <span data-kid=\"1-4-2-2-3-1\">\n                        <i class=\"route\" data-kid=\"1-4-2-2-3-1-1\">\n                        </i>\n                        Route trail\n                    </span>\n                    <span data-kid=\"1-4-2-2-3-2\">\n                        <i class=\"target\" data-kid=\"1-4-2-2-3-2-1\">\n                        </i>\n                        Dispatch target\n                    </span>\n                    <span data-kid=\"1-4-2-2-3-3\">\n                        <i class=\"safe\" data-kid=\"1-4-2-2-3-3-1\">\n                        </i>\n                        Verified devices\n                    </span>\n                </div>\n                <div class=\"fallback\" data-kid=\"1-4-2-2-4\">\n                    <i data-kid=\"1-4-2-2-4-1\" data-lucide=\"map-off\" style=\"width:16px;height:16px;flex:0 0 auto\">\n                    </i>\n                    <div data-kid=\"1-4-2-2-4-2\">\n                        <strong data-kid=\"1-4-2-2-4-2-1\">\n                            Navigation fallback available\n                        </strong>\n                        If map tiles fail, coordinates remain available:\n                        <span class=\"mono\" data-kid=\"1-4-2-2-4-2-2\">\n                            20.0059, 73.7897\n                        </span>\n                        . Use the field address and radio channel 04.\n                    </div>\n                </div>\n            </div>\n        </section>\n        <aside class=\"panel dispatch\" data-kid=\"1-4-3\">\n            <div class=\"panel-head\" data-kid=\"1-4-3-1\">\n                <div data-kid=\"1-4-3-1-1\">\n                    <div class=\"eyebrow\" data-kid=\"1-4-3-1-1-1\">\n                        Current dispatch\n                    </div>\n                    <div class=\"panel-title mono\" data-kid=\"1-4-3-1-1-2\">\n                        INC-2026-001\n                    </div>\n                </div>\n                <span class=\"severity\" data-kid=\"1-4-3-1-2\">\n                    CRITICAL\n                </span>\n            </div>\n            <div class=\"panel-body\" data-kid=\"1-4-3-2\">\n                <div class=\"dispatch-risk\" data-kid=\"1-4-3-2-1\">\n                    <div data-kid=\"1-4-3-2-1-1\">\n                        <div class=\"eyebrow\" data-kid=\"1-4-3-2-1-1-1\">\n                            Tourist\n                        </div>\n                        <div data-kid=\"1-4-3-2-1-1-2\" style=\"font-size:16px;font-weight:800;margin-top:5px\">\n                            Aarav Mehta\n                        </div>\n                        <div data-kid=\"1-4-3-2-1-1-3\" style=\"font-size:11px;color:var(--muted);margin-top:4px\">\n                            SOS + live GPS captured\n                        </div>\n                    </div>\n                    <div class=\"risk-score\" data-kid=\"1-4-3-2-1-2\">\n                        94%\n                        <small data-kid=\"1-4-3-2-1-2-1\">\n                            RISK\n                        </small>\n                    </div>\n                </div>\n                <div class=\"fact-list\" data-kid=\"1-4-3-2-2\">\n                    <div class=\"fact\" data-kid=\"1-4-3-2-2-1\">\n                        <span data-kid=\"1-4-3-2-2-1-1\">\n                            Last known location\n                        </span>\n                        <span class=\"mono\" data-kid=\"1-4-3-2-2-1-2\">\n                            20.0059, 73.7897\n                        </span>\n                    </div>\n                    <div class=\"fact\" data-kid=\"1-4-3-2-2-2\">\n                        <span data-kid=\"1-4-3-2-2-2-1\">\n                            Zone\n                        </span>\n                        <span data-kid=\"1-4-3-2-2-2-2\">\n                            Gangapur Dam Service Road\n                        </span>\n                    </div>\n                    <div class=\"fact\" data-kid=\"1-4-3-2-2-3\">\n                        <span data-kid=\"1-4-3-2-2-3-1\">\n                            Assigned unit\n                        </span>\n                        <span data-kid=\"1-4-3-2-2-3-2\">\n                            Alpha-07 / Ravi Patil\n                        </span>\n                    </div>\n                    <div class=\"fact\" data-kid=\"1-4-3-2-2-4\">\n                        <span data-kid=\"1-4-3-2-2-4-1\">\n                            Status\n                        </span>\n                        <span data-kid=\"1-4-3-2-2-4-2\" style=\"color:#FFB5B9\">\n                            Responder assigned\n                        </span>\n                    </div>\n                </div>\n                <div class=\"verified\" data-kid=\"1-4-3-2-3\">\n                    <i data-kid=\"1-4-3-2-3-1\" data-lucide=\"badge-check\" style=\"width:19px;height:19px;color:var(--mint);flex:0 0 auto\">\n                    </i>\n                    <div data-kid=\"1-4-3-2-3-2\">\n                        <strong data-kid=\"1-4-3-2-3-2-1\">\n                            Digital ID verified\n                        </strong>\n                        <span data-kid=\"1-4-3-2-3-2-2\">\n                            SY-2026-8F92A1 · hash match confirmed\n                        </span>\n                    </div>\n                </div>\n                <div class=\"dispatch-actions\" data-kid=\"1-4-3-2-4\" data-name=\"dispatch action button group\">\n                    <button class=\"btn critical status-btn\" data-kid=\"1-4-3-2-4-1\" data-status=\"Incident acknowledged\">\n                        <i data-kid=\"1-4-3-2-4-1-1\" data-lucide=\"clipboard-check\" style=\"width:15px;height:15px\">\n                        </i>\n                        Acknowledge\n                    </button>\n                    <button class=\"btn primary status-btn\" data-kid=\"1-4-3-2-4-2\" data-status=\"Marked in progress · unit on route\">\n                        <i data-kid=\"1-4-3-2-4-2-1\" data-lucide=\"navigation\" style=\"width:15px;height:15px\">\n                        </i>\n                        In progress\n                    </button>\n                    <button class=\"btn status-btn\" data-kid=\"1-4-3-2-4-3\" data-status=\"Incident resolved · audit note created\">\n                        <i data-kid=\"1-4-3-2-4-3-1\" data-lucide=\"check-circle-2\" style=\"width:15px;height:15px\">\n                        </i>\n                        Resolve\n                    </button>\n                    <button class=\"btn small status-btn\" data-kid=\"1-4-3-2-4-4\" data-status=\"Calling Aarav via emergency contact\">\n                        <i data-kid=\"1-4-3-2-4-4-1\" data-lucide=\"phone\" style=\"width:14px;height:14px\">\n                        </i>\n                        Contact tourist\n                    </button>\n                </div>\n                <div aria-live=\"polite\" class=\"feedback hidden\" data-dynamic=\"true\" data-kid=\"1-4-3-2-5\" data-name=\"status feedback message\" data-reason=\"text content replaced on button click by script\" id=\"feedback\">\n                </div>\n                <div class=\"timeline\" data-kid=\"1-4-3-2-6\">\n                    <div class=\"eyebrow\" data-kid=\"1-4-3-2-6-1\" style=\"margin-bottom:12px\">\n                        Response lifecycle\n                    </div>\n                    <div class=\"step\" data-kid=\"1-4-3-2-6-2\">\n                        <span class=\"step-dot\" data-kid=\"1-4-3-2-6-2-1\">\n                        </span>\n                        <div data-kid=\"1-4-3-2-6-2-2\">\n                            <strong data-kid=\"1-4-3-2-6-2-2-1\">\n                                Alert received\n                            </strong>\n                            <span data-kid=\"1-4-3-2-6-2-2-2\">\n                                08:36 · Control room\n                            </span>\n                        </div>\n                        <span class=\"step-line\" data-kid=\"1-4-3-2-6-2-3\">\n                        </span>\n                    </div>\n                    <div class=\"step\" data-kid=\"1-4-3-2-6-3\">\n                        <span class=\"step-dot\" data-kid=\"1-4-3-2-6-3-1\">\n                        </span>\n                        <div data-kid=\"1-4-3-2-6-3-2\">\n                            <strong data-kid=\"1-4-3-2-6-3-2-1\">\n                                Responder assigned\n                            </strong>\n                            <span data-kid=\"1-4-3-2-6-3-2-2\">\n                                08:40 · Unit Alpha-07\n                            </span>\n                        </div>\n                        <span class=\"step-line\" data-kid=\"1-4-3-2-6-3-3\">\n                        </span>\n                    </div>\n                    <div class=\"step pending\" data-kid=\"1-4-3-2-6-4\">\n                        <span class=\"step-dot\" data-kid=\"1-4-3-2-6-4-1\">\n                        </span>\n                        <div data-kid=\"1-4-3-2-6-4-2\">\n                            <strong data-kid=\"1-4-3-2-6-4-2-1\" data-name=\"next response step title\">\n                                Verify identity on arrival\n                            </strong>\n                            <span data-kid=\"1-4-3-2-6-4-2-2\">\n                                Next step · privacy-safe QR\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </aside>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n  const feedback = document.getElementById('feedback');\n  function showFeedback(message) { feedback.textContent = message; feedback.classList.remove('hidden'); window.clearTimeout(window.__syTimer); window.__syTimer = window.setTimeout(() => feedback.classList.add('hidden'), 4200); }\n  document.querySelectorAll('.status-btn').forEach((button) => button.addEventListener('click', () => showFeedback(button.dataset.status)));\n  document.getElementById('routeBtn').addEventListener('click', () => showFeedback('Navigation started · ETA locked at 06 minutes'));\n  document.getElementById('radioBtn').addEventListener('click', () => showFeedback('Radio channel 04 checked · signal clear'));\n  document.querySelectorAll('.incident').forEach((card) => card.addEventListener('click', () => { document.querySelectorAll('.incident').forEach((item) => item.classList.remove('active')); card.classList.add('active'); showFeedback(card.dataset.incident + ' focused on the route map'); }));\n</script>\n",
