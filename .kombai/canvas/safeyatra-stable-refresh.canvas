      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap');\n  .sy-shell { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }\n  .sy-mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }\n  .sy-ring { transform: rotate(-90deg); transform-origin: 50% 50%; }\n  .sy-route { stroke-dasharray: 3 8; animation: sy-dash 18s linear infinite; }\n  .sy-pulse { animation: sy-pulse 2.1s ease-in-out infinite; }\n  .sy-fade { animation: sy-fade .25s ease-out; }\n  @keyframes sy-dash { to { stroke-dashoffset: -160; } }\n  @keyframes sy-pulse { 0%, 100% { opacity: .82; transform: scale(1); } 50% { opacity: .42; transform: scale(1.14); } }\n  @keyframes sy-fade { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }\n  @media (prefers-reduced-motion: reduce) { .sy-route, .sy-pulse, .sy-fade { animation: none; } }\n</style>\n<div class=\"sy-shell min-h-screen bg-[#08121D] text-[#EDF5F8]\" data-kid=\"1\" data-name=\"shell container\">\n    <header class=\"sticky top-0 z-20 border-b border-[#29465C] bg-[#08121D]/95 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"flex h-[68px] items-center justify-between px-4\" data-kid=\"1-1-1\" data-name=\"header layout container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and title group\">\n                <div aria-hidden=\"true\" class=\"grid h-9 w-9 place-items-center rounded-[10px] border border-[#1BD1A5]/35 bg-[#1BD1A5]/10 text-[#1BD1A5]\" data-kid=\"1-1-1-1-1\" data-name=\"shield icon container\">\n                    <i class=\"h-[18px] w-[18px]\" data-kid=\"1-1-1-1-1-1\" data-lucide=\"shield-check\" data-name=\"shield check icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"brand text container\">\n                    <p class=\"text-[13px] font-extrabold tracking-[-0.02em]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        SafeYatra\n                        <span class=\"text-[#1BD1A5]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"brand ai indicator\">\n                            AI\n                        </span>\n                    </p>\n                    <p class=\"mt-0.5 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#8CA2B4]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand category text\">\n                        Tourist safety\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-2\" data-name=\"header action items container\">\n                <span class=\"inline-flex min-h-8 items-center gap-1.5 rounded-full border border-[#1BD1A5]/30 bg-[#1BD1A5]/10 px-2.5 text-[10px] font-bold text-[#80E8CD]\" data-kid=\"1-1-1-2-1\" data-name=\"gps status badge\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#1BD1A5]\" data-kid=\"1-1-1-2-1-1\" data-name=\"gps active dot\">\n                    </span>\n                    GPS active\n                </span>\n                <button aria-label=\"Open profile\" class=\"grid h-10 w-10 place-items-center rounded-[10px] border border-[#29465C] bg-[#0E1D2C] text-xs font-bold text-[#80E8CD]\" data-kid=\"1-1-1-2-2\" data-name=\"profile button\" id=\"profileButton\">\n                    AM\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[560px] px-4 pb-8 pt-4\" data-kid=\"1-2\" data-name=\"main content container\">\n        <div class=\"mb-4 flex items-start gap-3 rounded-[10px] border border-[#E7B84B]/35 bg-[#E7B84B]/10 px-3 py-3\" data-kid=\"1-2-1\" data-name=\"offline status banner\" id=\"offlineBanner\">\n            <i class=\"mt-0.5 h-4 w-4 shrink-0 text-[#E7B84B]\" data-kid=\"1-2-1-1\" data-lucide=\"cloud-off\" data-name=\"offline cloud icon\">\n            </i>\n            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-1-2\" data-name=\"offline status text container\">\n                <p class=\"text-xs font-bold text-[#F6D98A]\" data-kid=\"1-2-1-2-1\" data-name=\"offline title\">\n                    Offline queue is ready\n                </p>\n                <p class=\"mt-1 text-[12px] leading-5 text-[#C7D3DD]\" data-kid=\"1-2-1-2-2\" data-name=\"offline description\">\n                    3 packets waiting. GPS, SOS and risk analysis continue locally.\n                </p>\n            </div>\n            <button class=\"min-h-10 shrink-0 rounded-[8px] border border-[#E7B84B]/45 px-2.5 text-[11px] font-bold text-[#F6D98A]\" data-kid=\"1-2-1-3\" data-name=\"sync button\" id=\"syncButton\">\n                Sync\n            </button>\n        </div>\n        <section aria-labelledby=\"safety-heading\" class=\"rounded-[12px] border border-[#29465C] bg-[#0E1D2C] p-4\" data-kid=\"1-2-2\" data-name=\"safety status card\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-2-1\" data-name=\"safety header\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"safety header title group\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#8CA2B4]\" data-kid=\"1-2-2-1-1-1\" data-name=\"status label\">\n                        Your safety status\n                    </p>\n                    <h1 class=\"mt-1 text-[23px] font-extrabold tracking-[-0.035em]\" data-kid=\"1-2-2-1-1-2\" data-name=\"safety headline\" id=\"safety-heading\">\n                        Protected journey\n                    </h1>\n                    <p class=\"mt-1 text-[12px] text-[#B8C7D2]\" data-kid=\"1-2-2-1-1-3\" data-name=\"safety subheadline\">\n                        Inside Nashik monitored corridor\n                    </p>\n                </div>\n                <span class=\"inline-flex min-h-8 items-center gap-1.5 rounded-full border border-[#1BD1A5]/30 bg-[#1BD1A5]/10 px-2.5 text-[10px] font-extrabold uppercase tracking-[0.08em] text-[#80E8CD]\" data-kid=\"1-2-2-1-2\" data-name=\"safety state badge\">\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-2-1-2-1\" data-lucide=\"check\" data-name=\"checkmark icon\">\n                    </i>\n                    Safe\n                </span>\n            </div>\n            <div class=\"mt-5 flex items-center gap-5\" data-kid=\"1-2-2-2\" data-name=\"risk score section\">\n                <div aria-label=\"Risk score 18 percent\" class=\"relative h-[112px] w-[112px] shrink-0\" data-kid=\"1-2-2-2-1\" data-name=\"risk score chart container\">\n                    <svg aria-hidden=\"true\" class=\"h-full w-full\" data-kid=\"1-2-2-2-1-1\" data-name=\"risk score svg chart\" role=\"img\" viewbox=\"0 0 120 120\">\n                        <circle cx=\"60\" cy=\"60\" fill=\"none\" r=\"49\" stroke=\"#29465C\" stroke-width=\"9\">\n                        </circle>\n                        <circle class=\"sy-ring\" cx=\"60\" cy=\"60\" fill=\"none\" r=\"49\" stroke=\"#1BD1A5\" stroke-dasharray=\"55.4 307.9\" stroke-linecap=\"round\" stroke-width=\"9\">\n                        </circle>\n                    </svg>\n                    <div class=\"absolute inset-0 grid place-items-center text-center\" data-kid=\"1-2-2-2-1-2\" data-name=\"risk percentage overlay\">\n                        <span class=\"sy-mono text-[26px] font-bold text-[#EDF5F8]\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"risk percentage text\">\n                            18%\n                        </span>\n                        <span class=\"-mt-1 text-[10px] font-bold uppercase tracking-[0.1em] text-[#80E8CD]\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"risk label\">\n                            risk\n                        </span>\n                    </div>\n                </div>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-2-2\" data-name=\"risk explanation section\">\n                    <p class=\"text-sm font-bold text-[#EDF5F8]\" data-kid=\"1-2-2-2-2-1\" data-name=\"risk status text\">\n                        No action needed\n                    </p>\n                    <p class=\"mt-1 text-[12px] leading-5 text-[#B8C7D2]\" data-kid=\"1-2-2-2-2-2\" data-name=\"risk status description\">\n                        Movement looks normal and the current zone is monitored.\n                    </p>\n                    <div class=\"mt-3 flex items-center gap-2 text-[11px] text-[#8CA2B4]\" data-kid=\"1-2-2-2-2-3\" data-name=\"location coordinates container\">\n                        <i class=\"h-3.5 w-3.5 text-[#5AA7FF]\" data-kid=\"1-2-2-2-2-3-1\" data-lucide=\"map-pin\" data-name=\"map pin icon\">\n                        </i>\n                        <span class=\"sy-mono\" data-kid=\"1-2-2-2-2-3-2\" data-name=\"coordinates text\">\n                            19.9322, 73.5304\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <button aria-label=\"Send emergency SOS\" class=\"mt-5 flex min-h-12 w-full items-center justify-center gap-2 rounded-[9px] bg-[#FF6870] px-4 text-sm font-extrabold text-[#08121D] hover:bg-[#FF858B]\" data-kid=\"1-2-2-3\" data-name=\"emergency sos button\" id=\"sosButton\">\n                <i class=\"h-[18px] w-[18px]\" data-kid=\"1-2-2-3-1\" data-lucide=\"siren\" data-name=\"siren icon\">\n                </i>\n                Send emergency SOS\n            </button>\n            <p class=\"mt-2 text-center text-[11px] text-[#8CA2B4]\" data-kid=\"1-2-2-4\" data-name=\"emergency sos footer note\">\n                Your live location and verified ID will be attached.\n            </p>\n        </section>\n        <section aria-labelledby=\"map-heading\" class=\"mt-4 overflow-hidden rounded-[12px] border border-[#29465C] bg-[#0E1D2C]\" data-kid=\"1-2-3\" data-name=\"journey map section\">\n            <div class=\"flex items-start justify-between gap-3 border-b border-[#29465C] px-4 py-3\" data-kid=\"1-2-3-1\" data-name=\"map header\">\n                <div data-kid=\"1-2-3-1-1\" data-name=\"map title group\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#8CA2B4]\" data-kid=\"1-2-3-1-1-1\" data-name=\"map label\">\n                        Live journey map\n                    </p>\n                    <h2 class=\"mt-1 text-[14px] font-bold\" data-kid=\"1-2-3-1-1-2\" data-name=\"map route headline\" id=\"map-heading\">\n                        Nashik\n                        <span class=\"text-[#8CA2B4]\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"map arrow separator\">\n                            →\n                        </span>\n                        Trimbakeshwar\n                    </h2>\n                </div>\n                <span class=\"sy-mono text-[10px] text-[#8CA2B4]\" data-kid=\"1-2-3-1-2\" data-name=\"map timestamp\">\n                    08:42 UTC\n                </span>\n            </div>\n            <div class=\"relative h-[214px] bg-[#102738]\" data-kid=\"1-2-3-2\" data-name=\"map visual container\">\n                <svg aria-label=\"Journey route with monitored corridor\" class=\"absolute inset-0 h-full w-full\" data-kid=\"1-2-3-2-1\" data-name=\"journey route svg\" preserveaspectratio=\"none\" role=\"img\" viewbox=\"0 0 500 260\">\n                    <path d=\"M-20 226 C92 168 96 220 180 160 S310 78 520 26\" fill=\"none\" opacity=\".52\" stroke=\"#29465C\" stroke-width=\"38\">\n                    </path>\n                    <path class=\"sy-route\" d=\"M-20 226 C92 168 96 220 180 160 S310 78 520 26\" fill=\"none\" opacity=\".68\" stroke=\"#5AA7FF\" stroke-width=\"3\">\n                    </path>\n                    <circle cx=\"318\" cy=\"122\" fill=\"#1BD1A5\" fill-opacity=\".08\" r=\"68\" stroke=\"#1BD1A5\" stroke-opacity=\".38\" stroke-width=\"2\">\n                    </circle>\n                    <path d=\"M40 40 L122 86 M385 24 L462 88 M232 224 L340 188\" stroke=\"#6A8AA0\" stroke-opacity=\".28\" stroke-width=\"2\">\n                    </path>\n                    <circle class=\"sy-pulse\" cx=\"170\" cy=\"169\" fill=\"#1BD1A5\" fill-opacity=\".18\" r=\"12\">\n                    </circle>\n                    <circle cx=\"170\" cy=\"169\" fill=\"#1BD1A5\" r=\"5\">\n                    </circle>\n                    <circle cx=\"411\" cy=\"70\" fill=\"#E7B84B\" r=\"5\">\n                    </circle>\n                    <circle cx=\"72\" cy=\"205\" fill=\"#5AA7FF\" r=\"5\">\n                    </circle>\n                </svg>\n                <div class=\"absolute left-3 top-3 rounded-[8px] border border-[#29465C] bg-[#08121D]/90 px-2.5 py-2\" data-kid=\"1-2-3-2-2\" data-name=\"current location tooltip\">\n                    <p class=\"text-[10px] font-bold text-[#80E8CD]\" data-kid=\"1-2-3-2-2-1\" data-name=\"location label\">\n                        You are here\n                    </p>\n                    <p class=\"mt-0.5 sy-mono text-[10px] text-[#C7D3DD]\" data-kid=\"1-2-3-2-2-2\" data-name=\"location metadata\">\n                        SY-1001 · GPS fresh\n                    </p>\n                </div>\n                <div class=\"absolute bottom-3 left-3 right-3 flex items-center justify-between rounded-[8px] border border-[#29465C] bg-[#08121D]/90 px-3 py-2\" data-kid=\"1-2-3-2-3\" data-name=\"journey progress bar\">\n                    <span class=\"text-[11px] text-[#C7D3DD]\" data-kid=\"1-2-3-2-3-1\" data-name=\"progress text\">\n                        <span class=\"font-bold text-[#EDF5F8]\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"progress percentage\">\n                            42%\n                        </span>\n                        journey complete\n                    </span>\n                    <span class=\"sy-mono text-[10px] text-[#8CA2B4]\" data-kid=\"1-2-3-2-3-2\" data-name=\"next check-in time\">\n                        next check-in 09:00\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Quick actions\" class=\"mt-4 grid gap-2\" data-kid=\"1-2-4\" data-name=\"quick actions section\">\n            <button class=\"flex min-h-11 items-center justify-between rounded-[9px] border border-[#29465C] bg-[#0E1D2C] px-3 text-left text-[12px] font-bold text-[#EDF5F8] hover:border-[#1BD1A5]/50\" data-kid=\"1-2-4-1\" data-name=\"send location update button\" id=\"locationButton\">\n                <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-4-1-1\" data-name=\"button label container\">\n                    <i class=\"h-4 w-4 text-[#1BD1A5]\" data-kid=\"1-2-4-1-1-1\" data-lucide=\"locate-fixed\" data-name=\"locate icon\">\n                    </i>\n                    Send location update\n                </span>\n                <i class=\"h-4 w-4 text-[#8CA2B4]\" data-kid=\"1-2-4-1-2\" data-lucide=\"chevron-right\" data-name=\"chevron icon\">\n                </i>\n            </button>\n            <button class=\"flex min-h-11 items-center justify-between rounded-[9px] border border-[#29465C] bg-[#0E1D2C] px-3 text-left text-[12px] font-bold text-[#EDF5F8] hover:border-[#5AA7FF]/50\" data-kid=\"1-2-4-2\" data-name=\"digital id button\" id=\"idButton\">\n                <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-4-2-1\" data-name=\"button label container\">\n                    <i class=\"h-4 w-4 text-[#5AA7FF]\" data-kid=\"1-2-4-2-1-1\" data-lucide=\"badge-check\" data-name=\"badge check icon\">\n                    </i>\n                    Open verified digital ID\n                </span>\n                <span class=\"rounded-full border border-[#1BD1A5]/30 bg-[#1BD1A5]/10 px-2 py-1 text-[10px] text-[#80E8CD]\" data-kid=\"1-2-4-2-2\" data-name=\"verified label\">\n                    VERIFIED\n                </span>\n            </button>\n            <button class=\"flex min-h-11 items-center justify-between rounded-[9px] border border-[#29465C] bg-[#0E1D2C] px-3 text-left text-[12px] font-bold text-[#EDF5F8] hover:border-[#E7B84B]/50\" data-kid=\"1-2-4-3\" data-name=\"emergency contact button\" id=\"contactButton\">\n                <span class=\"flex items-center gap-2.5\" data-kid=\"1-2-4-3-1\" data-name=\"button label container\">\n                    <i class=\"h-4 w-4 text-[#E7B84B]\" data-kid=\"1-2-4-3-1-1\" data-lucide=\"phone\" data-name=\"phone icon\">\n                    </i>\n                    Call emergency contact\n                </span>\n                <span class=\"sy-mono text-[10px] text-[#8CA2B4]\" data-kid=\"1-2-4-3-2\" data-name=\"masked phone number\">\n                    +91 •••• 4821\n                </span>\n            </button>\n        </section>\n        <section aria-labelledby=\"timeline-heading\" class=\"mt-4 rounded-[12px] border border-[#29465C] bg-[#0E1D2C] p-4\" data-kid=\"1-2-5\" data-name=\"check-in timeline section\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-2-5-1\" data-name=\"timeline header\">\n                <div data-kid=\"1-2-5-1-1\" data-name=\"timeline title group\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#8CA2B4]\" data-kid=\"1-2-5-1-1-1\" data-name=\"timeline label\">\n                        Journey signal\n                    </p>\n                    <h2 class=\"mt-1 text-[14px] font-bold\" data-kid=\"1-2-5-1-1-2\" data-name=\"timeline headline\" id=\"timeline-heading\">\n                        Check-in timeline\n                    </h2>\n                </div>\n                <button class=\"text-[11px] font-bold text-[#80E8CD]\" data-kid=\"1-2-5-1-2\" data-name=\"view all timeline button\" id=\"timelineButton\">\n                    View all\n                </button>\n            </div>\n            <div class=\"mt-4 space-y-4\" data-kid=\"1-2-5-2\" data-name=\"timeline track container\">\n                <div class=\"flex gap-3\" data-kid=\"1-2-5-2-1\" data-name=\"timeline event 1 container\">\n                    <div class=\"relative flex w-4 justify-center\" data-kid=\"1-2-5-2-1-1\" data-name=\"event indicator container\">\n                        <span class=\"mt-1.5 h-2.5 w-2.5 rounded-full bg-[#1BD1A5]\" data-kid=\"1-2-5-2-1-1-1\" data-name=\"event status dot\">\n                        </span>\n                        <span class=\"absolute top-4 h-8 w-px bg-[#29465C]\" data-kid=\"1-2-5-2-1-1-2\" data-name=\"timeline connector line\">\n                        </span>\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-2-5-2-1-2\" data-name=\"event text container\">\n                        <p class=\"text-[12px] font-bold text-[#EDF5F8]\" data-kid=\"1-2-5-2-1-2-1\" data-name=\"event title\">\n                            Journey started\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-[#8CA2B4]\" data-kid=\"1-2-5-2-1-2-2\" data-name=\"event details\">\n                            Aarav Mehta · 07:42 UTC\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex gap-3\" data-kid=\"1-2-5-2-2\" data-name=\"timeline event 2 container\">\n                    <div class=\"relative flex w-4 justify-center\" data-kid=\"1-2-5-2-2-1\" data-name=\"event indicator container\">\n                        <span class=\"mt-1.5 h-2.5 w-2.5 rounded-full bg-[#5AA7FF]\" data-kid=\"1-2-5-2-2-1-1\" data-name=\"event status dot\">\n                        </span>\n                        <span class=\"absolute top-4 h-8 w-px bg-[#29465C]\" data-kid=\"1-2-5-2-2-1-2\" data-name=\"timeline connector line\">\n                        </span>\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-2-5-2-2-2\" data-name=\"event text container\">\n                        <p class=\"text-[12px] font-bold text-[#EDF5F8]\" data-kid=\"1-2-5-2-2-2-1\" data-name=\"event title\">\n                            Temple corridor entered\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-[#8CA2B4]\" data-kid=\"1-2-5-2-2-2-2\" data-name=\"event details\">\n                            Geo-fence confirmed · 08:08 UTC\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex gap-3\" data-kid=\"1-2-5-2-3\" data-name=\"timeline event 3 container\">\n                    <div class=\"flex w-4 justify-center\" data-kid=\"1-2-5-2-3-1\" data-name=\"event indicator container\">\n                        <span class=\"mt-1.5 h-2.5 w-2.5 rounded-full border-2 border-[#E7B84B]\" data-kid=\"1-2-5-2-3-1-1\" data-name=\"event status border\">\n                        </span>\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-2-5-2-3-2\" data-name=\"event text container\">\n                        <p class=\"text-[12px] font-bold text-[#EDF5F8]\" data-kid=\"1-2-5-2-3-2-1\" data-name=\"event title\">\n                            Next check-in window\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-[#8CA2B4]\" data-kid=\"1-2-5-2-3-2-2\" data-name=\"event details\">\n                            SafeYatra AI · 09:00 UTC\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Identity and emergency contact\" class=\"mt-4 divide-y divide-[#29465C] rounded-[12px] border border-[#29465C] bg-[#0E1D2C]\" data-kid=\"1-2-6\" data-name=\"identity info section\">\n            <button class=\"flex min-h-[68px] w-full items-center gap-3 px-4 text-left\" data-kid=\"1-2-6-1\" data-name=\"emergency contact row\" id=\"contactRow\">\n                <span class=\"grid h-9 w-9 place-items-center rounded-[9px] bg-[#E7B84B]/10 text-[#E7B84B]\" data-kid=\"1-2-6-1-1\" data-name=\"icon container\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-6-1-1-1\" data-lucide=\"heart-pulse\" data-name=\"heart pulse icon\">\n                    </i>\n                </span>\n                <span class=\"min-w-0 flex-1\" data-kid=\"1-2-6-1-2\" data-name=\"contact details container\">\n                    <span class=\"block text-[12px] font-bold text-[#EDF5F8]\" data-kid=\"1-2-6-1-2-1\" data-name=\"contact name label\">\n                        Emergency contact\n                    </span>\n                    <span class=\"mt-0.5 block text-[11px] text-[#8CA2B4]\" data-kid=\"1-2-6-1-2-2\" data-name=\"contact description\">\n                        Priya Mehta · available now\n                    </span>\n                </span>\n                <i class=\"h-4 w-4 text-[#8CA2B4]\" data-kid=\"1-2-6-1-3\" data-lucide=\"chevron-right\" data-name=\"chevron icon\">\n                </i>\n            </button>\n            <button class=\"flex min-h-[68px] w-full items-center gap-3 px-4 text-left\" data-kid=\"1-2-6-2\" data-name=\"digital id row\" id=\"idRow\">\n                <span class=\"grid h-9 w-9 place-items-center rounded-[9px] bg-[#5AA7FF]/10 text-[#5AA7FF]\" data-kid=\"1-2-6-2-1\" data-name=\"icon container\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-6-2-1-1\" data-lucide=\"scan-face\" data-name=\"scan face icon\">\n                    </i>\n                </span>\n                <span class=\"min-w-0 flex-1\" data-kid=\"1-2-6-2-2\" data-name=\"id details container\">\n                    <span class=\"block text-[12px] font-bold text-[#EDF5F8]\" data-kid=\"1-2-6-2-2-1\" data-name=\"id label\">\n                        Digital tourist ID\n                    </span>\n                    <span class=\"mt-0.5 block sy-mono text-[10px] text-[#8CA2B4]\" data-kid=\"1-2-6-2-2-2\" data-name=\"id hash text\">\n                        SY-2026-8F92A1 · hash verified\n                    </span>\n                </span>\n                <span class=\"text-[10px] font-bold text-[#80E8CD]\" data-kid=\"1-2-6-2-3\" data-name=\"id status label\">\n                    READY\n                </span>\n            </button>\n        </section>\n        <section aria-labelledby=\"system-heading\" class=\"mt-4\" data-kid=\"1-2-7\" data-name=\"system status section\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-2-7-1\" data-name=\"system status header\">\n                <div data-kid=\"1-2-7-1-1\" data-name=\"system status title group\">\n                    <p class=\"text-[10px] font-bold uppercase tracking-[0.16em] text-[#8CA2B4]\" data-kid=\"1-2-7-1-1-1\" data-name=\"system status label\">\n                        System status\n                    </p>\n                    <h2 class=\"mt-1 text-[14px] font-bold\" data-kid=\"1-2-7-1-1-2\" data-name=\"system status headline\" id=\"system-heading\">\n                        Local safety signals\n                    </h2>\n                </div>\n                <span class=\"text-[10px] text-[#8CA2B4]\" data-kid=\"1-2-7-1-2\" data-name=\"test instruction text\">\n                    tap a row to test\n                </span>\n            </div>\n            <div class=\"mt-3 grid grid-cols-2 gap-2\" data-kid=\"1-2-7-2\" data-name=\"system signals grid\">\n                <button class=\"rounded-[9px] border border-[#1BD1A5]/30 bg-[#1BD1A5]/10 p-3 text-left\" data-kid=\"1-2-7-2-1\" data-name=\"online status button\" id=\"onlineStatus\">\n                    <span class=\"flex items-center gap-1.5 text-[10px] font-bold text-[#80E8CD]\" data-kid=\"1-2-7-2-1-1\" data-name=\"status indicator\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#1BD1A5]\" data-kid=\"1-2-7-2-1-1-1\" data-name=\"status dot\">\n                        </span>\n                        ONLINE\n                    </span>\n                    <span class=\"mt-2 block text-[11px] text-[#C7D3DD]\" data-kid=\"1-2-7-2-1-2\" data-name=\"signal description\">\n                        GPS telemetry\n                    </span>\n                </button>\n                <button class=\"rounded-[9px] border border-[#29465C] bg-[#0E1D2C] p-3 text-left\" data-kid=\"1-2-7-2-2\" data-name=\"loading status button\" id=\"loadingStatus\">\n                    <span class=\"flex items-center gap-1.5 text-[10px] font-bold text-[#C7D3DD]\" data-kid=\"1-2-7-2-2-1\" data-name=\"status indicator\">\n                        <i class=\"h-3 w-3\" data-kid=\"1-2-7-2-2-1-1\" data-lucide=\"loader-circle\" data-name=\"loading spinner icon\">\n                        </i>\n                        LOADING\n                    </span>\n                    <span class=\"mt-2 block text-[11px] text-[#8CA2B4]\" data-kid=\"1-2-7-2-2-2\" data-name=\"signal description\">\n                        Weather model\n                    </span>\n                </button>\n                <button class=\"rounded-[9px] border border-[#29465C] bg-[#0E1D2C] p-3 text-left\" data-kid=\"1-2-7-2-3\" data-name=\"empty status button\" id=\"emptyStatus\">\n                    <span class=\"flex items-center gap-1.5 text-[10px] font-bold text-[#C7D3DD]\" data-kid=\"1-2-7-2-3-1\" data-name=\"status indicator\">\n                        <i class=\"h-3 w-3\" data-kid=\"1-2-7-2-3-1-1\" data-lucide=\"inbox\" data-name=\"inbox icon\">\n                        </i>\n                        EMPTY\n                    </span>\n                    <span class=\"mt-2 block text-[11px] text-[#8CA2B4]\" data-kid=\"1-2-7-2-3-2\" data-name=\"signal description\">\n                        Unread notices\n                    </span>\n                </button>\n                <button class=\"rounded-[9px] border border-[#FF6870]/30 bg-[#FF6870]/10 p-3 text-left\" data-kid=\"1-2-7-2-4\" data-name=\"error status button\" id=\"errorStatus\">\n                    <span class=\"flex items-center gap-1.5 text-[10px] font-bold text-[#FF9DA2]\" data-kid=\"1-2-7-2-4-1\" data-name=\"status indicator\">\n                        <i class=\"h-3 w-3\" data-kid=\"1-2-7-2-4-1-1\" data-lucide=\"triangle-alert\" data-name=\"alert icon\">\n                        </i>\n                        FALLBACK\n                    </span>\n                    <span class=\"mt-2 block text-[11px] text-[#F3C2C5]\" data-kid=\"1-2-7-2-4-2\" data-name=\"signal description\">\n                        Map tiles unavailable\n                    </span>\n                </button>\n            </div>\n        </section>\n        <div aria-live=\"polite\" class=\"sy-fade mt-4 hidden rounded-[9px] border border-[#1BD1A5]/35 bg-[#1BD1A5]/10 px-3 py-3 text-[12px] font-semibold text-[#80E8CD]\" data-dynamic=\"true\" data-kid=\"1-2-8\" data-name=\"notification feedback area\" data-reason=\"text content and visibility updated by notification script\" id=\"feedback\" role=\"status\">\n        </div>\n        <footer class=\"mt-6 flex items-center justify-between text-[10px] text-[#6F8799]\" data-kid=\"1-2-9\" data-name=\"footer\">\n            <span class=\"sy-mono\" data-kid=\"1-2-9-1\" data-name=\"footer metadata\">\n                SY-1001 · local-first\n            </span>\n            <span data-kid=\"1-2-9-2\" data-name=\"last check-in timestamp\">\n                Last check-in 08:42 UTC\n            </span>\n        </footer>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest/dist/umd/lucide.min.js\">\n</script>\n<script>\n    lucide.createIcons();\n  const feedback = document.getElementById('feedback');\n  let feedbackTimer;\n  function notify(message, tone) {\n    feedback.textContent = message;\n    feedback.className = 'sy-fade mt-4 rounded-[9px] border px-3 py-3 text-[12px] font-semibold ' + (tone === 'critical' ? 'border-[#FF6870]/35 bg-[#FF6870]/10 text-[#FF9DA2]' : 'border-[#1BD1A5]/35 bg-[#1BD1A5]/10 text-[#80E8CD]');\n    clearTimeout(feedbackTimer);\n    feedbackTimer = setTimeout(() => feedback.classList.add('hidden'), 4200);\n  }\n  document.getElementById('sosButton').addEventListener('click', () => notify('SOS prepared locally · live GPS and verified ID attached.', 'critical'));\n  document.getElementById('locationButton').addEventListener('click', () => notify('Location update cached · 19.9322, 73.5304'));\n  document.getElementById('idButton').addEventListener('click', () => notify('Digital ID ready to share · SY-2026-8F92A1'));\n  document.getElementById('contactButton').addEventListener('click', () => notify('Emergency contact call handoff prepared.'));\n  document.getElementById('contactRow').addEventListener('click', () => notify('Priya Mehta is available now · +91 •••• 4821'));\n  document.getElementById('idRow').addEventListener('click', () => notify('Hash verified · no sensitive profile fields exposed.'));\n  document.getElementById('profileButton').addEventListener('click', () => notify('Profile is protected by verified digital ID.'));\n  document.getElementById('syncButton').addEventListener('click', () => notify('Sync queued · 3 local packets will reconcile when the network returns.'));\n  document.getElementById('timelineButton').addEventListener('click', () => notify('Showing the latest three safety signals.'));\n  document.getElementById('onlineStatus').addEventListener('click', () => notify('GPS telemetry is healthy and refreshing locally.'));\n  document.getElementById('loadingStatus').addEventListener('click', () => notify('Weather model still loading · core risk signals remain active.'));\n  document.getElementById('emptyStatus').addEventListener('click', () => notify('No unread notices right now.'));\n  document.getElementById('errorStatus').addEventListener('click', () => notify('Map fallback active · route coordinates remain visible.', 'critical'));\n</script>\n",
