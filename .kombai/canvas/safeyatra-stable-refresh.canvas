    "var_f496316c01ca": {
      "type": "variant",
      "label": "Authority Command Center · High Alert",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1855,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<div class=\"min-h-screen bg-[#08121D] text-[#EDF5F8] font-sans\" data-kid=\"1\" style=\"--ink:#08121D;--slate:#0E1D2C;--elevated:#152A3D;--line:#29465C;--mint:#1BD1A5;--cyan:#5AA7FF;--amber:#E7B84B;--coral:#FF6870;--muted:#91A7B5;--soft:#B8C7D0;\">\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap');\n    *{box-sizing:border-box} .sy-mono{font-family:'JetBrains Mono',ui-monospace,monospace} .sy-label{font-size:10px;letter-spacing:.13em;text-transform:uppercase;font-weight:700;color:var(--muted)}\n    .sy-button{min-height:44px;border:1px solid var(--line);border-radius:10px;padding:0 14px;font-size:12px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;background:transparent;color:#EDF5F8}\n    .sy-button:hover{border-color:var(--mint);color:var(--mint)} .sy-button.primary{background:var(--mint);border-color:var(--mint);color:var(--ink)} .sy-button.primary:hover{background:#72E0C2;border-color:#72E0C2;color:var(--ink)} .sy-button.danger{background:rgba(255,104,112,.12);border-color:rgba(255,104,112,.5);color:#FFD9DB}\n    .sy-card{background:var(--slate);border:1px solid var(--line);border-radius:12px} .sy-card.elevated{background:var(--elevated)}\n    .map-grid{background-color:#0b2536;background-image:linear-gradient(rgba(92,155,178,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(92,155,178,.09) 1px,transparent 1px);background-size:48px 48px}\n    .marker-pulse{animation:pulse 1.8s ease-out infinite}@keyframes pulse{0%{r:9;opacity:.9}70%{r:26;opacity:0}100%{r:26;opacity:0}}\n    @media(max-width:1050px){.main-grid{grid-template-columns:1fr 1.45fr}.inspector{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:18px}.inspector h2{grid-column:1/-1}.map-panel{min-height:530px}}\n    @media(max-width:720px){.shell{padding:14px}.main-grid{grid-template-columns:1fr}.inspector{display:block}.hide-mobile{display:none}.topbar{align-items:flex-start}.kpis{grid-template-columns:repeat(2,1fr)}.map-panel{min-height:390px}.queue{max-height:none}.page-title{font-size:24px}.actions{width:100%;display:grid;grid-template-columns:1fr}.actions .sy-button{width:100%}}\n    </style>\n    <header class=\"border-b border-[#29465C] bg-[#0E1D2C]\" data-kid=\"1-1\">\n        <div class=\"shell mx-auto max-w-[1500px] px-4 sm:px-6 lg:px-8\" data-kid=\"1-1-1\">\n            <div class=\"topbar flex min-h-[72px] items-center justify-between gap-4\" data-kid=\"1-1-1-1\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1-1\">\n                    <div class=\"grid h-10 w-10 place-items-center rounded-[10px] border border-[#1BD1A5]/40 bg-[#1BD1A5]/10 text-[#1BD1A5]\" data-kid=\"1-1-1-1-1-1\">\n                        <i class=\"h-5 w-5\" data-kid=\"1-1-1-1-1-1-1\" data-lucide=\"shield-check\">\n                        </i>\n                    </div>\n                    <div data-kid=\"1-1-1-1-1-2\">\n                        <p class=\"text-sm font-extrabold tracking-tight\" data-kid=\"1-1-1-1-1-2-1\">\n                            SafeYatra\n                            <span class=\"text-[#1BD1A5]\" data-kid=\"1-1-1-1-1-2-1-1\">\n                                AI\n                            </span>\n                        </p>\n                        <p class=\"sy-label mt-0.5\" data-kid=\"1-1-1-1-1-2-2\">\n                            Authority command center\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2 sm:gap-4\" data-kid=\"1-1-1-1-2\">\n                    <div class=\"hidden items-center gap-2 text-xs text-[#B8C7D0] sm:flex\" data-kid=\"1-1-1-1-2-1\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#1BD1A5]\" data-kid=\"1-1-1-1-2-1-1\">\n                        </span>\n                        Live network · Nashik district\n                    </div>\n                    <div class=\"flex items-center gap-2 rounded-full border border-[#29465C] bg-[#08121D] px-3 py-2 text-xs font-bold\" data-kid=\"1-1-1-1-2-2\">\n                        <i class=\"h-3.5 w-3.5 text-[#1BD1A5]\" data-kid=\"1-1-1-1-2-2-1\" data-lucide=\"wifi\">\n                        </i>\n                        <span data-kid=\"1-1-1-1-2-2-2\">\n                            Connected\n                        </span>\n                    </div>\n                    <div class=\"grid h-9 w-9 place-items-center rounded-full bg-[#5AA7FF]/15 font-mono text-xs font-bold text-[#5AA7FF]\" data-kid=\"1-1-1-1-2-3\">\n                        NC\n                    </div>\n                </div>\n            </div>\n        </div>\n    </header>\n    <main class=\"shell mx-auto max-w-[1500px] px-4 py-5 sm:px-6 lg:px-8 lg:py-7\" data-kid=\"1-2\">\n        <div class=\"mb-5 flex flex-wrap items-center justify-between gap-3 rounded-[12px] border border-[#FF6870]/50 bg-[#FF6870]/10 px-4 py-3\" data-kid=\"1-2-1\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-1\">\n                <span class=\"grid h-9 w-9 place-items-center rounded-full bg-[#FF6870]/20 text-[#FF9CA1]\" data-kid=\"1-2-1-1-1\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-2-1-1-1-1\" data-lucide=\"siren\">\n                    </i>\n                </span>\n                <div data-kid=\"1-2-1-1-2\">\n                    <p class=\"text-sm font-extrabold text-[#FFE9EA]\" data-kid=\"1-2-1-1-2-1\">\n                        Critical incident requires action\n                    </p>\n                    <p class=\"mt-0.5 text-xs text-[#F6B9BD]\" data-kid=\"1-2-1-1-2-2\">\n                        INC-2026-001 · Aarav Mehta · Danger zone entry + no movement\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"1-2-1-2\">\n                <span class=\"sy-mono text-xs 