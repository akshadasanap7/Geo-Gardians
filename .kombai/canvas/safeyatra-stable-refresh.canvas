trabold text-[#FFE9EA]\" data-kid=\"1-2-4-3-1-2-2-1\">\n                                94% AI risk\n                            </p>\n                            <p class=\"mt-1 text-xs text-[#F6B9BD]\" data-kid=\"1-2-4-3-1-2-2-2\">\n                                Danger zone + inactivity · authority notified\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-2 gap-x-4 gap-y-3 border-b border-[#29465C] pb-4\" data-kid=\"1-2-4-3-1-3\">\n                        <div data-kid=\"1-2-4-3-1-3-1\">\n                            <p class=\"sy-label\" data-kid=\"1-2-4-3-1-3-1-1\">\n                                Tourist\n                            </p>\n                            <p class=\"mt-1 text-sm font-semibold\" data-kid=\"1-2-4-3-1-3-1-2\">\n                                Aarav Mehta\n                            </p>\n                            <p class=\"sy-mono mt-1 text-[10px] text-[#91A7B5]\" data-kid=\"1-2-4-3-1-3-1-3\">\n                                SY-1001\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-4-3-1-3-2\">\n                            <p class=\"sy-label\" data-kid=\"1-2-4-3-1-3-2-1\">\n                                Source\n                            </p>\n                            <p class=\"mt-1 text-sm font-semibold\" data-kid=\"1-2-4-3-1-3-2-2\">\n                                SOS + AI\n                            </p>\n                            <p class=\"sy-mono mt-1 text-[10px] text-[#91A7B5]\" data-kid=\"1-2-4-3-1-3-2-3\">\n                                08:43 UTC\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-4-3-1-3-3\">\n                            <p class=\"sy-label\" data-kid=\"1-2-4-3-1-3-3-1\">\n                                Location\n                            </p>\n                            <p class=\"sy-mono mt-1 text-[11px] text-[#B8C7D0]\" data-kid=\"1-2-4-3-1-3-3-2\">\n                                20.0059, 73.7897\n                            </p>\n                        </div>\n                        <div data-kid=\"1-2-4-3-1-3-4\">\n                            <p class=\"sy-label\" data-kid=\"1-2-4-3-1-3-4-1\">\n                                Responder\n                            </p>\n                            <p class=\"mt-1 text-sm font-semibold text-[#F4D98C]\" data-kid=\"1-2-4-3-1-3-4-2\">\n                                Pending\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-4\" data-kid=\"1-2-4-3-2\">\n                    <p class=\"sy-label\" data-kid=\"1-2-4-3-2-1\">\n                        Escalation timeline\n                    </p>\n                    <div class=\"relative mt-3 pl-7\" data-kid=\"1-2-4-3-2-2\">\n                        <div class=\"absolute left-[9px] top-2 bottom-3 w-px bg-[#29465C]\" data-kid=\"1-2-4-3-2-2-1\">\n                        </div>\n                        <div class=\"relative mb-4\" data-kid=\"1-2-4-3-2-2-2\">\n                            <span class=\"absolute -left-7 top-0 grid h-[19px] w-[19px] place-items-center rounded-full bg-[#FF6870] text-[#08121D]\" data-kid=\"1-2-4-3-2-2-2-1\">\n                                <i class=\"h-3 w-3\" data-kid=\"1-2-4-3-2-2-2-1-1\" data-lucide=\"siren\">\n                                </i>\n                            </span>\n                            <p class=\"text-xs font-bold text-white\" data-kid=\"1-2-4-3-2-2-2-2\">\n                                Detected\n                                <span class=\"sy-mono ml-1 text-[10px] text-[#91A7B5]\" data-kid=\"1-2-4-3-2-2-2-2-1\">\n                                    08:42:44\n                                </span>\n                            </p>\n                            <p class=\"mt-1 text-xs text-[#91A7B5]\" data-kid=\"1-2-4-3-2-2-2-3\">\n                                AI risk crossed critical threshold\n                            </p>\n                        </div>\n                        <div class=\"relative mb-4\" data-kid=\"1-2-4-3-2-2-3\">\n                            <span class=\"absolute -left-7 top-0 grid h-[19px] w-[19px] place-items-center rounded-full bg-[#E7B84B] text-[#08121D]\" data-kid=\"1-2-4-3-2-2-3-1\">\n                                <i class=\"h-3 w-3\" data-kid=\"1-2-4-3-2-2-3-1-1\" data-lucide=\"check\">\n                                </i>\n                            </span>\n                            <p class=\"text-xs font-bold text-white\" data-kid=\"1-2-4-3-2-2-3-2\">\n                                Acknowledged\n                                <span class=\"sy-mono ml-1 text-[10px] text-[#91A7B5]\" data-kid=\"1-2-4-3-2-2-3-2-1\">\n                                    08:43:02\n                                </span>\n                            </p>\n                            <p class=\"mt-1 text-xs text-[#91A7B5]\" data-kid=\"1-2-4-3-2-2-3-3\">\n                                Control room accepted alert\n                            </p>\n                        </div>\n                        <div class=\"relative mb-4\" data-kid=\"1-2-4-3-2-2-4\">\n                            <span class=\"absolute -left-7 top-0 grid h-[19px] w-[19px] place-items-center rounded-full border border-[#5AA7FF] bg-[#5AA7FF]/15 text-[#A9CEFF]\" data-kid=\"1-2-4-3-2-2-4-1\">\n                                <i class=\"h-3 w-3\" data-kid=\"1-2-4-3-2-2-4-1-1\" data-lucide=\"radio-tower\">\n                                </i>\n                            </span>\n                            <p class=\"text-xs font-bold text-white\" data-kid=\"1-2-4-3-2-2-4-2\">\n                                Responder pending\n                            </p>\n                            <p class=\"mt-1 text-xs text-[#91A7B5]\" data-kid=\"1-2-4-3-2-2-4-3\">\n                                Assign Unit Alpha-07 to continue\n                            </p>\n                        </div>\n                        <div class=\"relative\" data-kid=\"1-2-4-3-2-2-5\">\n                            <span class=\"absolute -left-7 top-0 grid h-[19px] w-[19px] place-items-center rounded-full border border-[#29465C] bg-[#152A3D] text-[#91A7B5]\" data-kid=\"1-2-4-3-2-2-5-1\">\n                                <i class=\"h-3 w-3\" data-kid=\"1-2-4-3-2-2-5-1-1\" data-lucide=\"badge-check\">\n                                </i>\n                            </span>\n                            <p class=\"text-xs font-bold text-[#B8C7D0]\" data-kid=\"1-2-4-3-2-2-5-2\">\n                                Verify digital ID\n                            </p>\n                            <p class=\"mt-1 text-xs text-[#91A7B5]\" data-kid=\"1-2-4-3-2-2-5-3\">\n                                Privacy-safe identity receipt\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"mt-5 space-y-2\" data-kid=\"1-2-4-3-3\">\n                    <button class=\"sy-button w-full\" data-action=\"ack\" data-kid=\"1-2-4-3-3-1\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-4-3-3-1-1\" data-lucide=\"clipboard-check\">\n                        </i>\n                        Acknowledge\n                    </button>\n                    <button class=\"sy-button primary w-full\" data-action=\"assign\" data-kid=\"1-2-4-3-3-2\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-4-3-3-2-1\" data-lucide=\"user-round-check\">\n                        </i>\n                        Assign Unit Alpha-07\n                    </button>\n                    <button class=\"sy-button w-full\" data-action=\"verify\" data-kid=\"1-2-4-3-3-3\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-4-3-3-3-1\" data-lucide=\"scan-line\">\n                        </i>\n                        Verify digital ID\n                    </button>\n                </div>\n                <div class=\"mt-4 rounded-[10px] border border-[#29465C] bg-[#08121D] p-3\" data-kid=\"1-2-4-3-4\">\n                    <p class=\"sy-label\" data-kid=\"1-2-4-3-4-1\">\n                        Privacy boundary\n                    </p>\n                    <p class=\"mt-1 text-xs leading-5 text-[#91A7B5]\" data-kid=\"1-2-4-3-4-2\">\n                        Responder receives the verified hash and only the details required to assist Aarav.\n                    </p>\n                </div>\n            </aside>\n        </div>\n        <div class=\"mt-4 hidden rounded-[10px] border border-[#1BD1A5]/40 bg-[#1BD1A5]/10 px-4 py-3 text-xs font-semibold text-[#BDF7E8]\" data-dynamic=\"true\" data-kid=\"1-2-5\" data-name=\"action feedback status message\" data-reason=\"text content replaced by action handler script\" id=\"status\" role=\"status\">\n        </div>\n    </main>\n    <script src=\"https://unpkg.com/lucide@latest\">\n    </script>\n    <script>\n        lucide.createIcons();document.querySelectorAll('[data-action]').forEach(function(btn){btn.addEventListener('click',function(){var s=document.getElementById('status');var a=btn.getAttribute('data-action');var msg={ack:'Incident acknowledged. Unit Alpha-07 is now available for assignment.',assign:'Unit Alpha-07 assigned. Responder workspace has been updated.',verify:'Digital ID verification opened for SY-2026-8F92A1.',broadcast:'Safety notice composer ready for the Nashik district.',refresh:'Signal refreshed at 08:43:24 UTC.',filter:'Queue filter ready. Showing critical and high-risk incidents.',map:'Map view updated using cached operational tiles.',fallback:'Fallback check passed. Cached zones and last GPS snapshot are available.', 'select-critical':'INC-2026-001 remains selected for response.', 'select-secondary':'Incident selected. Inspector remains focused on the critical handoff.'}[a]||'Action recorded locally.';s.textContent=msg;s.classList.remove('hidden');window.clearTimeout(window.__statusTimer);window.__statusTimer=window.setTimeout(function(){s.classList.add('hidden')},4200)})});\n    </script>\n</div>\n",
