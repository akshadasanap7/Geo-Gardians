      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap');\n  .admin-root { min-height:100vh; background:#08121D; color:#EDF5F8; font-family:Inter,ui-sans-serif,system-ui,sans-serif; }\n  .admin-root .mono { font-family:'JetBrains Mono',ui-monospace,monospace; }\n  .admin-root .label { font-size:10px; letter-spacing:.13em; text-transform:uppercase; font-weight:800; color:#8AA0B2; }\n  .admin-root .surface { background:#0E1D2C; border:1px solid #29465C; border-radius:10px; }\n  .admin-root .surface-soft { background:#102335; border:1px solid #29465C; border-radius:8px; }\n  .admin-root button { min-height:42px; border-radius:8px; font-size:12px; font-weight:800; cursor:pointer; }\n  .admin-root button:focus-visible { outline:2px solid #1BD1A5; outline-offset:3px; }\n  .admin-root .ghost { background:transparent; border:1px solid #29465C; color:#B9CBD6; }\n  .admin-root .ghost:hover { border-color:#5AA7FF; color:#EDF5F8; }\n  .admin-root .mint-btn { background:#1BD1A5; color:#061A18; border:1px solid #1BD1A5; }\n  .admin-root .mint-btn:hover { background:#8EF0D6; }\n  .admin-root .coral-btn { background:#FF6870; color:#250D13; border:1px solid #FF6870; }\n  .admin-root .coral-btn:hover { background:#FF9296; }\n  .admin-root .feedback { position:fixed; right:28px; bottom:24px; z-index:20; max-width:360px; padding:12px 14px; border-radius:8px; background:#152A3D; border:1px solid #1BD1A5; color:#BDF5E6; font-size:12px; box-shadow:0 10px 28px rgba(0,0,0,.22); }\n  .admin-root .hidden { display:none; }\n  .admin-root .chart-grid { stroke:#29465C; stroke-width:1; opacity:.75; }\n  .admin-root .chart-line { fill:none; stroke:#5AA7FF; stroke-width:3; stroke-linecap:round; stroke-linejoin:round; }\n  .admin-root .chart-critical { fill:none; stroke:#FF6870; stroke-width:3; stroke-linecap:round; stroke-linejoin:round; }\n  .admin-root .chart-area { fill:#5AA7FF; opacity:.11; }\n  .admin-root .chart-point { fill:#0E1D2C; stroke:#FF6870; stroke-width:2; }\n  @media (max-width:900px) { .admin-root .layout { grid-template-columns:1fr !important; } .admin-root .kpis { grid-template-columns:repeat(2,1fr) !important; } }\n</style>\n<div class=\"admin-root\" data-kid=\"1\" data-name=\"admin dashboard application root\">\n    <header data-kid=\"1-1\" data-name=\"global navigation header\" style=\"height:74px;border-bottom:1px solid #29465C;display:flex;align-items:center;justify-content:space-between;padding:0 32px;gap:20px;position:sticky;top:0;z-index:10;background:#08121D;\">\n        <div data-kid=\"1-1-1\" data-name=\"application branding container\" style=\"display:flex;align-items:center;gap:14px;min-width:0;\">\n            <div data-kid=\"1-1-1-1\" data-name=\"shield check icon wrapper\" style=\"width:38px;height:38px;display:grid;place-items:center;border-radius:9px;background:#1BD1A5;color:#061A18;\">\n                <i data-kid=\"1-1-1-1-1\" data-lucide=\"shield-check\" data-name=\"shield check icon\" style=\"width:20px;height:20px;\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"branding title container\">\n                <div data-kid=\"1-1-1-2-1\" data-name=\"application name text\" style=\"font-size:14px;font-weight:800;letter-spacing:-.02em;\">\n                    SafeYatra\n                    <span data-kid=\"1-1-1-2-1-1\" data-name=\"AI branding suffix text\" style=\"color:#1BD1A5;\">\n                        AI\n                    </span>\n                </div>\n                <div class=\"label\" data-kid=\"1-1-1-2-2\" data-name=\"admin plane label text\" style=\"margin-top:3px;\">\n                    Admin control plane\n                </div>\n            </div>\n        </div>\n        <div data-kid=\"1-1-2\" data-name=\"account status and profile container\" style=\"display:flex;align-items:center;gap:22px;\">\n            <div data-kid=\"1-1-2-1\" data-name=\"environment status container\" style=\"display:flex;align-items:center;gap:8px;font-size:12px;color:#B9CBD6;\">\n                <span data-kid=\"1-1-2-1-1\" data-name=\"status indicator dot\" style=\"width:8px;height:8px;border-radius:999px;background:#E7B84B;box-shadow:0 0 0 4px rgba(231,184,75,.12);\">\n                </span>\n                <span data-kid=\"1-1-2-1-2\" data-name=\"environment status text\">\n                    Demo environment\n                </span>\n            </div>\n            <div data-kid=\"1-1-2-2\" data-name=\"vertical separator\" style=\"height:30px;width:1px;background:#29465C;\">\n            </div>\n            <div data-kid=\"1-1-2-3\" data-name=\"user profile container\" style=\"display:flex;align-items:center;gap:10px;\">\n                <div data-kid=\"1-1-2-3-1\" data-name=\"user initials avatar\" style=\"width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#152A3D;border:1px solid #29465C;color:#1BD1A5;font-size:11px;font-weight:800;\">\n                    SA\n                </div>\n                <div data-kid=\"1-1-2-3-2\" data-name=\"user info text container\">\n                    <div data-kid=\"1-1-2-3-2-1\" data-name=\"user name text\" style=\"font-size:12px;font-weight:700;\">\n                        System Administrator\n                    </div>\n                    <div class=\"label\" data-kid=\"1-1-2-3-2-2\" data-name=\"user ID label\" style=\"margin-top:2px;\">\n                        ADM-001\n                    </div>\n                </div>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main dashboard content area\" style=\"max-width:1480px;margin:0 auto;padding:28px 32px 48px;\">\n        <section data-kid=\"1-2-1\" data-name=\"dashboard header section\" style=\"display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:22px;\">\n            <div data-kid=\"1-2-1-1\" data-name=\"dashboard title group\">\n                <div class=\"label\" data-kid=\"1-2-1-1-1\" data-name=\"system status label text\" style=\"color:#E7B84B;\">\n                    System readiness / 08:44 UTC\n                </div>\n                <h1 data-kid=\"1-2-1-1-2\" data-name=\"hero headline text\" style=\"font-size:28px;line-height:1.12;letter-spacing:-.035em;margin:8px 0 0;font-weight:800;\">\n                    Keep the safety network ready.\n                </h1>\n                <p data-kid=\"1-2-1-1-3\" data-name=\"hero description text\" style=\"max-width:670px;color:#9FB2C0;font-size:14px;line-height:1.65;margin:10px 0 0;\">\n                    Review service health, risk policy, access boundaries and the offline queue before the next response signal.\n                </p>\n            </div>\n            <div data-kid=\"1-2-1-2\" data-name=\"primary action buttons container\" style=\"display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end;\">\n                <button class=\"ghost\" data-kid=\"1-2-1-2-1\" data-name=\"review policy button\" id=\"review-policy\">\n                    <i data-kid=\"1-2-1-2-1-1\" data-lucide=\"file-check-2\" data-name=\"file check icon\" style=\"width:15px;height:15px;vertical-align:-3px;margin-right:7px;\">\n                    </i>\n                    Review incident policy\n                </button>\n                <button class=\"mint-btn\" data-kid=\"1-2-1-2-2\" data-name=\"export audit button\" id=\"export-audit\">\n                    <i data-kid=\"1-2-1-2-2-1\" data-lucide=\"download\" data-name=\"download icon\" style=\"width:15px;height:15px;vertical-align:-3px;margin-right:7px;\">\n                    </i>\n                    Export audit CSV\n                </button>\n            </div>\n        </section>\n        <section class=\"surface\" data-kid=\"1-2-2\" data-name=\"sync warning banner section\" style=\"padding:16px 18px;margin-bottom:22px;border-color:rgba(231,184,75,.55);background:#17273A;display:flex;align-items:center;justify-content:space-between;gap:18px;\">\n            <div data-kid=\"1-2-2-1\" data-name=\"banner alert message group\" style=\"display:flex;align-items:flex-start;gap:12px;\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"warning icon container\" style=\"width:34px;height:34px;border-radius:8px;display:grid;place-items:center;background:rgba(231,184,75,.14);color:#E7B84B;flex:none;\">\n                    <i data-kid=\"1-2-2-1-1-1\" data-lucide=\"triangle-alert\" data-name=\"triangle alert icon\" style=\"width:18px;height:18px;\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-2-1-2\" data-name=\"warning text group\">\n                    <div data-kid=\"1-2-2-1-2-1\" data-name=\"warning banner title\" style=\"font-size:13px;font-weight:800;color:#FFF3C4;\">\n                        Sync worker needs attention\n                    </div>\n                    <div data-kid=\"1-2-2-1-2-2\" data-name=\"warning banner status details\" style=\"font-size:12px;color:#C6B985;margin-top:4px;\">\n                        97.8% healthy · 3 offline packets waiting · no data loss detected\n                    </div>\n                </div>\n            </div>\n            <button class=\"ghost\" data-kid=\"1-2-2-2\" data-name=\"retry sync button\" id=\"retry-banner\" style=\"border-color:rgba(231,184,75,.5);color:#FFF3C4;white-space:nowrap;\">\n                Retry sync\n            </button>\n        </section>\n        <section class=\"kpis\" data-kid=\"1-2-3\" data-name=\"KPI summary statistics section\" style=\"display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-bottom:22px;\">\n            <div class=\"surface\" data-kid=\"1-2-3-1\" data-name=\"active tourists KPI card\" style=\"padding:16px 17px;\">\n                <div class=\"label\" data-kid=\"1-2-3-1-1\" data-name=\"KPI card label\">\n                    Active tourists\n                </div>\n               