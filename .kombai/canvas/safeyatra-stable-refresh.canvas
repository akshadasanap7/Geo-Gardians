iv>\n                                        <div class=\"zone-meta\" data-kid=\"1-1-6-2-2-2-1-2-1-1-2\">\n                                            20.0012, 73.7440\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-1-6-2-2-2-1-2-1-2\">\n                                        <span class=\"zone-type danger\" data-kid=\"1-1-6-2-2-2-1-2-1-2-1\">\n                                            Danger\n                                        </span>\n                                    </td>\n                                    <td class=\"mono\" data-kid=\"1-1-6-2-2-2-1-2-1-3\">\n                                        1.2 km\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"1-1-6-2-2-2-1-2-2\">\n                                    <td data-kid=\"1-1-6-2-2-2-1-2-2-1\">\n                                        <div class=\"zone-name\" data-kid=\"1-1-6-2-2-2-1-2-2-1-1\">\n                                            Kalsubai Approach\n                                        </div>\n                                        <div class=\"zone-meta\" data-kid=\"1-1-6-2-2-2-1-2-2-1-2\">\n                                            19.8451, 73.6750\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-1-6-2-2-2-1-2-2-2\">\n                                        <span class=\"zone-type caution\" data-kid=\"1-1-6-2-2-2-1-2-2-2-1\">\n                                            Caution\n                                        </span>\n                                    </td>\n                                    <td class=\"mono\" data-kid=\"1-1-6-2-2-2-1-2-2-3\">\n                                        2.4 km\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"1-1-6-2-2-2-1-2-3\">\n                                    <td data-kid=\"1-1-6-2-2-2-1-2-3-1\">\n                                        <div class=\"zone-name\" data-kid=\"1-1-6-2-2-2-1-2-3-1-1\">\n                                            Trimbakeshwar Corridor\n                                        </div>\n                                        <div class=\"zone-meta\" data-kid=\"1-1-6-2-2-2-1-2-3-1-2\">\n                                            19.9322, 73.5304\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-1-6-2-2-2-1-2-3-2\">\n                                        <span class=\"zone-type safe\" data-kid=\"1-1-6-2-2-2-1-2-3-2-1\">\n                                            Safe\n                                        </span>\n                                    </td>\n                                    <td class=\"mono\" data-kid=\"1-1-6-2-2-2-1-2-3-3\">\n                                        4.0 km\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n                </div>\n            </article>\n        </section>\n    </div>\n    <div class=\"toast\" data-dynamic=\"true\" data-kid=\"1-2\" data-name=\"toast notification container\" data-reason=\"visibility and content managed by script\" id=\"toast\">\n        <i data-kid=\"1-2-1\" data-lucide=\"check-circle-2\" height=\"15\" width=\"15\">\n        </i>\n        <span data-dynamic=\"true\" data-kid=\"1-2-2\" data-name=\"toast message text\" data-reason=\"text content replaced on user action\" id=\"toast-text\">\n            Action completed.\n        </span>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest/dist/umd/lucide.min.js\">\n</script>\n<script>\n    lucide.createIcons();\n  const toast = document.getElementById('toast');\n  const toastText = document.getElementById('toast-text');\n  let toastTimer;\n  function showToast(message) { toastText.textContent = message; toast.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.remove('show'), 3600); }\n  document.querySelectorAll('[data-action]').forEach((element) => element.addEventListener('click', () => showToast(element.dataset.action)));\n  document.querySelectorAll('.incident').forEach((element) => element.addEventListener('click', () => { document.querySelectorAll('.incident').forEach((item) => item.classList.remove('selected')); element.classList.add('selected'); showToast(element.dataset.action); }));\n  document.getElementById('retry-sync').addEventListener('click', () => { showToast('Sync retry queued · local packets remain safe until connected.'); });\n</script>\n",
      "comments": [],
      "created": "2026-07-26T05:40:05.455234+00:00",
      "modified": "2026-07-26T05:41:15.389369+00:00",
      "id": "var_6dc95c9d08f9"
    },
    "var_88556bd1615a": {
      "type": "variant",
      "label": "Tourist Dashboard · Operational Clarity",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 13845,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap');\n  .sy-tourist{--ink:#08121D;--slate:#0E1D2C;--elevated:#152A3D;--line:#29465C;--muted:#93A7B5;--text:#EDF5F8;--mint:#1BD1A5;--cyan:#5AA7FF;--amber:#E7B84B;--coral:#FF6870;background:var(--ink);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,sans-serif;min-height:100vh;box-sizing:border-box}\n  .sy-tourist *, .sy-tourist *::before, .sy-tourist *::after{box-sizing:border-box}\n  .sy-tourist button,.sy-tourist input{font:inherit}\n  .sy-shell{max-width:1440px;margin:0 auto;padding:22px 30px 44px}\n  .sy-topbar{display:flex;align-items:center;justify-content:space-between;gap:18px;border-bottom:1px solid var(--line);padding:0 0 18px}\n  .sy-brand{display:flex;align-items:center;gap:12px;min-width:210px}\n  .sy-brand-mark{display:grid;place-items:center;width:38px;height:38px;border:1px solid rgba(27,209,165,.55);border-radius:10px;color:var(--mint);background:rgba(27,209,165,.08)}\n  .sy-brand-name{font-size:14px;font-weight:800;letter-spacing:-.02em}.sy-brand-sub{display:block;color:var(--muted);font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin-top:3px}\n  .sy-topmeta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}\n  .sy-chip{display:inline-flex;align-items:center;gap:7px;min-height:34px;padding:0 11px;border:1px solid var(--line);border-radius:999px;background:rgba(14,29,44,.72);color:#CFE0E7;font-size:12px;font-weight:700}\n  .sy-chip i{width:14px;height:14px}.sy-chip-live{border-color:rgba(27,209,165,.45);color:#8CEFD8;background:rgba(27,209,165,.08)}\n  .sy-profile{display:flex;align-items:center;gap:9px;padding-left:4px}.sy-avatar{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--elevated);color:var(--mint);font:700 11px 'JetBrains Mono',monospace}.sy-profile-copy{font-size:12px;font-weight:700}.sy-profile-copy span{display:block;color:var(--muted);font-size:10px;font-weight:500;margin-top:2px}\n  .sy-eyebrow{color:var(--mint);font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.sy-title{font-size:28px;line-height:1.1;letter-spacing:-.035em;font-weight:800;margin:7px 0 0}.sy-subtitle{max-width:690px;color:var(--muted);font-size:13px;line-height:1.65;margin:9px 0 0}\n  .sy-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;padding:27px 0 22px}.sy-journey{display:flex;align-items:center;gap:9px;color:#CFE0E7;font-size:12px;font-weight:700}.sy-journey i{width:16px;color:var(--cyan)}.sy-journey small{font:500 11px 'JetBrains Mono',monospace;color:var(--muted)}\n  .sy-grid-main{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,1.62fr) minmax(270px,.84fr);gap:15px;align-items:start}\n  .sy-panel{border:1px solid var(--line);border-radius:12px;background:var(--slate);overflow:hidden}.sy-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 17px 13px;border-bottom:1px solid var(--line)}.sy-panel-title{font-size:13px;font-weight:800;letter-spacing:-.01em}.sy-panel-note{color:var(--muted);font-size:11px;line-height:1.45;margin-top:4px}.sy-panel-body{padding:16px 17px}\n  .sy-safety{background:linear-gradient(145deg,rgba(27,209,165,.11),rgba(14,29,44,.96) 47%);border-color:rgba(27,209,165,.35)}\n  .sy-safety-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.sy-status{display:inline-flex;align-items:center;gap:6px;color:#8CEFD8;font-size:11px;font-weight:800}.sy-status-dot{width:7px;height:7px;border-radius:50%;background:var(--mint);box-shadow:0 0 0 4px rgba(27,209,165,.12)}\n  .sy-score{display:flex;align-items:center;gap:18px;margin-top:22px}.sy-score-ring{width:112px;height:112px;flex:0 0 112px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--mint) 0 64.8deg,rgba(41,70,92,.75) 64.8deg 360deg);position:relative}.sy-score-ring::after{content:'';position:absolute;inset:10px;border-radius:50%;background:var(--slate)}.sy-score-number{position:relative;z-index:1;font:700 30px 'JetBrains Mono',monospace;letter-spacing:-.08em}.sy-score-number small{display:block;text-align:center;font:700 9px Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:2px}.sy-score-copy h3{font-size:20px;margin:0;font-weight:800}.sy-score-copy p{color:var(--muted);font-size:12px;line-height:1.55;margin:6px 0 0}.sy-bar{height:6px;border-radius:999px;background:rgba(41,70,92,.7);overflow:hidden;margin-top:19px}.sy-bar span{display:block;height:100%;width:18%;border-radius:inherit;background:var(--mint)}\n  .sy-facts{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);margin-top:18px}.sy-fact{padding:13px 0 0}.sy-fact:nth-child(2){padding-left:13px;border-left:1px solid var(--line)}.sy-label{font-size:10px;color:var(--muted);font-weight:800;letter-spacing:.1em;text-transform:uppercase}.sy-value{font:600 12px 'JetBrains Mono',monospace;margin-top:7px;color:#E6F2F5;word-break:break-word}.sy-copy{font-size:12px;color:var(--muted);line-height:1.55;margin-top:5px}\n  .sy-map{min-height:436px}.sy-map .sy-panel-body{padding:0}.sy-map-canvas{position:relative;height:365px;overflow:hidden;background:#0A1B2A}.sy-map-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(90,167,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(90,167,255,.08) 1px,transparent 1px);background-size:40px 40px;opacity:.7}.sy-map-label{position:absolute;z-index:2;color:rgba(207,224,231,.65);font-size:10px;font-weight:700;letter-spacing:.05em}.sy-map-label.one{left:12%;top:17%}.sy-map-label.two{left:61%;top:14%}.sy-map-label.three{left:71%;top:76%}.sy-map-legend{position:absolute;z-index:3;left:14px;top:13px;display:flex;gap:8px;flex-wrap:wrap;padding:7px 8px;border:1px solid rgba(41,70,92,.9);border-radius:8px;background:rgba(8,18,29,.82);font-size:10px;color:#CFE0E7}.sy-map-legend span{display:inline-flex;align-items:center;gap:5px}.sy-map-legend b{width:7px;height:7px;border-radius:50%;display:block}.sy-map-ui{position:absolute;right:12px;top:12px;z-index:3;display:flex;gap:6px}.sy-map-ui button{display:grid;place-items:center;width:30px;height:30px;border:1px solid var(--line);border-radius:8px;background:rgba(8,18,29,.85);color:#CFE0E7;cursor:pointer}.sy-map-ui i{width:14px;height:14px}.sy-map-tooltip{position:absolute;z-index:4;left:47%;top:49%;min-width:158px;padding:10px 11px;border:1px solid rgba(27,209,165,.48);border-radius:9px;background:rgba(8,18,29,.94);box-shadow:0 9px 24px rgba(0,0,0,.22)}.sy-map-tooltip strong{display:block;font-size:11px}.sy-map-tooltip span{display:block;color:var(--muted);font:500 10px 'JetBrains Mono',monospace;margin-top:5px}.sy-map-footer{display:flex;justify-content:space-between;gap:12px;padding:12px 15px;border-top:1px solid var(--line);font-size:11px;color:var(--muted)}.sy-map-footer span{display:inline-flex;align-items:center;gap:7px}.sy-map-footer .good{color:#8CEFD8}.sy-map-footer i{width:14px;height:14px}\n  .sy-rail{display:flex;flex-direction:column;gap:15px}.sy-action-list{display:grid;gap:8px}.sy-action{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:44px;padding:0 12px;border:1px solid var(--line);border-radius:9px;background:rgba(21,42,61,.62);color:#E9F3F6;font-size:12px;font-weight:800;text-align:left;cursor:pointer}.sy-action:hover{border-color:rgba(90,167,255,.65);background:rgba(90,167,255,.08)}.sy-action i{width:16px;height:16px;color:var(--cyan)}.sy-action .arrow{color:var(--muted);width:14px;height:14px}.sy-action-coral{background:rgba(255,104,112,.13);border-color:rgba(255,104,112,.52);color:#FFE7E8}.sy-action-coral i{color:var(--coral)}.sy-action-coral:hover{background:rgba(255,104,112,.2);border-color:var(--coral)}\n  .sy-contacts{display:grid;gap:9px}.sy-contact{display:flex;align-items:center;gap:9px;padding:9px 0;border-bottom:1px solid rgba(41,70,92,.72)}.sy-contact:last-child{border-bottom:0;padding-bottom:0}.sy-contact-avatar{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:rgba(90,167,255,.11);color:var(--cyan);font-size:11px;font-weight:800}.sy-contact-copy{min-width:0;flex:1}.sy-contact-copy strong{display:block;font-size:11px}.sy-contact-copy span{display:block;color:var(--muted);font-size:10px;margin-top:3px}.sy-call{display:grid;place-items:center;width:30px;height:30px;border:1px solid var(--line);border-radius:8px;background:transparent;color:var(--mint);cursor:pointer}.sy-call i{width:14px;height:14px}\n  .sy-id-row{display:flex;align-items:center;gap:11px}.sy-id-mark{display:grid;place-items:center;width:36px;height:36px;border-radius:8px;background:rgba(27,209,165,.1);color:var(--mint);border:1px solid rgba(27,209,165,.32)}.sy-id-mark i{width:17px;height:17px}.sy-id-copy{min-width:0;flex:1}.sy-id-copy strong{display:block;font-size:11px}.sy-id-copy span{display:block;color:var(--muted);font:500 10px 'JetBrains Mono',monospace;margin-top:4px}.sy-verified{color:#8CEFD8;font-size:10px;font-weight:800;white-space:nowrap}\n  .sy-bottom{display:grid;grid-template-columns:1.1fr .9fr;gap:15px;margin-top:15px}.sy-timeline{display:grid;gap:0}.sy-step{display:grid;grid-template-columns:20px 1fr auto;gap:10px;align-items:start;min-height:54px}.sy-step-mark{position:relative;display:grid;place-items:center;width:20px;height:20px;border-radius:50%;background:rgba(27,209,165,.13);border:1px solid rgba(27,209,165,.4);color:var(--mint);z-index:1}.sy-step:not(:last-child) .sy-step-mark::after{content:'';position:absolute;top:19px;left:9px;width:1px;height:35px;background:var(--line)}.sy-step-mark i{width:11px;height:11px}.sy-step-copy strong{display:block;font-size:12px}.sy-step-copy span{display:block;color:var(--muted);font-size:11px;line-height:1.45;margin-top:4px}.sy-step-time{color:var(--muted);font:500 10px 'JetBrains Mono',monospace;white-space:nowrap}.sy-offline{display:flex;align-items:flex-start;gap:11px;padding:12px;border:1px solid rgba(231,184,75,.35);border-radius:9px;background:rgba(231,184,75,.08);color:#F8E0A1}.sy-offline i{width:17px;height:17px;flex:0 0 auto;color:var(--amber);margin-top:1px}.sy-offline strong{display:block;color:#FFF1C8;font-size:12px}.sy-offline p{color:#D6C48F;font-size:11px;line-height:1.5;margin:4px 0 0}.sy-progress{height:5px;margin-top:9px;border-radius:999px;background:rgba(231,184,75,.18);overflow:hidden}.sy-progress span{display:block;width:42%;height:100%;background:var(--amber)}\n  .sy-examples{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}.sy-state{display:flex;align-items:center;gap:6px;min-height:32px;padding:0 9px;border:1px dashed var(--line);border-radius:8px;color:var(--muted);font-size:10px}.sy-state i{width:13px;height:13px}.sy-state.loading{color:#A9C9FF;border-color:rgba(90,167,255,.45)}.sy-state.empty{color:#D6C48F;border-color:rgba(231,184,75,.4)}.sy-state.error{color:#FFB5B9;border-color:rgba(255,104,112,.45)}\n  .sy-feedback{position:fixed;right:28px;bottom:24px;z-index:10;display:none;align-items:center;gap:8px;min-height:42px;padding:0 13px;border:1px solid rgba(27,209,165,.45);border-radius:9px;background:#102A39;color:#B5F5E6;font-size:12px;font-weight:700;box-shadow:0 10px 25px rgba(0,0,0,.25)}.sy-feedback.show{display:flex}.sy-feedback i{width:15px;height:15px}\n  @media (max-width:1080px){.sy-grid-main{grid-template-columns:1fr 1.25fr}.sy-rail{grid-column:1 / -1;display:grid;grid-template-columns:1fr 1fr 1fr}.sy-bottom{grid-template-columns:1fr}.sy-action-list{grid-template-columns:1fr 1fr}.sy-safety{min-height:100%}}\n  @media (max-width:720px){.sy-shell{padding:16px 14px 34px}.sy-topbar{align-items:flex-start}.sy-topmeta{gap:6px}.sy-chip{min-height:31px;padding:0 8px;font-size:10px}.sy-chip.user-chip{display:none}.sy-profile-copy{display:none}.sy-hero{align-items:flex-start;flex-direction:column;padding:22px 0 18px;gap:10px}.sy-title{font-size:23px}.sy-grid-main,.sy-bottom{display:block}.sy-map{margin-top:15px}.sy-rail{display:block;margin-top:15px}.sy-rail>.sy-panel{margin-top:15px}.sy-rail>.sy-panel:first-child{margin-top:0}.sy-action-list{grid-template-columns:1fr 1fr}.sy-bottom>.sy-panel{margin-top:15px}.sy-bottom>.sy-panel:first-child{margin-top:0}.sy-map-canvas{height:300px}.sy-score{gap:13px}.sy-score-ring{width:94px;height:94px;flex-basis:94px}.sy-score-ring::after{inset:9px}.sy-score-number{font-size:25px}.sy-feedback{right:14px;bottom:14px;left:14px;justify-content:center}}\n</style>\n<div class=\"sy-tourist\" data-kid=\"1\">\n    <div class=\"sy-shell\" data-kid=\"1-1\">\n        <header class=\"sy-topbar\" data-kid=\"1-1-1\">\n            <div class=\"sy-brand\" data-kid=\"1-1-1-1\">\n                <span class=\"sy-brand-mark\" data-kid=\"1-1-1-1-1\">\n                    <i data-kid=\"1-1-1-1-1-1\" data-lucide=\"shield-check\">\n                    </i>\n                </span>\n                <div data-kid=\"1-1-1-1-2\">\n                    <div class=\"sy-brand-name\" data-kid=\"1-1-1-1-2-1\">\n                        SafeYatra\n                        <span data-kid=\"1-1-1-1-2-1-1\" style=\"color:var(--mint)\">\n                            AI\n                        </span>\n                    </div>\n                    <span class=\"sy-brand-sub\" data-kid=\"1-1-1-1-2-2\">\n                        Tourist safety companion\n                    </span>\n                </div>\n            </div>\n            <div class=\"sy-topmeta\" data-kid=\"1-1-1-2\">\n                <span class=\"sy-chip sy-chip-live\" data-kid=\"1-1-1-2-1\">\n                    <span class=\"sy-status-dot\" data-kid=\"1-1-1-2-1-1\">\n                    </span>\n                    <i data-kid=\"1-1-1-2-1-2\" data-lucide=\"wifi\">\n                    </i>\n                    Protected\n                </span>\n                <span class=\"sy-chip\" data-kid=\"1-1-1-2-2\">\n                    <i data-kid=\"1-1-1-2-2-1\" data-lucide=\"route\">\n                    </i>\n                    Journey active\n                </span>\n                <span class=\"sy-chip user-chip\" data-dynamic=\"true\" data-kid=\"1-1-1-2-3\" data-name=\"last sync time chip\" data-reason=\"text updated via script on load/sync\">\n                    <i data-kid=\"1-1-1-2-3-1\" data-lucide=\"clock-3\">\n                    </i>\n                    Last sync 08:42 UTC\n                </span>\n                <div class=\"sy-profile\" data-kid=\"1-1-1-2-4\">\n                    <span class=\"sy-avatar\" data-kid=\"1-1-1-2-4-1\">\n                        AM\n                    </span>\n                    <div class=\"sy-profile-copy\" data-kid=\"1-1-1-2-4-2\">\n                        Aarav Mehta\n                        <span data-kid=\"1-1-1-2-4-2-1\">\n                            SY-1001 · Tourist\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </header>\n        <section class=\"sy-hero\" data-kid=\"1-1-2\">\n            <div data-kid=\"1-1-2-1\">\n                <div class=\"sy-eyebrow\" data-kid=\"1-1-2-1-1\">\n                    Your active journey\n                </div>\n                <h1 class=\"sy-title\" data-kid=\"1-1-2-1-2\">\n                    Stay covered between every signal.\n                </h1>\n                <p class=\"sy-subtitle\" data-kid=\"1-1-2-1-3\">\n                    SafeYatra is watching your route, local risk and network health. You stay in control of the next action.\n                </p>\n            </div>\n            <div class=\"sy-journey\" data-kid=\"1-1-2-2\">\n                <i data-kid=\"1-1-2-2-1\" data-lucide=\"map-pin\">\n                </i>\n                <span data-kid=\"1-1-2-2-2\">\n                    Nashik\n                </span>\n                <i data-kid=\"1-1-2-2-3\" data-lucide=\"arrow-right\" style=\"colo