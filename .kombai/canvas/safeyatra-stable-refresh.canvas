                           <strong data-kid=\"1-1-3-3-2-2-1-2-1\">\n                                    SY-2026-8F92A1\n                                </strong>\n                                <span data-kid=\"1-1-3-3-2-2-1-2-2\">\n                                    Hash 0x8f92...a1b3\n                                </span>\n                            </div>\n                            <span class=\"sy-verified\" data-kid=\"1-1-3-3-2-2-1-3\">\n                                Verified\n                            </span>\n                        </div>\n                        <button class=\"sy-action\" data-action=\"QR display opened\" data-kid=\"1-1-3-3-2-2-2\" style=\"margin-top:13px;width:100%;justify-content:center\">\n                            <span data-kid=\"1-1-3-3-2-2-2-1\">\n                                <i data-kid=\"1-1-3-3-2-2-2-1-1\" data-lucide=\"scan-line\">\n                                </i>\n                                Show QR for responder\n                            </span>\n                        </button>\n                    </div>\n                </section>\n                <section class=\"sy-panel\" data-kid=\"1-1-3-3-3\">\n                    <div class=\"sy-panel-head\" data-kid=\"1-1-3-3-3-1\">\n                        <div data-kid=\"1-1-3-3-3-1-1\">\n                            <div class=\"sy-eyebrow\" data-kid=\"1-1-3-3-3-1-1-1\">\n                                People to call\n                            </div>\n                            <div class=\"sy-panel-title\" data-kid=\"1-1-3-3-3-1-1-2\" style=\"margin-top:6px\">\n                                Emergency contacts\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"sy-panel-body\" data-kid=\"1-1-3-3-3-2\">\n                        <div class=\"sy-contacts\" data-kid=\"1-1-3-3-3-2-1\">\n                            <div class=\"sy-contact\" data-kid=\"1-1-3-3-3-2-1-1\">\n                                <span class=\"sy-contact-avatar\" data-kid=\"1-1-3-3-3-2-1-1-1\">\n                                    PM\n                                </span>\n                                <div class=\"sy-contact-copy\" data-kid=\"1-1-3-3-3-2-1-1-2\">\n                                    <strong data-kid=\"1-1-3-3-3-2-1-1-2-1\">\n                                        Priya Mehta\n                                    </strong>\n                                    <span data-kid=\"1-1-3-3-3-2-1-1-2-2\">\n                                        Emergency contact · +91 98••• 4412\n                                    </span>\n                                </div>\n                                <button aria-label=\"Call Priya Mehta\" class=\"sy-call\" data-action=\"Calling Priya Mehta\" data-kid=\"1-1-3-3-3-2-1-1-3\">\n                                    <i data-kid=\"1-1-3-3-3-2-1-1-3-1\" data-lucide=\"phone\">\n                                    </i>\n                                </button>\n                            </div>\n                            <div class=\"sy-contact\" data-kid=\"1-1-3-3-3-2-1-2\">\n                                <span class=\"sy-contact-avatar\" data-kid=\"1-1-3-3-3-2-1-2-1\" style=\"color:var(--amber);background:rgba(231,184,75,.1)\">\n                                    NC\n                                </span>\n                                <div class=\"sy-contact-copy\" data-kid=\"1-1-3-3-3-2-1-2-2\">\n                                    <strong data-kid=\"1-1-3-3-3-2-1-2-2-1\">\n                                        Nashik Control Room\n                                    </strong>\n                                    <span data-kid=\"1-1-3-3-3-2-1-2-2-2\">\n                                        Authority desk · 24/7 response\n                                    </span>\n                                </div>\n                                <button aria-label=\"Call control room\" class=\"sy-call\" data-action=\"Calling control room\" data-kid=\"1-1-3-3-3-2-1-2-3\">\n                                    <i data-kid=\"1-1-3-3-3-2-1-2-3-1\" data-lucide=\"radio\">\n                                    </i>\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n            </aside>\n        </main>\n        <section class=\"sy-bottom\" data-kid=\"1-1-4\">\n            <section class=\"sy-panel\" data-kid=\"1-1-4-1\">\n                <div class=\"sy-panel-head\" data-kid=\"1-1-4-1-1\">\n                    <div data-kid=\"1-1-4-1-1-1\">\n                        <div class=\"sy-eyebrow\" data-kid=\"1-1-4-1-1-1-1\">\n                            Safety timeline\n                        </div>\n                        <div class=\"sy-panel-title\" data-kid=\"1-1-4-1-1-1-2\" style=\"margin-top:6px\">\n                            Quiet signals, accounted for\n                        </div>\n                    </div>\n                    <span class=\"sy-chip\" data-kid=\"1-1-4-1-1-2\" style=\"min-height:29px;font-size:10px\">\n                        <i data-kid=\"1-1-4-1-1-2-1\" data-lucide=\"activity\">\n                        </i>\n                        Live\n                    </span>\n                </div>\n                <div class=\"sy-panel-body\" data-kid=\"1-1-4-1-2\">\n                    <div class=\"sy-timeline\" data-kid=\"1-1-4-1-2-1\">\n                        <div class=\"sy-step\" data-kid=\"1-1-4-1-2-1-1\">\n                            <div class=\"sy-step-mark\" data-kid=\"1-1-4-1-2-1-1-1\">\n                                <i data-kid=\"1-1-4-1-2-1-1-1-1\" data-lucide=\"check\">\n                                </i>\n                            </div>\n                            <div class=\"sy-step-copy\" data-kid=\"1-1-4-1-2-1-1-2\">\n                                <strong data-kid=\"1-1-4-1-2-1-1-2-1\">\n                                    Journey started\n                                </strong>\n                                <span data-kid=\"1-1-4-1-2-1-1-2-2\">\n                                    Route and emergency contacts are active.\n                                </span>\n                            </div>\n                            <span class=\"sy-step-time\" data-kid=\"1-1-4-1-2-1-1-3\">\n                                07:42\n                            </span>\n                        </div>\n                        <div class=\"sy-step\" data-kid=\"1-1-4-1-2-1-2\">\n                            <div class=\"sy-step-mark\" data-kid=\"1-1-4-1-2-1-2-1\">\n                                <i data-kid=\"1-1-4-1-2-1-2-1-1\" data-lucide=\"map-pin\">\n                                </i>\n                            </div>\n                            <div class=\"sy-step-copy\" data-kid=\"1-1-4-1-2-1-2-2\">\n                                <strong data-kid=\"1-1-4-1-2-1-2-2-1\">\n                                    Temple corridor entered\n                                </strong>\n                                <span data-kid=\"1-1-4-1-2-1-2-2-2\">\n                                    Safe geo-fence confirmed locally.\n                                </span>\n                            </div>\n                            <span class=\"sy-step-time\" data-kid=\"1-1-4-1-2-1-2-3\">\n                                08:08\n                            </span>\n                        </div>\n                        <div class=\"sy-step\" data-kid=\"1-1-4-1-2-1-3\">\n                            <div class=\"sy-step-mark\" data-kid=\"1-1-4-1-2-1-3-1\">\n                                <i data-kid=\"1-1-4-1-2-1-3-1-1\" data-lucide=\"refresh-cw\">\n                                </i>\n                            </div>\n                            <div class=\"sy-step-copy\" data-kid=\"1-1-4-1-2-1-3-2\">\n                                <strong data-kid=\"1-1-4-1-2-1-3-2-1\">\n                                    Next check-in window\n                                </strong>\n                                <span data-kid=\"1-1-4-1-2-1-3-2-2\">\n                                    SafeYatra will prompt you at 09:00 UTC.\n                                </span>\n                            </div>\n                            <span class=\"sy-step-time\" data-kid=\"1-1-4-1-2-1-3-3\">\n                                09:00\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n            <section class=\"sy-panel\" data-kid=\"1-1-4-2\">\n                <div class=\"sy-panel-head\" data-kid=\"1-1-4-2-1\">\n                    <div data-kid=\"1-1-4-2-1-1\">\n                        <div class=\"sy-eyebrow\" data-kid=\"1-1-4-2-1-1-1\">\n                            Offline-first protection\n                        </div>\n                        <div class=\"sy-panel-title\" data-kid=\"1-1-4-2-1-1-2\" style=\"margin-top:6px\">\n                            Network is available\n                        </div>\n                    </div>\n                    <span class=\"sy-chip\" data-kid=\"1-1-4-2-1-2\" style=\"min-height:29px;color:#8CEFD8;border-color:rgba(27,209,165,.3);font-size:10px\">\n                        <i data-kid=\"1-1-4-2-1-2-1\" data-lucide=\"cloud\">\n                        </i>\n                        Synced\n                    </span>\n                </div>\n                <div class=\"sy-panel-body\" data-kid=\"1-1-4-2-2\">\n                    <div class=\"sy-offline\" data-kid=\"1-1-4-2-2-1\" style=\"border-color:rgba(27,209,165,.3);background:rgba(27,209,165,.06);color:#C6F8ED\">\n                        <i data-kid=\"1-1-4-2-2-1-1\" data-lucide=\"database\">\n                        </i>\n                        <div data-kid=\"1-1-4-2-2-1-2\">\n                            <strong data-kid=\"1-1-4-2-2-1-2-1\" style=\"color:#C6F8ED\">\n                                Local safety features ready\n                            </strong>\n                            <p data-kid=\"1-1-4-2-2-1-2-2\" style=\"color:#9ADCCC\">\n                                GPS, geo-fencing, risk analysis and SOS continue even if coverage drops.\n                            </p>\n                            <div class=\"sy-progress\" data-kid=\"1-1-4-2-2-1-2-3\" style=\"background:rgba(27,209,165,.16)\">\n                                <span data-dynamic=\"true\" data-kid=\"1-1-4-2-2-1-2-3-1\" data-name=\"offline feature readiness progress bar\" data-reason=\"width controlled by sync script\" style=\"width:100%;background:var(--mint)\">\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"sy-copy\" data-dynamic=\"true\" data-kid=\"1-1-4-2-2-2\" data-name=\"sync status text\" data-reason=\"last sync timestamp updated by sync script\" style=\"margin-top:11px\">\n                        0 pending packets · Last successful sync 08:42 UTC\n                    </div>\n                </div>\n            </section>\n        </section>\n        <div class=\"sy-feedback\" data-kid=\"1-1-5\" id=\"sy-feedback\">\n            <i data-kid=\"1-1-5-1\" data-lucide=\"check-circle-2\">\n            </i>\n            <span data-dynamic=\"true\" data-kid=\"1-1-5-2\" data-name=\"feedback notification text\" data-reason=\"text replaced by action trigger script\" id=\"sy-feedback-text\">\n                Action ready\n            </span>\n        </div>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n  const feedback=document.getElementById('sy-feedback'); const feedbackText=document.getElementById('sy-feedback-text'); let timer;\n  document.querySelectorAll('[data-action]').forEach((button)=>button.addEventListener('click',()=>{feedbackText.textContent=button.getAttribute('data-action');feedback.classList.add('show');clearTimeout(timer);timer=setTimeout(()=>feedback.classList.remove('show'),2600)}));\n</script>\n",
      "comments": [],
      "created": "2026-07-26T05:40:06.126921+00:00",
      "modified": "2026-07-26T05:41:12.973590+00:00",
      "id": "var_88556bd1615a"
    },
    "var_093811a1a244": {
      "type": "variant",
      "label": "Responder Dashboard · Field Compact",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 15225,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap');\n  :root { --ink:#08121D; --slate:#0E1D2C; --elevated:#152A3D; --line:#29465C; --muted:#9BB0BF; --text:#EDF5F8; --mint:#1BD1A5; --cyan:#5AA7FF; --amber:#E7B84B; --coral:#FF6870; }\n  body { margin:0; min-width:320px; background:var(--ink); color:var(--text); font-family:Inter,ui-sans-serif,system-ui,sans-serif; }\n  button, input { font:inherit; }\n  button { cursor:pointer; }\n  .font-mono { font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,monospace; }\n  .app { min-height:100vh; background:var(--ink); }\n  .topbar { position:sticky; top:0; z-index:20; display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:68px; padding:0 16px; border-bottom:1px solid var(--line); background:rgba(8,18,29,.96); }\n  .brand { display:flex; align-items:center; gap:10px; min-width:0; }\n  .brand-mark { display:grid; place-items:center; width:34px; height:34px; border:1px solid rgba(27,209,165,.5); border-radius:9px; color:var(--mint); background:rgba(27,209,165,.08); }\n  .brand-name { font-size:13px; font-weight:800; letter-spacing:-.02em; }\n  .brand-sub { margin-top:2px; color:#7890A0; font-size:9px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }\n  .unit-pill { display:flex; align-items:center; gap:7px; padding:8px 10px; border:1px solid rgba(27,209,165,.35); border-radius:999px; background:rgba(27,209,165,.07); color:#A4F2DD; font-size:10px; font-weight:800; white-space:nowrap; }\n  .live-dot { width:7px; height:7px; border-radius:50%; background:var(--mint); box-shadow:0 0 0 4px rgba(27,209,165,.12); }\n  .content { width:min(100%,720px); margin:0 auto; padding:16px 14px 34px; }\n  .offline { display:flex; align-items:flex-start; gap:10px; padding:11px 12px; border:1px solid rgba(231,184,75,.45); border-radius:10px; background:rgba(231,184,75,.08); color:#F8D98D; }\n  .offline i { flex:0 0 auto; margin-top:1px; }\n  .eyebrow { color:#8DA7B6; font-size:10px; font-weight:800; letter-spacing:.14em; line-height:1.3; text-transform:uppercase; }\n  .offline strong { display:block; color:#FFF4D3; font-size:12px; }\n  .offline p { margin:3px 0 0; color:#D7C28A; font-size:11px; line-height:1.45; }\n  .section { margin-top:16px; }\n  .assignment { padding:16px; border:1px solid var(--line); border-radius:12px; background:var(--slate); }\n  .assignment-top { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }\n  h1,h2,h3,p { margin-top:0; }\n  h1 { margin-bottom:5px; font-size:22px; line-height:1.12; letter-spacing:-.04em; }\n  .lede { margin-bottom:0; color:#9FB2BE; font-size:12px; line-height:1.5; }\n  .critical-badge { display:inline-flex; align-items:center; gap:6px; padding:6px 8px; border:1px solid rgba(255,104,112,.48); border-radius:999px; background:rgba(255,104,112,.1); color:#FFB9BD; font-size:10px; font-weight:800; white-space:nowrap; }\n  .incident-line { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:15px; padding-top:13px; border-top:1px solid var(--line); }\n  .incident-id { color:#DCEAF0; font-size:12px; font-weight:800; }\n  .incident-meta { color:#86A0AF; font-size:10px; }\n  .map-card { position:relative; height:228px; overflow:hidden; border:1px solid var(--line); border-radius:12px; background:#0B2536; }\n  .map-label { position:absolute; top:12px; left:12px; z-index:2; padding:7px 9px; border:1px solid rgba(90,167,255,.35); border-radius:8px; background:rgba(8,18,29,.86); color:#DDEFFF; font-size:10px; font-weight:800; }\n  .map-label span { display:block; margin-top:2px; color:#8DA7B6; font-size:9px; font-weight:600; }\n  .map-tools { position:absolute; top:12px; right:12px; z-index:2; display:flex; gap:6px; }\n  .icon-btn { display:grid; place-items:center; width:34px; height:34px; border:1px solid rgba(255,255,255,.16); border-radius:8px; background:rgba(8,18,29,.82); color:#D3E2E8; }\n  .route-pin { position:absolute; z-index:2; display:grid; place-items:center; width:34px; height:34px; border-radius:50%; background:var(--coral); color:white; box-shadow:0 0 0 7px rgba(255,104,112,.16); }\n  .route-pin.target { left:66%; top:49%; }\n  .route-pin.unit { left:25%; top:73%; background:var(--mint); box-shadow:0 0 0 7px rgba(27,209,165,.15); }\n  .map-footer { position:absolute; right:12px; bottom:12px; left:12px; z-index:2; display:flex; align-items:center; justify-content:space-between; gap:10px; padding:9px 10px; border:1px solid rgba(255,255,255,.13); border-radius:8px; background:rgba(8,18,29,.88); }\n  .map-footer span { color:#DCEAF0; font-size:10px; font-weight:700; }\n  .map-footer small { display:block; margin-top:2px; color:#8DA7B6; font-size:9px; }\n  .map-footer button { min-height:40px; padding:0 11px; border:0; border-radius:7px; background:var(--mint); color:var(--ink); font-size:11px; font-weight:800; }\n  .facts { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }\n  .fact { min-height:74px; padding:12px; border:1px solid var(--line); border-radius:10px; background:var(--slate); }\n  .fact-value { margin-top:8px; color:#F4FAFB; font-size:13px; font-weight:800; line-height:1.25; }\n  .fact-value.mono { font-family:'JetBrains Mono',ui-monospace,monospace; font-size:12px; }\n  .risk-card { padding:14px; border:1px solid rgba(255,104,112,.45); border-radius:12px; background:rgba(255,104,112,.07); }\n  .risk-row { display:flex; align-items:center; justify-content:space-between; gap:12px; }\n  .risk-score { color:#FFB9BD; font-family:'JetBrains Mono',ui-monospace,monospace; font-size:32px; font-weight:700; letter-spacing:-.08em; }\n  .risk-copy strong { display:block; color:#FFF3F4; font-size:13px; }\n  .risk-copy p { margin:4px 0 0; color:#D6A4AA; font-size:11px; line-height:1.4; }\n  .risk-bar { height:7px; margin-top:13px; overflow:hidden; border-radius:999px; background:#341F2B; }\n  .risk-bar span { display:block; width:94%; height:100%; border-radius:inherit; background:var(--coral); }\n  .contact { display:flex; align-items:center; gap:11px; padding:12px; border:1px solid var(--line); border-radius:10px; background:var(--slate); }\n  .avatar { display:grid; place-items:center; width:36px; height:36px; border-radius:9px; background:rgba(90,167,255,.13); color:#B9D9FF; font-size:11px; font-weight:800; }\n  .contact-main { min-width:0; flex:1; }\n  .contact-main strong { display:block; color:#F3F8FA; font-size:12px; }\n  .contact-main span { display:block; margin-top:3px; color:#91A7B4; font-size:11px; }\n  .call-btn { display:grid; place-items:center; width:42px; height:42px; border:1px solid rgba(90,167,255,.4); border-radius:9px; background:rgba(90,167,255,.1); color:#B8D8FF; }\n  .id-row { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px; border:1px solid rgba(27,209,165,.32); border-radius:10px; background:rgba(27,209,165,.06); }\n  .id-left { display:flex; align-items:center; gap:10px; }\n  .id-icon { display:grid; place-items:center; width:34px; height:34px; border-radius:8px; background:rgba(27,209,165,.13); color:var(--mint); }\n  .id-left strong { display:block; color:#E5FFF8; font-size:12px; }\n  .id-left span { display:block; margin-top:3px; color:#97C7BB; font-family:'JetBrains Mono',ui-monospace,monospace; font-size:10px; }\n  .verified { color:#8AF0D3; font-size:10px; font-weight:800; }\n  .status-actions { display:grid; gap:8px; }\n  .action { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:46px; padding:0 13px; border:1px solid var(--line); border-radius:9px; background:var(--slate); color:#EAF4F7; font-size:12px; font-weight:800; text-align:left; }\n  .action span { display:flex; align-items:center; gap:9px; }\n  .action.primary { border-color:rgba(27,209,165,.35); background:var(--mint); color:var(--ink); }\n  .action.critical { border-color:rgba(255,104,112,.42); background:rgba(255,104,112,.12); color:#FFD9DB; }\n  .action small { color:inherit; opacity:.68; font-size:10px; font-weight:700; }\n  .checklist { padding:14px; border:1px solid var(--line); border-radius:12px; background:var(--slate); }\n  .checklist-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; }\n  .checklist h2 { margin-bottom:0; font-size:14px; letter-spacing:-.02em; }\n  .progress { color:#9FC0D0; font-family:'JetBrains Mono',ui-monospace,monospace; font-size:10px; }\n  .check { display:flex; align-items:center; gap:10px; min-height:40px; border-top:1px solid rgba(41,70,92,.65); color:#BFD0D8; font-size:11px; }\n  .check input { width:17px; height:17px; accent-color:var(--mint); }\n  .fallback { display:flex; align-items:flex-start; gap:10px; padding:12px; border:1px dashed #42647A; border-radius:10px; background:rgba(90,167,255,.05); }\n  .fallback i { margin-top:2px; color:#9DCBFF; }\n  .fallback strong { display:block; color:#DDECFA; font-size:11px; }\n  .fallback p { margin:4px 0 0; color:#93AAB9; font-size:10px; line-height:1.45; }\n  .fallback button { margin-top:8px; min-height:38px; padding:0 10px; border:1px solid rgba(90,167,255,.4); border-radius:7px; background:transparent; color:#B9D9FF; font-size:10px; font-weight:800; }\n  .toast { position:fixed; right:14px; bottom:16px; left:14px; z-index:30; display:none; align-items:center; gap:9px; padding:11px 12px; border:1px solid rgba(27,209,165,.45); border-radius:9px; background:#102C35; color:#C7FFF0; font-size:11px; box-shadow:0 12px 28px rgba(0,0,0,.25); }\n  .toast.show { display:flex; }\n  @media (min-width:720px) { .content { padding:28px 24px 44px; } .facts { grid-template-columns:repeat(4,minmax(0,1fr)); } }\n</style>\n<div class=\"app\" data-kid=\"1\">\n    <header class=\"topbar\" data-kid=\"1-1\">\n        <div class=\"brand\" data-kid=\"1-1-1\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\">\n                <i data-kid=\"1-1-1-1-1\" data-lucide=\"shield-check\" style=\"width:18px;height:18px\">\n                </i>\n            </span>\n            <span data-kid=\"1-1-1-2\">\n                <span class=\"brand-name\" data-kid=\"1-1-1-2-1\">\n                    SafeYatra\n                    <span data-kid=\"1-1-1-2-1-1\" style=\"color:var(--mint)\">\n                        AI\n                    </span>\n                </span>\n                <span class=\"brand-sub\" data-kid=\"1-1-1-2-2\">\n                    Responder field console\n                </span>\n            </span>\n        </div>\n        <div class=\"unit-pill\" data-kid=\"1-1-2\">\n            <span class=\"live-dot\" data-kid=\"1-1-2-1\">\n            </span>\n            Unit Alpha-07\n        </div>\n    </header>\n    <main class=\"content\" data-kid=\"1-2\">\n        <div class=\"offline\" data-kid=\"1-2-1\">\n            <i data-kid=\"1-2-1-1\" data-lucide=\"wifi-off\" style=\"width:17px;height:17px\">\n            </i>\n            <div data-kid=\"1-2-1-2\">\n                <strong data-dynamic=\"true\" data-kid=\"1-2-1-2-1\" data-name=\"offline sync status text\" data-reason=\"updated by sync script\">\n                    Offline sync active · 1 update queued\n                </strong>\n                <p data-kid=\"1-2-1-2-2\">\n                    GPS and status changes stay on device. Updates will sync automatically when coverage returns.\n                </p>\n            </div>\n        </div>\n        <section aria-labelledby=\"assignment-title\" class=\"section assignment\" data-kid=\"1-2-2\">\n            <div class=\"assignment-top\" data-kid=\"1-2-2-1\">\n                <div data-kid=\"1-2-2-1-1\">\n                    <div class=\"eyebrow\" data-kid=\"1-2-2-1-1-1\">\n                        Current assignment\n                    </div>\n                    <h1 data-kid=\"1-2-2-1-1-2\" id=\"assignment-title\">\n                        Aarav Mehta needs help.\n                    </h1>\n                    <p class=\"lede\" data-kid=\"1-2-2-1-1-3\">\n                        Gangapur Dam Service Road · 2.4 km from your unit\n                    </p>\n                </div>\n                <span class=\"critical-badge\" data-kid=\"1-2-2-1-2\">\n                    <i data-kid=\"1-2-2-1-2-1\" data-lucide=\"siren\" style=\"width:13px;height:13px\">\n                    </i>\n                    CRITICAL\n                </span>\n            </div>\n            <div class=\"incident-line\" data-kid=\"1-2-2-2\">\n                <span class=\"incident-id font-mono\" data-kid=\"1-2-2-2-1\">\n                    INC-2026-001\n                </span>\n                <span class=\"incident-meta\" data-kid=\"1-2-2-2-2\">\n                    Assigned 08:40 UTC · Ravi Patil\n                </span>\n            </div>\n        </section>\n        <section aria-label=\"Route map\" class=\"section map-card\" data-kid=\"1-2-3\">\n            <div class=\"map-label\" data-kid=\"1-2-3-1\">\n                <i data-kid=\"1-2-3-1-1\" data-lucide=\"navigation\" style=\"width:13px;height:13px;vertical-align:-2px\">\n                </i>\n                Route guidance\n                <span data-dynamic=\"true\" data-kid=\"1-2-3-1-2\" data-name=\"route metadata text\" data-reason=\"updated by GPS sync script\">\n                    Cached route · last GPS 18 sec ago\n                </span>\n            </div>\n            <div class=\"map-tools\" data-kid=\"1-2-3-2\">\n                <button aria-label=\"Center route\" class=\"icon-btn\" data-action=\"center\" data-kid=\"1-2-3-2-1\">\n                    <i data-kid=\"1-2-3-2-1-1\" data-lucide=\"crosshair\" style=\"width:16px;height:16px\">\n                    </i>\n                </button>\n                <button aria-label=\"Open map layers\" class=\"icon-btn\" data-action=\"layers\" data-kid=\"1-2-3-2-2\">\n                    <i data-kid=\"1-2-3-2-2-1\" data-lucide=\"layers-3\" style=\"width:16px;height:16px\">\n                    </i>\n                </button>\n            </div>\n            <svg aria-hidden=\"true\" data-kid=\"1-2-3-3\" height=\"100%\" preserveaspectratio=\"none\" viewbox=\"0 0 400 240\" width=\"100%\">\n                <rect fill=\"#0B2536\" height=\"240\" width=\"400\">\n                </rect>\n                <path d=\"M-10 205 C55 168 92 190 137 147 S204 92 252 123 S330 164 420 79\" fill=\"none\" stroke=\"#1C4152\" stroke-width=\"28\">\n                </path>\n                <path d=\"M-10 205 C55 168 92 190 137 147 S204 92 252 123 S330 164 420 79\" fill=\"none\" stroke=\"#89B1B6\" stroke-dasharray=\"7 8\" stroke-opacity=\".35\" stroke-width=\"2\">\n                </path>\n                <path d=\"M45 -10 L86 250 M0 72 L400 32 M202 -10 L150 250 M296 -10 L340 250\" fill=\"none\" stroke=\"#164052\" stroke-width=\"1\">\n                </path>\n                <path d=\"M62 195 C108 170 117 168 150 144 S211 101 245 119 S302 145 340 103\" fill=\"none\" stroke=\"#5AA7FF\" stroke-dasharray=\"5 7\" stroke-linecap=\"round\" stroke-width=\"3\">\n                </path>\n                <path d=\"M263 63 C307 56 348 78 368 119 C378 145 356 178 322 180 C288 182 258 163 247 132 C237 105 241 76 263 63Z\" fill=\"#FF6870\" fill-opacity=\".1\" stroke=\"#FF6870\" stroke-dasharray=\"5 4\" stroke-opacity=\".65\" stroke-width=\"1.5\">\n                </path>\n                <text fill=\"#FFB9BD\" font-family=\"Inter\" font-size=\"9\" font-weight=\"700\" x=\"271\" y=\"96\">\n                    DANGER ZONE\n                </text>\n                <circle cx=\"100\" cy=\"171\" fill=\"#1BD1A5\" r=\"5\">\n                </circle>\n                <circle cx=\"100\" cy=\"171\" fill=\"none\" r=\"12\" stroke=\"#1BD1A5\" stroke-opacity=\".35\">\n                </circle>\n                <circle cx=\"301\" cy=\"119\" fill=\"#FF6870\" r=\"6\">\n                </circle>\n                <circle cx=\"301\" cy=\"119\" fill=\"none\" r=\"15\" stroke=\"#FF6870\" stroke-opacity=\".45\">\n                </circle>\n            </svg>\n            <div class=\"route-pin unit\" data-kid=\"1-2-3-4\">\n                <i data-kid=\"1-2-3-4-1\" data-lucide=\"radio\" style=\"width:16px;height:16px\">\n                </i>\n            </div>\n            <div class=\"route-pin target\" data-kid=\"1-2-3-5\">\n                <i data-kid=\"1-2-3-5-1\" data-lucide=\"siren\" style=\"width:16px;height:16px\">\n                </i>\n            </div>\n            <div class=\"map-footer\" data-kid=\"1-2-3-6\">\n                <div data-kid=\"1-2-3-6-1\">\n                    <span data-dynamic=\"true\" data-kid=\"1-2-3-6-1-1\" data-name=\"ETA and distance text\" data-reason=\"updated by route calculation script\">\n                        06 min ETA · 2.4 km\n                    </span>\n                    <small data-kid=\"1-2-3-6-1-2\">\n                        Wet road · mixed terrain\n                    </small>\n                </div>\n                <button data-action=\"navigate\" data-kid=\"1-2-3-6-2\">\n                    <i data-kid=\"1-2-3-6-2-1\" data-lucide=\"navigation\" style=\"width:13px;height:13px;vertical-align:-2px\">\n                    </i>\n                    Start navigation\n                </button>\n            </div>\n        </section>\n        <section class=\"section risk-card\" data-kid=\"1-2-4\">\n            <div class=\"risk-row\" data-kid=\"1-2-4-1\">\n                <div class=\"risk-score\" data-kid=\"1-2-4-1-1\">\n                    94%\n                </div>\n                <div class=\"risk-copy\" data-kid=\"1-2-4-1-2\">\n                    <strong data-kid=\"1-2-4-1-2-1\">\n                        Critical risk signal\n                    </strong>\n                    <p data-kid=\"1-2-4-1-2-2\">\n                        SOS + live GPS + danger zone entry\n                    </p>\n                </div>\n                <i data-kid=\"1-2-4-1-3\" data-lucide=\"triangle-alert\" style=\"width:22px;height:22px;color:var(--coral)\">\n                </i>\n            </div>\n            <div class=\"risk-bar\" data-kid=\"1-2-4-2\">\n                <span data-kid=\"1-2-4-2-1\">\n                </span>\n            </div>\n        </section>\n        <section aria-label=\"Incident facts\" class=\"section facts\" data-kid=\"1-2-5\">\n            <div class=\"fact\" data-kid=\"1-2-5-1\">\n                <div class=\"eyebrow\" data-kid=\"1-2-5-1-1\">\n                    Tourist\n                </div>\n                <div class=\"fact-value\" data-kid=\"1-2-5-1-2\">\n                    Aarav Mehta\n                </div>\n            </div>\n            <div class=\"fact\" data-kid=\"1-2-5-2\">\n                <div class=\"eyebrow\" data-kid=\"1-2-5-2-1\">\n                    Zone\n                </div>\n                <div class=\"fact-value\" data-kid=\"1-2-5-2-2\">\n                    Gangapur Dam\n                </div>\n            </div>\n            <div class=\"fact\" data-kid=\"1-2-5-3\">\n                <div class=\"eyebrow\" data-kid=\"1-2-5-3-1\">\n                    Distance\n                </div>\n                <div class=\"fact-value mono\" data-kid=\"1-2-5-3-2\">\n                    2.4 km\n                </div>\n            </div>\n            <div class=\"fact\" data-kid=\"1-2-5-4\">\n                <div class=\"eyebrow\" data-kid=\"1-2-5-4-1\">\n                    Status\n                </div>\n                <div class=\"fact-value\" data-dynamic=\"true\" data-kid=\"1-2-5-4-2\" data-name=\"incident status text\" data-reason=\"updated by state change script\" style=\"color:#9DCBFF\">\n                    Assigned\n                </div>\n            </div>\n        </section>\n        <section class=\"section contact\" data-kid=\"1-2-6\">\n            <div class=\"avatar\" data-kid=\"1-2-6-1\">\n                AM\n            </div>\n            <div class=\"contact-main\" data-kid=\"1-2-6-2\">\n                <strong data-kid=\"1-2-6-2-1\">\n                    Emergency contact · Neha Mehta\n                </strong>\n                <span data-kid=\"1-2-6-2-2\">\n                    +91 98•• ••• 214 · family contact\n                </span>\n            </div>\n            <button aria-label=\"Call emergency contact\" class=\"call-btn\" data-action=\"call\" data-kid=\"1-2-6-3\">\n                <i data-kid=\"1-2-6-3-1\" data-lucide=\"phone\" style=\"width:17px;height:17px\">\n                </i>\n            </button>\n        </section>\n        <section class=\"section id-row\" data-kid=\"1-2-7\">\n            <div class=\"id-left\" data-kid=\"1-2-7-1\">\n                <div class=\"id-icon\" data-kid=\"1-2-7-1-1\">\n                    <i data-kid=\"1-2-7-1-1-1\" data-lucide=\"badge-check\" style=\"width:17px;height:17px\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-7-1-2\">\n                    <strong data-kid=\"1-2-7-1-2-1\">\n                        Digital ID verified\n                    </strong>\n                    <span data-kid=\"1-2-7-1-2-2\">\n                        SY-2026-8F92A1 · hash matched\n                    </span>\n                </div>\n            </div>\n            <span class=\"verified\" data-kid=\"1-2-7-2\">\n                VERIFIED\n            </span>\n        </section>\n        <section aria-label=\"Incident status actions\" class=\"section status-actions\" data-kid=\"1-2-8\">\n            <button class=\"action primary\" data-action=\"progress\" data-kid=\"1-2-8-1\">\n                <span data-kid=\"1-2-8-1-1\">\n                    <i data-kid=\"1-2-8-1-1-1\" data-lucide=\"play-circle\" style=\"width:17px;height:17px\">\n                    </i>\n                    Mark in progress\n                </span>\n                <small data-kid=\"1-2-8-1-2\">\n                    Next\n                </small>\n            </button>\n            <button class=\"action critical\" data-action=\"contact-tourist\" data-kid=\"1-2-8-2\">\n                <span data-kid=\"1-2-8-2-1\">\n                    <i data-kid=\"1-2-8-2-1-1\" data-lucide=\"phone-call\" style=\"width:17px;height:17px\">\n                    </i>\n                    Call tourist\n                </span>\n                <small data-kid=\"1-2-8-2-2\">\n                    +91 9•••\n                </small>\n            </button>\n            <button class=\"action\" data-action=\"resolve\" data-kid=\"1-2-8-3\">\n                <span data-kid=\"1-2-8-3-1\">\n                    <i data-kid=\"1-2-8-3-1-1\" data-lucide=\"check-circle-2\" style=\"width:17px;height:17px\">\n                    </i>\n                    Resolve incident\n                </span>\n                <small data-kid=\"1-2-8-3-2\">\n                    Audit note\n                </small>\n            </button>\n        </section>\n        <section class=\"section checklist\" data-kid=\"1-2-9\">\n            <div class=\"checklist-head\" data-kid=\"1-2-9-1\">\n                <h2 data-kid=\"1-2-9-1-1\">\n                    Field checklist\n                </h2>\n                <span class=\"progress\" data-dynamic=\"true\" data-kid=\"1-2-9-1-2\" data-name=\"checklist progress text\" data-reason=\"updated by checkbox event listener\">\n                    1 / 4 done\n                </span>\n            </div>\n            <label class=\"check\" data-kid=\"1-2-9-2\">\n                <input checked=\"\" data-kid=\"1-2-9-2-1\" type=\"checkbox\"/>\n                Confirm route and radio channel\n            </label>\n            <label class=\"check\" data-kid=\"1-2-9-3\">\n                <input data-kid=\"1-2-9-3-1\" type=\"checkbox\"/>\n                Verify Aarav’s digital ID on arrival\n            </label>\n            <label class=\"check\" data-kid=\"1-2-9-4\">\n                <input data-kid=\"1-2-9-4-1\" type=\"checkbox\"/>\n                Share safe-zone handoff with authority\n            </label>\n            <label class=\"check\" data-kid=\"1-2-9-5\">\n                <input data-kid=\"1-2-9-5-1\" type=\"checkbox\"/>\n                Add resolution note before closing\n            </label>\n        </section>\n        <section class=\"section fallback\" data-kid=\"1-2-10\">\n            <i data-kid=\"1-2-10-1\" data-lucide=\"map-off\" style=\"width:18px;height:18px\">\n            </i>\n            <div data-kid=\"1-2-10-2\">\n                <strong data-kid=\"1-2-10-2-1\">\n                    Navigation tiles unavailable\n                </strong>\n                <p data-kid=\"1-2-10-2-2\">\n                    Cached coordinates are still usable. The route remains available offline; retry tiles when the network returns.\n                </p>\n                <button data-action=\"retry-map\" data-kid=\"1-2-10-2-3\">\n                    Retry map tiles\n                </button>\n            </div>\n        </section>\n    </main>\n    <div aria-live=\"polite\" class=\"toast\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"status toast notification\" data-reason=\"shown or hidden by feedback script\" id=\"toast\" role=\"status\">\n        <i data-kid=\"1-3-1\" data-lucide=\"check-circle-2\" style=\"width:16px;height:16px\">\n        </i>\n        <span data-dynamic=\"true\" data-kid=\"1-3-2\" data-name=\"toast notification text\" data-reason=\"text replaced by feedback function\" id=\"toast-text\">\n            Action queued locally.\n        </span>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n  const toast = document.getElementById('toast');\n  const toastText = document.getElementById('toast-text');\n  let toastTimer;\n  function feedback(message) { toastText.textContent = message; toast.classList.add('show'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.remove('show'), 3600); }\n  document.querySelectorAll('[data-action]').forEach((button) => button.addEventListener('click', () => {\n    const action = button.dataset.action;\n    const messages = { navigate:'Navigation started · cached route active.', center:'Route centered on Unit Alpha-07.', layers:'Map layers ready · danger zone highlighted.', call:'Emergency contact call queued locally.', 'contact-tourist':'Call request queued · Ravi can continue offline.', progress:'Incident moved to in progress · update queued.', resolve:'Resolution note required before closing.', 'retry-map':'Map retry queued · cached coordinates remain available.' };\n    feedback(messages[action] || 'Action queued locally.');\n  }));\n  document.querySelectorAll('.check input').forEach((input) => input.addEventListener('change', () => { const done = document.querySelectorAll('.check input:checked').length; document.querySelector('.progress').textContent = done + ' / 4 done'; feedback(done === 4 ? 'Checklist complete · ready to resolve.' : 'Checklist updated locally.'); }));\n</script>\n",
