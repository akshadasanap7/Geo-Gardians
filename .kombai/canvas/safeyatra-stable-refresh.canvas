2-18-1-2\">\n                                Safe\n                            </span>\n                        </div>\n                        <div class=\"mt-2 flex items-center gap-2\" data-kid=\"1-2-3-2-2-18-2\">\n                            <span class=\"marker-caution static h-2 w-2 border-0 shadow-none\" data-kid=\"1-2-3-2-2-18-2-1\">\n                            </span>\n                            <span class=\"text-slate-300\" data-kid=\"1-2-3-2-2-18-2-2\">\n                                Caution\n                            </span>\n                        </div>\n                        <div class=\"mt-2 flex items-center gap-2\" data-kid=\"1-2-3-2-2-18-3\">\n                            <span class=\"marker-critical static h-2 w-2 border-0 shadow-none\" data-kid=\"1-2-3-2-2-18-3-1\">\n                            </span>\n                            <span class=\"text-slate-300\" data-kid=\"1-2-3-2-2-18-3-2\">\n                                Critical incident\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"map-error mx-5 mb-5 rounded-[8px] border border-[#E7B84B]/35 bg-[#E7B84B]/10 px-4 py-3\" data-kid=\"1-2-3-2-3\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"1-2-3-2-3-1\">\n                        <i class=\"mt-0.5 h-4 w-4 shrink-0 text-[#E7B84B]\" data-kid=\"1-2-3-2-3-1-1\" data-lucide=\"triangle-alert\">\n                        </i>\n                        <div data-kid=\"1-2-3-2-3-1-2\">\n                            <p class=\"text-xs font-bold text-[#F7D982]\" data-kid=\"1-2-3-2-3-1-2-1\">\n                                Map rendering fallback is ready\n                            </p>\n                            <p class=\"mt-1 text-xs leading-5 text-[#D9BA68]\" data-kid=\"1-2-3-2-3-1-2-2\">\n                                If the tile provider fails, keep the last cached positions visible and expose a retry action instead of blanking the workspace.\n                            </p>\n                        </div>\n                        <button class=\"ml-auto shrink-0 text-xs font-bold text-[#F7D982] underline underline-offset-4\" data-feedback=\"Map retry queued\" data-kid=\"1-2-3-2-3-1-3\">\n                            Retry map\n                        </button>\n                    </div>\n                </div>\n            </section>\n            <aside aria-label=\"Selected incident inspector\" class=\"rounded-[10px] border border-[#29465C] bg-[#0E1D2C]\" data-kid=\"1-2-3-3\">\n                <div class=\"border-b border-[#29465C] px-5 py-4\" data-kid=\"1-2-3-3-1\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[.14em] text-[#FF9BA0]\" data-kid=\"1-2-3-3-1-1\">\n                        Selected incident\n                    </p>\n                    <div class=\"mt-1 flex items-center justify-between gap-3\" data-kid=\"1-2-3-3-1-2\">\n                        <h2 class=\"sy-mono text-base font-bold text-white\" data-kid=\"1-2-3-3-1-2-1\">\n                            INC-2026-001\n                        </h2>\n                        <span class=\"rounded-full bg-[#FF6870] px-2.5 py-1 text-[10px] font-extrabold text-[#08121D]\" data-kid=\"1-2-3-3-1-2-2\">\n                            CRITICAL\n                        </span>\n                    </div>\n                </div>\n                <div class=\"p-5\" data-kid=\"1-2-3-3-2\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-3-3-2-1\">\n                        <div class=\"grid h-11 w-11 place-items-center rounded-[10px] border border-[#FF6870]/40 bg-[#FF6870]/10 text-[#FF9BA0]\" data-kid=\"1-2-3-3-2-1-1\">\n                            <i class=\"h-5 w-5\" data-kid=\"1-2-3-3-2-1-1-1\" data-lucide=\"siren\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-2-3-3-2-1-2\">\n                          