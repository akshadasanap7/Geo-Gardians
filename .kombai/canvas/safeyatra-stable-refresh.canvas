2-18-1-2\">\n                                Safe\n                            </span>\n                        </div>\n                        <div class=\"mt-2 flex items-center gap-2\" data-kid=\"1-2-3-2-2-18-2\">\n                            <span class=\"marker-caution static h-2 w-2 border-0 shadow-none\" data-kid=\"1-2-3-2-2-18-2-1\">\n                            </span>\n                            <span class=\"text-slate-300\" data-kid=\"1-2-3-2-2-18-2-2\">\n                                Caution\n                            </span>\n                        </div>\n                        <div class=\"mt-2 flex items-center gap-2\" data-kid=\"1-2-3-2-2-18-3\">\n                            <span class=\"marker-critical static h-2 w-2 border-0 shadow-none\" data-kid=\"1-2-3-2-2-18-3-1\">\n                            </span>\n                            <span class=\"text-slate-300\" data-kid=\"1-2-3-2-2-18-3-2\">\n                                Critical incident\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"map-error mx-5 mb-5 rounded-[8px] border border-[#E7B84B]/35 bg-[#E7B84B]/10 px-4 py-3\" data-kid=\"1-2-3-2-3\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"1-2-3-2-3-1\">\n                        <i class=\"mt-0.5 h-4 w-4 shrink-0 text-[#E7B84B]\" data-kid=\"1-2-3-2-3-1-1\" data-lucide=\"triangle-alert\">\n                        </i>\n                        <div data-kid=\"1-2-3-2-3-1-2\">\n                            <p class=\"text-xs font-bold text-[#F7D982]\" data-kid=\"1-2-3-2-3-1-2-1\">\n                                Map rendering fallback is ready\n                            </p>\n                            <p class=\"mt-1 text-xs leading-5 text-[#D9BA68]\" data-kid=\"1-2-3-2-3-1-2-2\">\n                                If the tile provider fails, keep the last cached positions visible and expose a retry action 