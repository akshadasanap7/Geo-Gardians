         </div>\n                        <div class=\"flex items-center justify-between gap-3 py-3\" data-kid=\"1-2-3-3-2-3-4\">\n                            <span class=\"text-xs text-slate-400\" data-kid=\"1-2-3-3-2-3-4-1\">\n                                Responder\n                            </span>\n                            <span class=\"text-xs font-bold text-white\" data-kid=\"1-2-3-3-2-3-4-2\">\n                                Unit Alpha-07\n                            </span>\n                        </div>\n                        <div class=\"flex items-center justify-between gap-3 py-3\" data-kid=\"1-2-3-3-2-3-5\">\n                            <span class=\"text-xs text-slate-400\" data-kid=\"1-2-3-3-2-3-5-1\">\n                                Digital ID\n                            </span>\n                            <span class=\"flex items-center gap-1.5 text-xs font-bold text-[#1BD1A5]\" data-kid=\"1-2-3-3-2-3-5-2\">\n                                <i class=\"h-4 w-4\" data-kid=\"1-2-3-3-2-3-5-2-1\" data-lucide=\"badge-check\">\n                                </i>\n                                Verified\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"mt-5\" data-kid=\"1-2-3-3-2-4\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[.14em] text-slate-400\" data-kid=\"1-2-3-3-2-4-1\">\n                            Operator actions\n                        </p>\n                        <div class=\"mt-3 space-y-2\" data-kid=\"1-2-3-3-2-4-2\">\n                            <button class=\"flex min-h-11 w-full items-center justify-between rounded-[8px] border border-[#29465C] px-3 text-xs font-bold text-slate-200 hover:border-[#5AA7FF] hover:bg-[#152A3D]\" data-feedback=\"Incident acknowledged\" data-kid=\"1-2-3-3-2-4-2-1\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-2-3-3-2-4-2-1-1\">\n                                    <i class=\"h-4 w-4 text-[#5AA7FF]\" data-kid=\"1-2-3-3-2-4-2-1-1-1\" data-lucide=\"clipboard-check\">\n                                    </i>\n                                    Acknowledge\n                                </span>\n                                <i class=\"h-4 w-4\" data-kid=\"1-2-3-3-2-4-2-1-2\" data-lucide=\"arrow-right\">\n                                </i>\n                            </button>\n                            <button class=\"flex min-h-11 w-full items-center justify-between rounded-[8px] border border-[#5AA7FF]/50 bg-[#5AA7FF]/10 px-3 text-xs font-bold text-[#B8D7FF] hover:bg-[#5AA7FF]/20\" data-feedback=\"Unit Alpha-07 assigned\" data-kid=\"1-2-3-3-2-4-2-2\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-2-3-3-2-4-2-2-1\">\n                                    <i class=\"h-4 w-4\" data-kid=\"1-2-3-3-2-4-2-2-1-1\" data-lucide=\"users\">\n                                    </i>\n                                    Assign Unit Alpha-07\n                                </span>\n                                <i class=\"h-4 w-4\" data-kid=\"1-2-3-3-2-4-2-2-2\" data-lucide=\"arrow-right\">\n                                </i>\n                            </button>\n                            <button class=\"flex min-h-11 w-full items-center justify-between rounded-[8px] border border-[#1BD1A5]/40 px-3 text-xs font-bold text-[#80E8CD] hover:bg-[#1BD1A5]/10\" data-feedback=\"Incident marked resolved\" data-kid=\"1-2-3-3-2-4-2-3\">\n                                <span class=\"flex items-center gap-2\" data-kid=\"1-2-3-3-2-4-2-3-1\">\n                                    <i class=\"h-4 w-4\" data-kid=\"1-2-3-3-2-4-2-3-1-1\" data-lucide=\"check-circle-2\">\n                                    </i>\n                                    Resolve incident\n                                </span>\n                                <i class=\"h-4 w-4\" data-kid=\"1-2-3-3-2-4-2-3-2\" data-lucide=\"arrow-right\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                    <p class=\"mt-5 text-xs leading-5 text-slate-500\" data-kid=\"1-2-3-3-2-5\">\n                        Every action is written to the incident timeline and can be replayed in the demo walkthrough.\n                    </p>\n                </div>\n            </aside>\n        </section>\n    </main>\n    <script src=\"https://unpkg.com/lucide@latest\">\n    </script>\n    <script>\n        lucide.createIcons();\n    document.querySelectorAll('[data-feedback]').forEach((button) => button.addEventListener('click', () => {\n      const target = document.getElementById('feedback');\n      if (target) { target.textContent = button.dataset.feedback; target.className = 'min-h-10 rounded-[10px] border border-[#1BD1A5]/30 bg-[#1BD1A5]/10 px-3 py-2.5 text-xs text-[#80E8CD]'; }\n    }));\n    </script>\n</div>\n",
