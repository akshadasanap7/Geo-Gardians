                     3 packets · Sync worker\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-4-3-3-4\" data-name=\"audit event item\" style=\"padding:13px 0;\">\n                        <div data-kid=\"1-2-4-3-3-4-1\" data-name=\"event header\" style=\"display:flex;justify-content:space-between;gap:10px;\">\n                            <span data-kid=\"1-2-4-3-3-4-1-1\" data-name=\"event title\" style=\"font-size:12px;font-weight:800;\">\n                                Danger zone updated\n                            </span>\n                            <span class=\"mono\" data-kid=\"1-2-4-3-3-4-1-2\" data-name=\"event time\" style=\"font-size:10px;color:#6E879A;\">\n                                08:19\n                            </span>\n                        </div>\n                        <div data-kid=\"1-2-4-3-3-4-2\" data-name=\"event description\" style=\"font-size:12px;color:#9FB2C0;line-height:1.5;margin-top:5px;\">\n                            Gangapur Dam · Admin policy\n                        </div>\n                    </div>\n                </div>\n                <button class=\"ghost\" data-kid=\"1-2-4-3-4\" data-name=\"view all events button\" id=\"view-audit\" style=\"width:100%;margin-top:7px;\">\n                    View all audit events\n                    <i data-kid=\"1-2-4-3-4-1\" data-lucide=\"arrow-right\" data-name=\"arrow icon\" style=\"width:14px;height:14px;vertical-align:-3px;margin-left:6px;\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <section class=\"layout\" data-kid=\"1-2-5\" data-name=\"role and danger zone section\" style=\"display:grid;grid-template-columns:1.3fr .7fr;gap:14px;margin-top:14px;\">\n            <div class=\"surface\" data-kid=\"1-2-5-1\" data-name=\"access boundaries widget\" style=\"padding:18px;\">\n                <div data-kid=\"1-2-5-1-1\" data-name=\"widget header group\" style=\"display:flex;align-items:flex-start;justify-content:space-between;gap:12px;\">\n                    <div data-kid=\"1-2-5-1-1-1\" data-name=\"widget title group\">\n                        <div class=\"label\" data-kid=\"1-2-5-1-1-1-1\" data-name=\"widget label\">\n                            Role permissions\n                        </div>\n                        <h2 data-kid=\"1-2-5-1-1-1-2\" data-name=\"widget title\" style=\"font-size:16px;margin:7px 0 0;\">\n                            Access boundaries\n                        </h2>\n                    </div>\n                    <button class=\"ghost\" data-kid=\"1-2-5-1-1-2\" data-name=\"manage roles button\" id=\"manage-roles\">\n                        Manage roles\n                    </button>\n                </div>\n                <div data-kid=\"1-2-5-1-2\" data-name=\"permissions table container\" style=\"overflow:auto;margin-top:16px;\">\n                    <table data-kid=\"1-2-5-1-2-1\" data-name=\"permissions table\" style=\"width:100%;border-collapse:collapse;min-width:520px;font-size:12px;\">\n                        <thead data-kid=\"1-2-5-1-2-1-1\" data-name=\"table header\">\n                            <tr data-kid=\"1-2-5-1-2-1-1-1\" data-name=\"table header row\" style=\"text-align:left;color:#8AA0B2;font-size:10px;text-transform:uppercase;letter-spacing:.11em;\">\n                                <th data-kid=\"1-2-5-1-2-1-1-1-1\" data-name=\"role column header\" style=\"padding:10px 10px 10px 0;font-weight:800;\">\n                                    Role\n                                </th>\n                                <th data-kid=\"1-2-5-1-2-1-1-1-2\" data-name=\"people column header\" style=\"padding:10px;font-weight:800;\">\n                                    People\n                                </th>\n                                <th data-kid=\"1-2-5-1-2-1-1-1-3\" data-name=\"location column header\" style=\"padding:10px;font-weight:800;\">\n                                    Live location\n                                </th>\n                                <th data-kid=\"1-2-5-1-2-1-1-1-4\" data-name=\"incident column header\" style=\"padding:10px;font-weight:800;\">\n                                    Incident actions\n                                </th>\n                                <th data-kid=\"1-2-5-1-2-1-1-1-5\" data-name=\"policy column header\" style=\"padding:10px;font-weight:800;\">\n                                    Policy\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-kid=\"1-2-5-1-2-1-2\" data-name=\"table body\">\n                            <tr data-kid=\"1-2-5-1-2-1-2-1\" data-name=\"tourist role row\" style=\"border-top:1px solid #29465C;\">\n                                <td data-kid=\"1-2-5-1-2-1-2-1-1\" data-name=\"role name\" style=\"padding:13px 10px 13px 0;font-weight:800;\">\n                                    Tourist\n                                </td>\n                                <td class=\"mono\" data-kid=\"1-2-5-1-2-1-2-1-2\" data-name=\"people count\" style=\"padding:13px 10px;color:#B9CBD6;\">\n                                    1,250\n                                </td>\n                                <td data-kid=\"1-2-5-1-2-1-2-1-3\" data-name=\"location permission\" style=\"padding:13px 10px;color:#80E8CD;\">\n                                    Own only\n                                </td>\n                                <td data-kid=\"1-2-5-1-2-1-2-1-4\" data-name=\"incident action permission\" style=\"padding:13px 10px;color:#E7B84B;\">\n                                    Create SOS\n                                </td>\n                                <td data-kid=\"1-2-5-1-2-1-2-1-5\" data-name=\"policy permission\" style=\"padding:13px 10px;color:#8FA4B4;\">\n                                    View\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-5-1-2-1-2-2\" data-name=\"authority role row\" style=\"border-top:1px solid #29465C;\">\n                                <td data-kid=\"1-2-5-1-2-1-2-2-1\" data-name=\"role name\" style=\"padding:13px 10px 13px 0;font-weight:800;\">\n                                    Authority\n                                </td>\n                                <td class=\"mono\" data-kid=\"1-2-5-1-2-1-2-2-2\" data-name=\"people count\" style=\"padding:13px 10px;color:#B9CBD6;\">\n                                    12\n                                </td>\n                                <td data-kid=\"1-2-5-1-2-1-2-2-3\" data-name=\"location permission\" style=\"padding:13px 10px;color:#80E8CD;\">\n                                    District\n                                </td>\n                                <td data-kid=\"1-2-5-1-2-1-2-2-4\" data-name=\"incident action permission\" style=\"padding:13px 10px;color:#80E8CD;\">\n                                    Acknowledge / assign\n                                </td>\n                                <td data-kid=\"1-2-5-1-2-1-2-2-5\" data-name=\"policy permission\" style=\"padding:13px 10px;color:#80E8CD;\">\n                                    Edit\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-5-1-2-1-2-3\" data-name=\"responder role row\" style=\"border-top:1px solid #29465C;\">\n                                <td data-kid=\"1-2-5-1-2-1-2-3-1\" data-name=\"role name\" style=\"padding:13px 10px 13px 0;font-weight:800;\">\n                                    Responder\n                                </td>\n                                <td class=\"mono\" data-kid=\"1-2-5-1-2-1-2-3-2\" data-name=\"people count\" style=\"padding:13px 10px;color:#B9CBD6;\">\n                                    08\n                                </td>\n                                <td data-kid=\"1-2-5-1-2-1-2-3-3\" data-name=\"location permission\" style=\"padding:13px 10px;color:#80E8CD;\">\n                                    Assigned\n                                </td>\n                                <td data-kid=\"1-2-5-1-2-1-2-3-4\" data-name=\"incident action permission\" style=\"padding:13px 10px;color:#80E8CD;\">\n                                    Update / resolve\n                                </td>\n                                <td data-kid=\"1-2-5-1-2-1-2-3-5\" data-name=\"policy permission\" style=\"padding:13px 10px;color:#8FA4B4;\">\n                                    View\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-5-1-2-1-2-4\" data-name=\"admin role row\" style=\"border-top:1px solid #29465C;\">\n                                <td data-kid=\"1-2-5-1-2-1-2-4-1\" data-name=\"role name\" style=\"padding:13px 10px 13px 0;font-weight:800;\">\n                                    Admin\n                                </td>\n                                <td class=\"mono\" data-kid=\"1-2-5-1-2-1-2-4-2\" data-name=\"people count\" style=\"padding:13px 10px;color:#B9CBD6;\">\n                                    01\n                                </td>\n                                <td data-kid=\"1-2-5-1-2-1-2-4-3\" data-name=\"location permission\" style=\"padding:13px 10px;color:#80E8CD;\">\n                                    All\n                                </td>\n                                <td data-kid=\"1-2-5-1-2-1-2-4-4\" data-name=\"incident action permission\" style=\"padding:13px 10px;color:#80E8CD;\">\n                                    Override\n                                </td>\n                                <td data-kid=\"1-2-5-1-2-1-2-4-5\" data-name=\"policy permission\" style=\"padding:13px 10px;color:#80E8CD;\">\n                                    Manage\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n            <div class=\"surface\" data-kid=\"1-2-5-2\" data-name=\"danger zone policy widget\" style=\"padding:18px;\">\n                <div class=\"label\" data-kid=\"1-2-5-2-1\" data-name=\"widget label\">\n                    Danger-zone policy\n                </div>\n                <h2 data-kid=\"1-2-5-2-2\" data-name=\"widget title\" style=\"font-size:16px;margin:7px 0 0;\">\n                    Boundary changes\n                </h2>\n                <div data-kid=\"1-2-5-2-3\" data-name=\"policy change log\" style=\"margin-top:15px;display:grid;gap:10px;\">\n                    <div class=\"surface-soft\" data-kid=\"1-2-5-2-3-1\" data-name=\"log item\" style=\"padding:12px;display:flex;align-items:flex-start;gap:10px;\">\n                        <i data-kid=\"1-2-5-2-3-1-1\" data-lucide=\"map-pin\" data-name=\"map pin icon\" style=\"width:16px;height:16px;color:#FF6870;flex:none;margin-top:2px;\">\n                        </i>\n                        <div data-kid=\"1-2-5-2-3-1-2\" data-name=\"item text group\">\n                            <div data-kid=\"1-2-5-2-3-1-2-1\" data-name=\"item title\" style=\"font-size:12px;font-weight:800;\">\n                                Gangapur Dam Service Road\n                            </div>\n                            <div class=\"label\" data-kid=\"1-2-5-2-3-1-2-2\" data-name=\"item label\" style=\"margin-top:4px;\">\n                                Danger · radius 1.2 km\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"surface-soft\" data-kid=\"1-2-5-2-3-2\" data-name=\"log item\" style=\"padding:12px;display:flex;align-items:flex-start;gap:10px;\">\n                        <i data-kid=\"1-2-5-2-3-2-1\" data-lucide=\"clock-3\" data-name=\"clock icon\" style=\"width:16px;height:16px;color:#E7B84B;flex:none;margin-top:2px;\">\n                        </i>\n                        <div data-kid=\"1-2-5-2-3-2-2\" data-name=\"item text group\">\n                            <div data-kid=\"1-2-5-2-3-2-2-1\" data-name=\"item title\" style=\"font-size:12px;font-weight:800;\">\n                                Review due in 4 hours\n                            </div>\n                            <div data-kid=\"1-2-5-2-3-2-2-2\" data-name=\"item label\" style=\"font-size:12px;color:#9FB2C0;margin-top:4px;\">\n                                Last changed by System Administrator\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <button class=\"coral-btn\" data-kid=\"1-2-5-2-4\" data-name=\"review zone button\" id=\"review-zone\" style=\"width:100%;margin-top:14px;\">\n                    Review incident policy\n                </button>\n            </div>\n        </section>\n        <section class=\"surface\" data-kid=\"1-2-6\" data-name=\"offline mode notification bar\" style=\"padding:14px 16px;margin-top:14px;display:flex;align-items:center;justify-content:space-between;gap:16px;background:#0B1825;\">\n            <div data-kid=\"1-2-6-1\" data-name=\"notification info group\" style=\"display:flex;gap:10px;align-items:center;\">\n                <i data-kid=\"1-2-6-1-1\" data-lucide=\"wifi-off\" data-name=\"wifi off icon\" style=\"width:16px;height:16px;color:#E7B84B;\">\n                </i>\n                <div data-kid=\"1-2-6-1-2\" data-name=\"notification text\" style=\"font-size:12px;color:#B9CBD6;\">\n                    <strong data-kid=\"1-2-6-1-2-1\" data-name=\"notification emphasis text\" style=\"color:#EDF5F8;\">\n                        Backend unavailable state:\n                    </strong>\n                    policy edits stay local and will reconcile when the network returns.\n                </div>\n            </div>\n            <button class=\"ghost\" data-kid=\"1-2-6-2\" data-name=\"test local fallback button\" id=\"test-local\">\n                Test local fallback\n            </button>\n        </section>\n    </main>\n    <div class=\"feedback hidden\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"global feedback notification area\" data-reason=\"text content updated dynamically by notification script\" id=\"feedback\" role=\"status\">\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n  const feedback=document.getElementById('feedback');\n  let timer;\n  function notify(message){ feedback.textContent=message; feedback.classList.remove('hidden'); clearTimeout(timer); timer=setTimeout(()=>feedback.classList.add('hidden'),4200); }\n  document.getElementById('retry-sync').addEventListener('click',()=>notify('Sync retry queued locally · 3 packets remain protected for reconciliation.'));\n  document.getElementById('retry-banner').addEventListener('click',()=>notify('Sync worker retry started · next health check in 30 seconds.'));\n  document.getElementById('review-policy').addEventListener('click',()=>notify('Incident policy opened · threshold is currently 80% for auto-escalation.'));\n  document.getElementById('policy-chart').addEventListener('click',()=>notify('Policy review queued · no threshold changes applied.'));\n  document.getElementById('review-zone').addEventListener('click',()=>notify('Danger-zone policy review opened · Gangapur Dam radius is 1.2 km.'));\n  document.getElementById('export-audit').addEventListener('click',()=>notify('Audit export prepared · 2,438 events available as CSV.'));\n  document.getElementById('view-audit').addEventListener('click',()=>notify('Showing the full audit trail in the production view.'));\n  document.getElementById('manage-roles').addEventListener('click',()=>notify('Role management opened · changes require admin confirmation.'));\n  document.getElementById('test-local').addEventListener('click',()=>notify('Local fallback healthy · queued policy edits are safe offline.'));\n</script>\n",
