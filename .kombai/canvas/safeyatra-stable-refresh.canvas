    },
    "var_a762c1d14878": {
      "type": "variant",
      "label": "Admin Control Plane · Field Compact",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 7375,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap');\n  .admin-field { font-family: Inter, ui-sans-serif, system-ui, sans-serif; background:#08121D; color:#EDF5F8; min-height:100vh; }\n  .admin-field * { box-sizing:border-box; }\n  .admin-field .mono { font-family:'JetBrains Mono', ui-monospace, monospace; }\n  .admin-field .label { font-size:10px; line-height:1.3; letter-spacing:.14em; text-transform:uppercase; font-weight:800; color:#8EA6B5; }\n  .admin-field .muted { color:#9BAEBA; }\n  .admin-field .panel { border:1px solid #29465C; background:#0E1D2C; border-radius:10px; }\n  .admin-field button, .admin-field input { font:inherit; }\n  .admin-field button { cursor:pointer; }\n  .admin-field .chart-line { stroke-dasharray:240; stroke-dashoffset:0; animation:draw 1.2s ease-out both; }\n  @keyframes draw { from { stroke-dashoffset:240; } to { stroke-dashoffset:0; } }\n  @media (prefers-reduced-motion:reduce) { .admin-field .chart-line { animation:none; } }\n</style>\n<div class=\"admin-field\" data-kid=\"1\">\n    <header data-kid=\"1-1\" style=\"position:sticky;top:0;z-index:10;border-bottom:1px solid #29465C;background:rgba(8,18,29,.96);backdrop-filter:blur(10px);padding:14px 16px 12px;\">\n        <div data-kid=\"1-1-1\" style=\"display:flex;align-items:center;justify-content:space-between;gap:12px;\">\n            <div data-kid=\"1-1-1-1\" style=\"display:flex;align-items:center;gap:10px;min-width:0;\">\n                <div data-kid=\"1-1-1-1-1\" style=\"width:34px;height:34px;border:1px solid rgba(27,209,165,.5);border-radius:9px;display:grid;place-items:center;color:#1BD1A5;background:rgba(27,209,165,.1);\">\n                    <i data-kid=\"1-1-1-1-1-1\" data-lucide=\"shield-check\" style=\"width:18px;height:18px;\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\" style=\"min-width:0;\">\n                    <div data-kid=\"1-1-1-1-2-1\" style=\"font-size:14px;font-weight:800;white-space:nowrap;\">\n                        SafeYatra\n                        <span data-kid=\"1-1-1-1-2-1-1\" style=\"color:#1BD1A5;\">\n                            AI\n                        </span>\n                    </div>\n                    <div class=\"label\" data-kid=\"1-1-1-1-2-2\" style=\"font-size:9px;margin-top:2px;\">\n                        Admin control plane\n                    </div>\n                </div>\n            </div>\n            <div data-kid=\"1-1-1-2\" style=\"display:flex;align-items:center;gap:8px;\">\n                <span data-kid=\"1-1-1-2-1\" data-name=\"queued status indicator\" style=\"display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(231,184,75,.42);background:rgba(231,184,75,.09);border-radius:999px;padding:7px 9px;color:#F2CE76;font-size:10px;font-weight:800;\">\n                    <span data-kid=\"1-1-1-2-1-1\" style=\"width:7px;height:7px;border-radius:50%;background:#E7B84B;\">\n                    </span>\n                    3 queued\n                </span>\n                <button aria-label=\"Open admin menu\" data-kid=\"1-1-1-2-2\" data-name=\"admin menu toggle button\" id=\"admin-menu\" style=\"width:42px;height:42px;border:1px solid #29465C;border-radius:9px;background:#152A3D;color:#C9D7DE;display:grid;place-items:center;\">\n                    <i data-kid=\"1-1-1-2-2-1\" data-lucide=\"menu\" style=\"width:18px;height:18px;\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <div data-dynamic=\"true\" data-kid=\"1-1-2\" data-name=\"menu instruction note\" data-reason=\"visibility toggled by menu click\" id=\"menu-note\" style=\"display:none;margin-top:10px;border:1px solid #29465C;border-radius:8px;padding:10px 12px;color:#B8C9D2;background:#0E1D2C;font-size:12px;\">\n            Admin navigation is available in the full shell. This compact view keeps high-signal controls in one scroll.\n        </div>\n    </header>\n    <main data-kid=\"1-2\" style=\"padding:18px 16px 40px;max-width:720px;margin:0 auto;\">\n        <div data-kid=\"1-2-1\" style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:16px;\">\n            <div data-kid=\"1-2-1-1\">\n                <div class=\"label\" data-dynamic=\"true\" data-kid=\"1-2-1-1-1\" data-name=\"system status header\" data-reason=\"timestamp updated by system\" style=\"color:#5AA7FF;\">\n                    System overview · 08:42 UTC\n                </div>\n                <h1 data-kid=\"1-2-1-1-2\" style=\"font-size:25px;line-height:1.14;letter-spacing:-.03em;margin:7px 0 0;font-weight:800;\">\n                    Keep the safety network ready.\n                </h1>\n            </div>\n            <div data-kid=\"1-2-1-2\" style=\"width:36px;height:36px;border-radius:50%;background:#152A3D;border:1px solid #29465C;display:grid;place-items:center;font-size:11px;font-weight:800;color:#1BD1A5;flex:0 0 auto;\">\n                SA\n            </div>\n        </div>\n        <section class=\"panel\" data-kid=\"1-2-2\" style=\"padding:12px 13px;margin-bottom:14px;border-color:rgba(231,184,75,.45);background:rgba(231,184,75,.07);display:flex;align-items:flex-start;gap:10px;\">\n            <i data-kid=\"1-2-2-1\" data-lucide=\"cloud-off\" style=\"width:18px;height:18px;color:#E7B84B;flex:0 0 auto;margin-top:1px;\">\n            </i>\n            <div data-kid=\"1-2-2-2\" style=\"flex:1;min-width:0;\">\n                <div data-kid=\"1-2-2-2-1\" style=\"font-size:12px;font-weight:800;color:#F5D889;\">\n                    Offline queue waiting\n                </div>\n                <div data-kid=\"1-2-2-2-2\" style=\"font-size:12px;line-height:1.45;color:#C3B481;margin-top:3px;\">\n                    3 packets will reconcile automatically when the network returns.\n                </div>\n            </div>\n            <button data-dynamic=\"true\" data-kid=\"1-2-2-3\" data-name=\"retry sync button\" data-reason=\"text and disabled state changed by click script\" id=\"retry-sync\" style=\"min-height:44px;padding:0 12px;border:1px solid rgba(27,209,165,.5);border-radius:8px;background:#1BD1A5;color:#08121D;font-size:11px;font-weight:800;white-space:nowrap;\">\n                Retry sync\n            </button>\n        </section>\n        <div data-dynamic=\"true\" data-kid=\"1-2-3\" data-name=\"sync status message box\" data-reason=\"content and visibility toggled by script\" id=\"sync-status\" style=\"display:none;margin:-4px 0 14px;padding:9px 11px;border:1px solid rgba(27,209,165,.35);border-radius:8px;background:rgba(27,209,165,.08);font-size:12px;color:#8DE8D0;\">\n        </div>\n        <section data-kid=\"1-2-4\" style=\"display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:16px;\">\n            <div class=\"panel\" data-kid=\"1-2-4-1\" style=\"padding:13px 12px;border-left:3px solid #1BD1A5;\">\n                <div class=\"label\" data-kid=\"1-2-4-1-1\">\n                    Active tourists\n                </div>\n                <div class=\"mono\" data-dynamic=\"true\" data-kid=\"1-2-4-1-2\" data-name=\"active tourists count\" data-reason=\"number updated by data feed\" style=\"font-size:22px;font-weight:700;margin-top:7px;\">\n                    1,250\n                </div>\n                <div class=\"muted\" data-kid=\"1-2-4-1-3\" style=\"font-size:11px;margin-top:4px;\">\n                    12 zones\n                </div>\n            </div>\n            <div class=\"panel\" data-kid=\"1-2-4-2\" style=\"padding:13px 12px;border-left:3px solid #FF6870;\">\n                <div class=\"label\" data-kid=\"1-2-4-2-1\">\n                    Open emergencies\n                </div>\n                <div class=\"mono\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2\" data-name=\"open emergencies count\" data-reason=\"number updated by data feed\" style=\"font-size:22px;font-weight:700;margin-top:7px;color:#FF8C92;\">\n                    4\n                </div>\n                <div class=\"muted\" data-kid=\"1-2-4-2-3\" style=\"font-size:11px;margin-top:4px;\">\n                    3 critical now\n                </div>\n            </div>\n            <div class=\"panel\" data-kid=\"1-2-4-3\" style=\"padding:13px 12px;border-left:3px solid #E7B84B;\">\n                <div class=\"label\" data-kid=\"1-2-4-3-1\">\n                    Critical risk\n                </div>\n                <div class=\"mono\" data-dynamic=\"true\" data-kid=\"1-2-4-3-2\" data-name=\"critical risk count\" data-reason=\"number updated by data feed\" style=\"font-size:22px;font-weight:700;margin-top:7px;color:#F2CE76;\">\n                    12\n                </div>\n                <div class=\"muted\" data-kid=\"1-2-4-3-3\" style=\"font-size:11px;margin-top:4px;\">\n                    Escalation threshold\n                </div>\n            </div>\n            <div class=\"panel\" data-kid=\"1-2-4-4\" style=\"padding:13px 12px;border-left:3px solid #5AA7FF;\">\n                <div class=\"label\" data-kid=\"1-2-4-4-1\">\n                    Resolution rate\n                </div>\n                <div class=\"mono\" data-dynamic=\"true\" data-kid=\"1-2-4-4-2\" data-name=\"resolution rate percentage\" data-reason=\"value updated by data feed\" style=\"font-size:22px;font-weight:700;margin-top:7px;color:#7DBAFF;\">\n                    94.2%\n                </div>\n                <div class=\"muted\" data-kid=\"1-2-4-4-3\" style=\"font-size:11px;margin-top:4px;\">\n                    Last 30 days\n                </div>\n            </div>\n        </section>\n        <section class=\"panel\" data-kid=\"1-2-5\" style=\"padding:14px 14px 13px;margin-bottom:14px;\">\n            <div data-kid=\"1-2-5-1\" style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:8px;\">\n                <div data-kid=\"1-2-5-1-1\">\n                    <div class=\"label\" data-kid=\"1-2-5-1-1-1\" style=\"color:#5AA7FF;\">\n                        Analytics\n                    </div>\n                    <h2 data-kid=\"1-2-5-1-1-2\" style=\"font-size:16px;margin:6px 0 0;font-weight:800;\">\n                        Critical risk trend\n                    </h2>\n                </div>\n                <span class=\"mono\" data-kid=\"1-2-5-1-2\" data-name=\"analytics timeframe label\" style=\"font-size:11px;color:#9DB2BF;\">\n                    24h\n                </span>\n            </div>\n            <div data-kid=\"1-2-5-2\" style=\"height:150px;margin-top:15px;border-bottom:1px solid #29465C;position:relative;overflow:hidden;\">\n                <div data-kid=\"1-2-5-2-1\" style=\"position:absolute;left:0;right:0;top:25%;border-top:1px dashed rgba(142,166,181,.22);\">\n                </div>\n                <div data-kid=\"1-2-5-2-2\" style=\"position:absolute;left:0;right:0;top:55%;border-top:1px dashed rgba(142,166,181,.22);\">\n                </div>\n                <div data-kid=\"1-2-5-2-3\" style=\"position:absolute;left:0;right:0;top:85%;border-top:1px dashed rgba(142,166,181,.22);\">\n                </div>\n                <svg data-kid=\"1-2-5-2-4\" data-name=\"critical risk trend svg chart\" preserveaspectratio=\"none\" style=\"width:100%;height:100%;display:block;\" viewbox=\"0 0 340 140\">\n                    <path class=\"chart-line\" d=\"M0 118 L30 110 L60 115 L90 98 L120 104 L150 87 L180 94 L210 78 L240 84 L270 51 L300 62 L340 25\" fill=\"none\" stroke=\"#FF6870\" stroke-width=\"3\">\n                    </path>\n                    <path d=\"M0 118 L30 110 L60 115 L90 98 L120 104 L150 87 L180 94 L210 78 L240 84 L270 51 L300 62 L340 25 L340 140 L0 140 Z\" fill=\"rgba(255,104,112,.1)\">\n                    </path>\n                    <circle cx=\"340\" cy=\"25\" fill=\"#FF6870\" r=\"5\" stroke=\"#08121D\" stroke-width=\"3\">\n                    </circle>\n                </svg>\n                <div data-dynamic=\"true\" data-kid=\"1-2-5-2-5\" data-name=\"current critical count indicator\" data-reason=\"value updated by analytics feed\" style=\"position:absolute;right:4px;top:7px;border:1px solid rgba(255,104,112,.45);background:#152A3D;color:#FF8C92;border-radius:6px;padding:5px 7px;font-size:10px;font-weight:800;\">\n                    12 critical\n                </div>\n            </div>\n            <div data-kid=\"1-2-5-3\" style=\"display:flex;justify-content:space-between;margin-top:8px;color:#8198A7;font-size:10px;\">\n                <span data-kid=\"1-2-5-3-1\">\n                    00:00\n                </span>\n                <span data-kid=\"1-2-5-3-2\">\n                    06:00\n                </span>\n                <span data-kid=\"1-2-5-3-3\">\n                    12:00\n                </span>\n                <span data-kid=\"1-2-5-3-4\">\n                    18:00\n                </span>\n                <span data-kid=\"1-2-5-3-5\">\n                    Now\n                </span>\n            </div>\n        </section>\n        <section class=\"panel\" data-kid=\"1-2-6\" style=\"padding:14px;margin-bottom:14px;\">\n            <div data-kid=\"1-2-6-1\" style=\"display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:12px;\">\n                <div data-kid=\"1-2-6-1-1\">\n                    <div class=\"label\" data-kid=\"1-2-6-1-1-1\" style=\"color:#1BD1A5;\">\n                        Service health\n                    </div>\n                    <h2 data-kid=\"1-2-6-1-1-2\" style=\"font-size:16px;margin:6px 0 0;font-weight:800;\">\n                        Core systems\n                    </h2>\n                </div>\n                <span data-dynamic=\"true\" data-kid=\"1-2-6-1-2\" data-name=\"service health status badge\" data-reason=\"value updated by system monitor\" style=\"display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:800;color:#80E8CD;\">\n                    <span data-kid=\"1-2-6-1-2-1\" style=\"width:7px;height:7px;border-radius:50%;background:#1BD1A5;\">\n                    </span>\n                    3 healthy\n                </span>\n            </div>\n            <div data-kid=\"1-2-6-2\" style=\"display:grid;gap:4px;\">\n                <div data-kid=\"1-2-6-2-1\" style=\"display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-top:1px solid rgba(41,70,92,.7);\">\n                    <div data-kid=\"1-2-6-2-1-1\" style=\"display:flex;align-items:center;gap:9px;\">\n                        <i data-kid=\"1-2-6-2-1-1-1\" data-lucide=\"server\" style=\"width:16px;height:16px;color:#5AA7FF;\">\n                        </i>\n                        <span data-kid=\"1-2-6-2-1-1-2\" style=\"font-size:12px;font-weight:700;\">\n                            API gateway\n                        </span>\n                    </div>\n                    <span class=\"mono\" data-dynamic=\"true\" data-kid=\"1-2-6-2-1-2\" data-name=\"api gateway health status\" data-reason=\"status updated by monitor\" style=\"font-size:11px;color:#80E8CD;\">\n                        99.98% · healthy\n                    </span>\n                </div>\n                <div data-kid=\"1-2-6-2-2\" style=\"display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-top:1px solid rgba(41,70,92,.7);\">\n                    <div data-kid=\"1-2-6-2-2-1\" style=\"display:flex;align-items:center;gap:9px;\">\n                        <i data-kid=\"1-2-6-2-2-1-1\" data-lucide=\"brain-circuit\" style=\"width:16px;height:16px;color:#1BD1A5;\">\n                        </i>\n                        <span data-kid=\"1-2-6-2-2-1-2\" style=\"font-size:12px;font-weight:700;\">\n                            AI risk engine\n                        </span>\n                    </div>\n                    <span class=\"mono\" data-dynamic=\"true\" data-kid=\"1-2-6-2-2-2\" data-name=\"ai engine health status\" data-reason=\"status updated by monitor\" style=\"font-size:11px;color:#80E8CD;\">\n                        99.4% · healthy\n                    </span>\n                </div>\n                <div data-kid=\"1-2-6-2-3\" style=\"display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-top:1px solid rgba(41,70,92,.7);\">\n                    <div data-kid=\"1-2-6-2-3-1\" style=\"display:flex;align-items:center;gap:9px;\">\n                        <i data-kid=\"1-2-6-2-3-1-1\" data-lucide=\"refresh-cw\" style=\"width:16px;height:16px;color:#E7B84B;\">\n                        </i>\n                        <span data-kid=\"1-2-6-2-3-1-2\" style=\"font-size:12px;font-weight:700;\">\n                            Sync worker\n                        </span>\n                    </div>\n                    <span class=\"mono\" data-dynamic=\"true\" data-kid=\"1-2-6-2-3-2\" data-name=\"sync worker health status\" data-reason=\"status updated by monitor\" style=\"font-size:11px;color:#F2CE76;\">\n                        97.8% · watch\n                    </span>\n                </div>\n                <div data-kid=\"1-2-6-2-4\" style=\"display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-top:1px solid rgba(41,70,92,.7);\">\n                    <div data-kid=\"1-2-6-2-4-1\" style=\"display:flex;align-items:center;gap:9px;\">\n                        <i data-kid=\"1-2-6-2-4-1-1\" data-lucide=\"fingerprint\" style=\"width:16px;height:16px;color:#1BD1A5;\">\n                        </i>\n                        <span data-kid=\"1-2-6-2-4-1-2\" style=\"font-size:12px;font-weight:700;\">\n                            Identity registry\n                        </span>\n                    </div>\n                    <span class=\"mono\" data-dynamic=\"true\" data-kid=\"1-2-6-2-4-2\" data-name=\"identity registry health status\" data-reason=\"status updated by monitor\" style=\"font-size:11px;