</div>\n                        </div>\n                    </div>\n                    <div class=\"sy-step active\" data-kid=\"1-2-3-3-4-4\" data-name=\"step 3\">\n                        <div class=\"sy-step-dot\" data-kid=\"1-2-3-3-4-4-1\" data-name=\"step 3 dot\">\n                            <i data-kid=\"1-2-3-3-4-4-1-1\" data-lucide=\"radio\" data-name=\"step 3 icon\" style=\"width:11px;height:11px\">\n                            </i>\n                        </div>\n                        <div data-kid=\"1-2-3-3-4-4-2\" data-name=\"step 3 content\">\n                            <div class=\"sy-step-title\" data-kid=\"1-2-3-3-4-4-2-1\" data-name=\"step 3 title\">\n                                Responder pending\n                                <span class=\"sy-step-time\" data-kid=\"1-2-3-3-4-4-2-1-1\" data-name=\"step 3 time\">\n                                    NOW\n                                </span>\n                            </div>\n                            <div class=\"sy-step-copy\" data-kid=\"1-2-3-3-4-4-2-2\" data-name=\"step 3 description\">\n                                Unit Alpha-07 will receive the queued SOS.\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"sy-inspector-actions\" data-kid=\"1-2-3-3-5\" data-name=\"inspector actions group\">\n                    <button class=\"sy-action critical\" data-action=\"sos\" data-kid=\"1-2-3-3-5-1\" data-name=\"confirm sos button\">\n                        <i data-kid=\"1-2-3-3-5-1-1\" data-lucide=\"siren\" data-name=\"siren icon\" style=\"width:15px;height:15px\">\n                        </i>\n                        Confirm SOS\n                    </button>\n                    <div class=\"sy-button-row\" data-kid=\"1-2-3-3-5-2\" data-name=\"secondary actions group\">\n                        <button class=\"sy-action\" data-action=\"id\" data-kid=\"1-2-3-3-5-2-1\" data-name=\"share id button\">\n                            <i data-kid=\"1-2-3-3-5-2-1-1\" data-lucide=\"qr-code\" data-name=\"qr code icon\" style=\"width:14px;height:14px\">\n                            </i>\n                            Share digital ID\n                        </button>\n                        <button class=\"sy-action ghost\" data-action=\"contact\" data-kid=\"1-2-3-3-5-2-2\" data-name=\"call contact button\">\n                            <i data-kid=\"1-2-3-3-5-2-2-1\" data-lucide=\"phone\" data-name=\"phone icon\" style=\"width:14px;height:14px\">\n                            </i>\n                            Call contact\n                        </button>\n                    </div>\n                </div>\n            </aside>\n        </section>\n        <section class=\"sy-bottom\" data-kid=\"1-2-4\" data-name=\"bottom section container\">\n            <div class=\"sy-sync\" data-kid=\"1-2-4-1\" data-name=\"sync status box\">\n                <div class=\"sy-sync-icon\" data-kid=\"1-2-4-1-1\" data-name=\"sync icon container\">\n                    <i data-kid=\"1-2-4-1-1-1\" data-lucide=\"cloud-off\" data-name=\"cloud off icon\" style=\"width:16px;height:16px\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-4-1-2\" data-name=\"sync text content\">\n                    <div class=\"sy-sync-title\" data-kid=\"1-2-4-1-2-1\" data-name=\"sync title\">\n                        Offline-first protection is active\n                    </div>\n                    <div class=\"sy-sync-copy\" data-kid=\"1-2-4-1-2-2\" data-name=\"sync description\">\n                        <strong data-kid=\"1-2-4-1-2-2-1\" data-name=\"sync emphasis\">\n                            3 packets waiting locally.\n                        </strong>\n                        GPS, risk analysis, geo-fencing and SOS remain available. Automatic sync starts when coverage returns.\n                    </div>\n                    <div class=\"sy-progress\" data-kid=\"1-2-4-1-2-3\" data-name=\"sync progress track\">\n                        <span data-kid=\"1-2-4-1-2-3-1\" data-name=\"sync progress bar\">\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"sy-contact\" data-kid=\"1-2-4-2\" data-name=\"emergency contact box\">\n                <div class=\"sy-contact-main\" data-kid=\"1-2-4-2-1\" data-name=\"contact main content\">\n                    <div class=\"sy-contact-icon\" data-kid=\"1-2-4-2-1-1\" data-name=\"contact icon container\">\n                        <i data-kid=\"1-2-4-2-1-1-1\" data-lucide=\"phone-call\" data-name=\"phone call icon\" style=\"width:15px;height:15px\">\n                        </i>\n                    </div>\n                    <div data-kid=\"1-2-4-2-1-2\" data-name=\"contact text content\">\n                        <div class=\"sy-contact-title\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"contact title\">\n                            Emergency contact ready\n                        </div>\n                        <div class=\"sy-contact-copy\" data-kid=\"1-2-4-2-1-2-2\" data-name=\"contact details\">\n                            Priya Mehta · +91 98•••• 4210\n                        </div>\n                    </div>\n                </div>\n                <button class=\"sy-contact-link\" data-action=\"contact\" data-kid=\"1-2-4-2-2\" data-name=\"contact link button\">\n                    Call now\n                </button>\n            </div>\n        </section>\n    </main>\n    <div class=\"sy-toast\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"notification toast container\" data-reason=\"visibility, icon, and content updated by notification script\" id=\"sy-toast\">\n        <button aria-label=\"Dismiss alert\" class=\"sy-toast-close\" data-kid=\"1-3-1\" data-name=\"dismiss toast button\" id=\"sy-toast-close\">\n            ×\n        </button>\n        <div class=\"sy-toast-top\" data-kid=\"1-3-2\" data-name=\"toast header area\">\n            <i data-dynamic=\"true\" data-kid=\"1-3-2-1\" data-lucide=\"bell-ring\" data-name=\"toast icon\" data-reason=\"icon replaced by script based on alert type\" style=\"width:14px;height:14px\">\n            </i>\n            High-risk alert\n        </div>\n        <div class=\"sy-toast-copy\" data-dynamic=\"true\" data-kid=\"1-3-3\" data-name=\"toast message text\" data-reason=\"text content replaced by notification script\">\n            Your warning reached the authority control room. Confirm SOS if you need immediate assistance.\n        </div>\n    </div>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();(function(){const toast=document.getElementById('sy-toast');const close=document.getElementById('sy-toast-close');const show=function(message,kind){toast.querySelector('.sy-toast-copy').textContent=message;toast.querySelector('.sy-toast-top').innerHTML='<i data-lucide=\"'+(kind==='good'?'check-circle-2':'bell-ring')+'\" style=\"width:14px;height:14px\"></i>'+(kind==='good'?'Action saved':'High-risk alert');lucide.createIcons();toast.classList.remove('sy-hidden');clearTimeout(window.syToastTimer);window.syToastTimer=setTimeout(function(){toast.classList.add('sy-hidden')},4800)};close.addEventListener('click',function(){toast.classList.add('sy-hidden')});document.querySelectorAll('[data-action]').forEach(function(button){button.addEventListener('click',function(){const action=button.dataset.action;if(action==='sos')show('SOS is staged locally and will be synced automatically when the network returns.','good');if(action==='id')show('Verified digital ID is ready to share with Unit Alpha-07.','good');if(action==='contact')show('Emergency contact channel opened for Priya Mehta.','good');if(action==='location')show('Location packet captured locally at 20.0059, 73.7897.','good');if(action==='center'||action==='map')show('Offline map cache is active; the last known location is centered.','good')})})})();\n</script>\n",
      "comments": [],
      "created": "2026-07-26T05:40:02.236089+00:00",
      "modified": "2026-07-26T05:41:16.390574+00:00",
