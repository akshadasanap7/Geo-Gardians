      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap');\n  .sy-font { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; }\n  .sy-mono { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace; }\n  .map-grid { background-image: linear-gradient(rgba(41,70,92,.18) 1px, transparent 1px), linear-gradient(90deg, rgba(41,70,92,.18) 1px, transparent 1px); background-size: 32px 32px; }\n  .map-road { position:absolute; height:2px; background:#49677b; transform-origin:left center; opacity:.72; }\n  .map-road:after { content:''; position:absolute; inset:-2px 0; border-top:1px dashed rgba(255,255,255,.2); }\n  .zone { position:absolute; border-radius:999px; border:1px solid; display:flex; align-items:flex-start; justify-content:center; padding-top:18px; text-transform:uppercase; letter-spacing:.12em; font-size:10px; font-weight:700; }\n  .marker { position:absolute; width:14px; height:14px; border-radius:999px; border:3px solid #0e1d2c; box-shadow:0 0 0 3px currentColor; }\n  .marker:after { content:''; position:absolute; inset:-8px; border:1px solid currentColor; border-radius:999px; opacity:.3; }\n  .marker-critical { color:#ff6870; background:#ff6870; }\n  .marker-safe { color:#1bd1a5; background:#1bd1a5; }\n  .marker-caution { color:#e7b84b; background:#e7b84b; }\n  .soft-scroll::-webkit-scrollbar { width:6px; }\n  .soft-scroll::-webkit-scrollbar-thumb { background:#29465c; border-radius:999px; }\n  .map-error { border-left:3px solid #e7b84b; }\n</style>\n<div class=\"sy-font min-h-screen bg-[#08121D] text-slate-100\" data-kid=\"1\">\n    <header class=\"border-b border-[#29465C] bg-[#0E1D2C]\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex min-h-[74px] max-w-[1520px] items-center justify-between gap-6 px-8\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-4\" data-kid=\"1-1-1-1\">\n                <div class=\"grid h-10 w-10 place-items-center rounded-[10px] border border-[#1BD1A5]/50 bg-[#1BD1A5]/10 text-[#1BD1A5]\" data-kid=\"1-1-1-1-1\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-1-1-1-1-1\" data-lucide=\"shield-check\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-1-2-1\">\n                        <span class=\"text-[15px] font-extrabold tracking-tight text-white\" data-kid=\"1-1-1-1-2-1-1\">\n                            SafeYatra\n                            <span class=\"text-[#1BD1A5]\" data-kid=\"1-1-1-1-2-1-1-1\">\n                                AI\n                            </span>\n                        </span>\n                        <span class=\"rounded-full border border-[#1BD1A5]/30 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[.14em] text-[#1BD1A5]\" data-kid=\"1-1-1-1-2-1-2\">\n                            Control room\n                        </span>\n                    </div>\n                    <p class=\"mt-1 text-xs text-slate-400\" data-kid=\"1-1-1-1-2-2\">\n                        Nashik district · live safety network\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-2\">\n                <div class=\"hidden items-center gap-3 rounded-[10px] border border-[#29465C] bg-[#08121D]/50 px-4 py-2.5 md:flex\" data-kid=\"1-1-1-2-1\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#1BD1A5] shadow-[0_0_0_4px_rgba(27,209,165,.12)]\" data-kid=\"1-1-1-2-1-1\">\n                    </span>\n                    <div data-kid=\"1-1-1-2-1-2\">\n                        <p class=\"text-xs font-bold text-white\" data-kid=\"1-1-1-2-1-2-1\">\n                            Network online\n                        </p>\n                        <p class=\"sy-mono text-[11px] text-slate-400\" data-dynamic=\"true\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"network last sync time text\" data-reason=\"text updated via script\">\n                            last sync 08:42:18 UTC\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-2 rounded-[10px] border border-[#E7B84B]/40 bg-[#E7B84B]/10 px-4 py-2.5\" data-kid=\"1-1-1-2-2\">\n                    <i class=\"h-4 w-4 text-[#E7B84B]\" data-kid=\"1-1-1-2-2-1\" data-lucide=\"cloud-off\">\n                    </i>\n                    <div data-kid=\"1-1-1-2-2-2\">\n                        <p class=\"text-xs font-bold text-[#F7D982]\" data-kid=\"1-1-1-2-2-2-1\">\n                            18 pending sync\n                        </p>\n                        <p class=\"text-[11px] text-[#D9BA68]\" data-kid=\"1-1-1-2-2-2-2\">\n                            offline devices\n                        </p>\n                    </div>\n                </div>\n                <button class=\"grid h-10 w-10 place-items-center rounded-[10px] border border-[#29465C] bg-[#152A3D] text-sm font-extrabold text-[#5AA7FF]\" data-feedback=\"Profile opened\" data-kid=\"1-1-1-2-3\">\n                    NC\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1520px] px-8 py-7\" data-kid=\"1-2\">\n        <div class=\"mb-7 flex items-end justify-between gap-6\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[.16em] text-[#5AA7FF]\" data-kid=\"1-2-1-1-1\">\n                    Authority command center / operational overview\n                </p>\n                <h1 class=\"mt-2 text-3xl font-extrabold tracking-tight text-white\" data-kid=\"1-2-1-1-2\">\n                    See the signal. Move the response.\n                </h1>\n                <p class=\"mt-2 max-w-2xl text-sm leading-6 text-slate-400\" data-kid=\"1-2-1-1-3\">\n                    A live operational picture of tourist risk, open incidents, response coverage, and network health.\n                </p>\n            </div>\n            <div class=\"hidden items-center gap-3 xl:flex\" data-kid=\"1-2-1-2\">\n                <span class=\"min-h-10 rounded-[10px] border border-transparent px-3 py-2.5 text-xs text-slate-400\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1\" data-name=\"interaction feedback notification text\" data-reason=\"text and styles updated via script on click\" id=\"feedback\">\n                </span>\n                <button class=\"inline-flex min-h-11 items-center gap-2 rounded-[10px] border border-[#29465C] px-4 text-xs font-bold text-slate-200 hover:border-[#5AA7FF] hover:text-white\" data-feedback=\"Broadcast notice queued\" data-kid=\"1-2-1-2-2\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-1-2-2-1\" data-lucide=\"megaphone\">\n                    </i>\n                    Broadcast safety notice\n                </button>\n            </div>\n        </div>\n        <section aria-label=\"Network summary\" class=\"grid grid-cols-5 gap-3\" data-kid=\"1-2-2\">\n            <div class=\"rounded-[10px] border border-[#29465C] bg-[#0E1D2C] p-4\" data-kid=\"1-2-2-1\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[.12em] text-slate-400\" data-kid=\"1-2-2-1-1\">\n                    Active tourists\n                </p>\n                <p class=\"sy-mono mt-3 text-2xl font-bold text-white\" data-kid=\"1-2-2-1-2\">\n                    1,250\n                </p>\n                <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-2-2-1-3\">\n                    Across 12 monitored zones\n                </p>\n            </div>\n            <div class=\"rounded-[10px] border border-[#FF6870]/40 bg-[#FF6870]/10 p-4\" data-kid=\"1-2-2-2\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[.12em] text-[#FF9BA0]\" data-kid=\"1-2-2-2-1\">\n                    Open emergencies\n                </p>\n                <p class=\"sy-mono mt-3 text-2xl font-bold text-white\" data-kid=\"1-2-2-2-2\">\n                    4\n                </p>\n                <p class=\"mt-1 text-xs text-[#FFB0B4]\" data-kid=\"1-2-2-2-3\">\n                    1 critical requiring action\n                </p>\n            </div>\n            <div class=\"rounded-[10px] border border-[#FF6870]/40 bg-[#0E1D2C] p-4\" data-kid=\"1-2-2-3\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[.12em] text-[#FF9BA0]\" data-kid=\"1-2-2-3-1\">\n                    Critical risk\n                </p>\n                <p class=\"sy-mono mt-3 text-2xl font-bold text-[#FF6870]\" data-kid=\"1-2-2-3-2\">\n                    12\n                </p>\n                <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-2-2-3-3\">\n                    Escalation threshold ≥ 80%\n                </p>\n            </div>\n            <div class=\"rounded-[10px] border border-[#E7B84B]/40 bg-[#0E1D2C] p-4\" data-kid=\"1-2-2-4\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[.12em] text-[#F7D982]\" data-kid=\"1-2-2-4-1\">\n                    High risk\n                </p>\n                <p class=\"sy-mono mt-3 text-2xl font-bold text-[#E7B84B]\" data-kid=\"1-2-2-4-2\">\n                    28\n                </p>\n                <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-2-2-4-3\">\n                    AI risk monitor active\n                </p>\n            </div>\n            <div class=\"rounded-[10px] border border-[#29465C] bg-[#0E1D2C] p-4\" data-kid=\"1-2-2-5\">\n                <p class=\"text-[11px] font-bold uppercase tracking-[.12em] text-slate-400\" data-kid=\"1-2-2-5-1\">\n                    Offline devices\n                </p>\n                <p class=\"sy-mono mt-3 text-2xl font-bold text-white\" data-kid=\"1-2-2-5-2\">\n                    18\n                </p>\n                <p class=\"mt-1 text-xs text-slate-500\" data-kid=\"1-2-2-5-3\">\n                    GPS packets cached locally\n                </p>\n            </div>\n        </section>\n        <section class=\"mt-4 grid grid-cols-[300px_minmax(0,1fr)_330px] gap-4\" data-kid=\"1-2-3\">\n            <aside aria-label=\"Incident queue\" class=\"flex min-h-[610px] flex-col rounded-[10px] border border-[#29465C] bg-[#0E1D2C]\" data-kid=\"1-2-3-1\">\n                <div class=\"flex items-start justify-between border-b border-[#29465C] px-5 py-4\" data-kid=\"1-2-3-1-1\">\n                    <div data-kid=\"1-2-3-1-1-1\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[.14em] text-[#5AA7FF]\" data-kid=\"1-2-3-1-1-1-1\">\n                            Response operations\n                        </p>\n                        <h2 class=\"mt-1 text-base font-bold text-white\" data-kid=\"1-2-3-1-1-1-2\">\n                            Incident queue\n                        </h2>\n                    </div>\n                    <span class=\"rounded-full bg-[#FF6870]/15 px-2.5 py-1 text-[11px] font-bold text-[#FF9BA0]\" data-kid=\"1-2-3-1-1-2\">\n                        4 open\n                    </span>\n                </div>\n                <div class=\"soft-scroll flex-1 space-y-2 overflow-y-auto p-3\" data-kid=\"1-2-3-1-2\">\n                    <button class=\"w-full rounded-[10px] border border-[#FF6870] bg-[#FF6870]/10 p-4 text-left\" data-feedback=\"INC-2026-001 selected\" data-kid=\"1-2-3-1-2-1\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-3-1-2-1-1\">\n                            <div data-kid=\"1-2-3-1-2-1-1-1\">\n                                <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-2-1-1-1-1\">\n                                    <span class=\"h-2 w-2 rounded-full bg-[#FF6870]\" data-kid=\"1-2-3-1-2-1-1-1-1-1\">\n                                    </span>\n                                    <span class=\"sy-mono text-[11px] font-bold text-white\" data-kid=\"1-2-3-1-2-1-1-1-1-2\">\n                                        INC-2026-001\n                                    </span>\n                                </div>\n                                <p class=\"mt-2 text-sm font-bold text-white\" data-kid=\"1-2-3-1-2-1-1-1-2\">\n                                    Aarav Mehta\n                                </p>\n                                <p class=\"mt-1 text-xs leading-5 text-slate-400\" data-kid=\"1-2-3-1-2-1-1-1-3\">\n                                    SOS + live GPS captured\n                                </p>\n                            </div>\n                            <span class=\"rounded-full bg-[#FF6870] px-2 py-1 text-[10px] font-extrabold text-[#08121D]\" data-kid=\"1-2-3-1-2-1-1-2\">\n                                CRITICAL\n                            </span>\n                        </div>\n                        <div class=\"mt-4 flex items-center justify-between border-t border-[#FF6870]/20 pt-3 text-[11px]\" data-kid=\"1-2-3-1-2-1-2\">\n                            <span class=\"text-slate-400\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"incident timestamp text\" data-reason=\"timestamp updated via script\">\n                                08:41:28 UTC\n                            </span>\n                            <span class=\"font-bold text-[#FF9BA0]\" data-kid=\"1-2-3-1-2-1-2-2\">\n                                94% risk\n                            </span>\n                        </div>\n                    </button>\n                    <button class=\"w-full rounded-[10px] border border-[#29465C] bg-[#152A3D] p-4 text-left hover:border-[#5AA7FF]/60\" data-feedback=\"INC-2026-004 selected\" data-kid=\"1-2-3-1-2-2\">\n                        <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-2-3-1-2-2-1\">\n                            <span class=\"sy-mono text-[11px] font-bold text-white\" data-kid=\"1-2-3-1-2-2-1-1\">\n                                INC-2026-004\n                            </span>\n                            <span class=\"rounded-full bg-[#E7B84B]/15 px-2 py-1 text-[10px] font-bold text-[#F7D982]\" data-kid=\"1-2-3-1-2-2-1-2\">\n                                HIGH\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-sm font-bold text-white\" data-kid=\"1-2-3-1-2-2-2\">\n                            Meera Kulkarni\n                        </p>\n                        <p class=\"mt-1 text-xs text-slate-400\" data-kid=\"1-2-3-1-2-2-3\">\n                            No movement · 25 minutes\n                        </p>\n                        <p class=\"mt-3 sy-mono text-[11px] text-slate-500\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-4\" data-name=\"incident timestamp text\" data-reason=\"timestamp updated via script\">\n                            08:39:12 UTC\n                        </p>\n                    </button>\n                    <button class=\"w-full rounded-[10px] border border-[#29465C] bg-[#152A3D] p-4 text-left hover:border-[#5AA7FF]/60\" data-feedback=\"INC-2026-002 selected\" data-kid=\"1-2-3-1-2-3\">\n                        <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-2-3-1-2-3-1\">\n                            <span class=\"sy-mono text-[11px] font-bold text-white\" data-kid=\"1-2-3-1-2-3-1-1\">\n                                INC-2026-002\n                            </span>\n                            <span class=\"rounded-full bg-[#E7B84B]/15 px-2 py-1 text-[10px] font-bold text-[#F7D982]\" data-kid=\"1-2-3-1-2-3-1-2\">\n                                HIGH\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-sm font-bold text-white\" data-kid=\"1-2-3-1-2-3-2\">\n                            Kabir Shah\n                        </p>\n                        <p class=\"mt-1 text-xs text-slate-400\" data-kid=\"1-2-3-1-2-3-3\">\n                            Danger zone boundary crossed\n                        </p>\n                        <p class=\"mt-3 sy-mono text-[11px] text-slate-500\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-3-4\" data-name=\"incident timestamp text\" data-reason=\"timestamp updated via script\">\n                            08:37:46 UTC\n                        </p>\n                    </button>\n                    <button class=\"w-full rounded-[10px] border border-[#29465C] bg-[#152A3D] p-4 text-left hover:border-[#5AA7FF]/60\" data-feedback=\"INC-2026-003 selected\" data-kid=\"1-2-3-1-2-4\">\n                        <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-2-3-1-2-4-1\">\n                            <span class=\"sy-mono text-[11px] font-bold text-white\" data-kid=\"1-2-3-1-2-4-1-1\">\n                                INC-2026-003\n                            </span>\n                            <span class=\"rounded-full bg-[#5AA7FF]/15 px-2 py-1 text-[10px] font-bold text-[#94C4FF]\" data-kid=\"1-2-3-1-2-4-1-2\">\n                                CAUTION\n                            </span>\n                        </div>\n                        <p class=\"mt-2 text-sm font-bold text-white\" data-kid=\"1-2-3-1-2-4-2\">\n                            Leah Thomas\n                        </p>\n                        <p class=\"mt-1 text-xs text-slate-400\" data-kid=\"1-2-3-1-2-4-3\">\n                            Weather model updated\n                        </p>\n                        <p class=\"mt-3 sy-mono text-[11px] text-slate-500\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-4-4\" data-name=\"incident timestamp text\" data-reason=\"timestamp updated via script\">\n                            08:35:02 UTC\n                        </p>\n                    </button>\n                    <details class=\"rounded-[10px] border border-dashed border-[#29465C] bg-[#08121D]/40 p-3\" data-kid=\"1-2-3-1-2-5\">\n                        <summary class=\"cursor-pointer text-xs font-bold text-slate-300\" data-kid=\"1-2-3-1-2-5-1\">\n                            Show empty queue state\n                        </summary>\n                        <div class=\"mt-3 border-t border-[#29465C] pt-3 text-xs leading-5 text-slate-500\" data-kid=\"1-2-3-1-2-5-2\">\n                            When no incidents match the active filter, show: “No incidents in this view. Try a wider filter or wait for the next safety signal.”\n                        </div>\n                    </details>\n                </div>\n                <div class=\"border-t border-[#29465C] px-5 py-4\" data-kid=\"1-2-3-1-3\">\n                    <div class=\"flex items-center justify-between text-xs\" data-kid=\"1-2-3-1-3-1\">\n                        <span class=\"text-slate-400\" data-kid=\"1-2-3-1-3-1-1\">\n                            Responder coverage\n                        </span>\n                        <span class=\"sy-mono font-bold text-white\" data-kid=\"1-2-3-1-3-1-2\">\n                            86%\n                        </span>\n                    </div>\n                    <div class=\"mt-2 h-1.5 rounded-full bg-[#08121D]\" data-kid=\"1-2-3-1-3-2\">\n                        <div class=\"h-full w-[86%] rounded-full bg-[#1BD1A5]\" data-kid=\"1-2-3-1-3-2-1\">\n                        </div>\n                    </div>\n                    <div class=\"mt-3 flex items-center justify-between text-xs\" data-kid=\"1-2-3-1-3-3\">\n                        <span class=\"text-slate-400\" data-kid=\"1-2-3-1-3-3-1\">\n                            Network availability\n                        </span>\n                        <span class=\"sy-mono font-bold text-white\" data-kid=\"1-2-3-1-3-3-2\">\n                            94%\n                        </span>\n                    </div>\n                    <div class=\"mt-2 h-1.5 rounded-full bg-[#08121D]\" data-kid=\"1-2-3-1-3-4\">\n                        <div class=\"h-full w-[94%] rounded-full bg-[#5AA7FF]\" data-kid=\"1-2-3-1-3-4-1\">\n                        </div>\n                    </div>\n                </div>\n            </aside>\n            <section aria-label=\"Live tactical map\" class=\"rounded-[10px] border border-[#29465C] bg-[#0E1D2C]\" data-kid=\"1-2-3-2\">\n                <div class=\"flex items-start justify-between border-b border-[#29465C] px-5 py-4\" data-kid=\"1-2-3-2-1\">\n                    <div data-kid=\"1-2-3-2-1-1\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[.14em] text-[#5AA7FF]\" data-kid=\"1-2-3-2-1-1-1\">\n                            Spatial intelligence\n                        </p>\n                        <h2 class=\"mt-1 text-base font-bold text-white\" data-kid=\"1-2-3-2-1-1-2\">\n                            Live tactical map\n                        </h2>\n                        <p class=\"mt-1 text-xs text-slate-400\" data-kid=\"1-2-3-2-1-1-3\">\n                            Tourist positions, active incidents, and geo-fences\n                        </p>\n                    </div>\n                    <div class=\"flex items-center gap-2 rounded-full border border-[#1BD1A5]/30 bg-[#1BD1A5]/10 px-3 py-1.5 text-[11px] font-bold text-[#80E8CD]\" data-kid=\"1-2-3-2-1-2\">\n                        <span class=\"h-2 w-2 rounded-full bg-[#1BD1A5]\" data-kid=\"1-2-3-2-1-2-1\">\n                        </span>\n                        GPS stream active\n                    </div>\n                </div>\n                <div class=\"map-grid relative mx-5 my-5 h-[445px] overflow-hidden rounded-[10px] border border-[#29465C] bg-[#102536]\" data-kid=\"1-2-3-2-2\">\n                    <div class=\"absolute inset-0 bg-[#0E1D2C]/25\" data-kid=\"1-2-3-2-2-1\">\n                    </div>\n                    <div class=\"map-road left-[8%] top-[61%] w-[78%] rotate-[-13deg]\" data-kid=\"1-2-3-2-2-2\">\n                    </div>\n                    <div class=\"map-road left-[19%] top-[30%] w-[74%] rotate-[27deg]\" data-kid=\"1-2-3-2-2-3\">\n                    </div>\n                    <div class=\"map-road left-[45%] top-[8%] w-[55%] rotate-[91deg]\" data-kid=\"1-2-3-2-2-4\">\n                    </div>\n                    <div class=\"map-road left-[4%] top-[84%] w-[96%] rotate-[-2deg]\" data-kid=\"1-2-3-2-2-5\">\n                    </div>\n                    <div class=\"zone left-[7%] top-[16%] h-[170px] w-[270px] border-[#1BD1A5]/50 bg-[#1BD1A5]/10 text-[#76E2C8]\" data-kid=\"1-2-3-2-2-6\">\n                        safe corridor\n                    </div>\n                    <div class=\"zone left-[48%] top-[20%] h-[200px] w-[300px] border-[#E7B84B]/60 bg-[#E7B84B]/10 text-[#F7D982]\" data-kid=\"1-2-3-2-2-7\">\n                        caution zone\n                    </div>\n                    <div class=\"zone left-[58%] top-[48%] h-[190px] w-[260px] border-[#FF6870]/70 bg-[#FF6870]/10 text-[#FFB0B4]\" data-kid=\"1-2-3-2-2-8\">\n                        danger zone\n                    </div>\n                    <div class=\"marker marker-safe left-[25%] top-[52%]\" data-kid=\"1-2-3-2-2-9\" title=\"SY-1002 · SAFE\">\n                    </div>\n                    <div class=\"absolute left-[27%] top-[55%] text-[11px] font-bold text-[#A6F1DF]\" data-kid=\"1-2-3-2-2-10\">\n                        SY-1002\n                    </div>\n                    <div class=\"marker marker-safe left-[35%] top-[28%]\" data-kid=\"1-2-3-2-2-11\" title=\"SY-1006 · SAFE\">\n                    </div>\n                    <div class=\"absolute left-[37%] top-[25%] text-[11px] font-bold text-[#A6F1DF]\" data-kid=\"1-2-3-2-2-12\">\n                        SY-1006\n                    </div>\n                    <div class=\"marker marker-caution left-[68%] top-[33%]\" data-kid=\"1-2-3-2-2-13\" title=\"SY-1009 · CAUTION\">\n                    </div