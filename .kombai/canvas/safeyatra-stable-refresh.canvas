      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap');\n  :root { --ink:#08121D; --slate:#0E1D2C; --elevated:#152A3D; --border:#29465C; --mint:#1BD1A5; --cyan:#5AA7FF; --amber:#E7B84B; --coral:#FF6870; --muted:#9BAFC1; --soft:#70879A; }\n  * { box-sizing:border-box; }\n  body { margin:0; min-width:320px; background:var(--ink); color:#F2F7FA; font-family:'Inter',ui-sans-serif,system-ui,sans-serif; }\n  .mono { font-family:'JetBrains Mono',ui-monospace,monospace; }\n  .hairline { border:1px solid var(--border); }\n  .label { color:var(--soft); font-size:10px; font-weight:800; letter-spacing:.13em; text-transform:uppercase; }\n  .button { min-height:44px; border:1px solid var(--border); border-radius:10px; background:var(--elevated); color:#F2F7FA; font-size:12px; font-weight:800; padding:0 14px; display:inline-flex; align-items:center; justify-content:center; gap:8px; cursor:pointer; }\n  .button:focus-visible { outline:2px solid var(--mint); outline-offset:3px; }\n  .button:hover { border-color:var(--mint); }\n  .button.primary { background:var(--mint); color:var(--ink); border-color:var(--mint); }\n  .button.danger { background:rgba(255,104,112,.12); color:#FFD6D9; border-color:rgba(255,104,112,.55); }\n  .status { min-height:20px; color:var(--muted); font-size:12px; }\n  .map-road { position:absolute; height:2px; background:rgba(184,211,224,.27); transform-origin:left center; }\n  .map-road.one { width:270px; left:16px; top:122px; transform:rotate(-28deg); }\n  .map-road.two { width:248px; left:30px; top:166px; transform:rotate(18deg); }\n  .map-road.three { width:190px; left:106px; top:64px; transform:rotate(77deg); }\n  .map-road.four { width:140px; left:30px; top:76px; transform:rotate(5deg); background:rgba(90,167,255,.46); }\n  .zone { position:absolute; border-radius:999px; opacity:.52; }\n  .marker { position:absolute; height:18px; width:18px; border-radius:999px; border:3px solid rgba(255,255,255,.84); box-shadow:0 0 0 5px rgba(255,255,255,.12); }\n</style>\n<script src=\"https://unpkg.com/lucide@latest/dist/umd/lucide.js\">\n</script>\n<div class=\"min-h-screen bg-[var(--ink)] text-white\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"sticky top-0 z-20 border-b border-[var(--border)] bg-[var(--ink)]/95 px-4 py-3 backdrop-blur\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-1\" data-name=\"header flex layout container\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"app branding container\">\n                <div class=\"grid h-9 w-9 shrink-0 place-items-center rounded-[10px] border border-[var(--mint)]/50 bg-[var(--mint)]/10 text-[var(--mint)]\" data-kid=\"1-1-1-1-1\" data-name=\"branding icon container\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-1-1-1-1-1\" data-lucide=\"shield-check\" data-name=\"shield check icon\">\n                    </i>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"branding text container\">\n                    <p class=\"truncate text-sm font-extrabold\" data-kid=\"1-1-1-1-2-1\" data-name=\"application title\">\n                        SafeYatra\n                        <span class=\"text-[var(--mint)]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"application name AI suffix\">\n                            AI\n                        </span>\n                    </p>\n                    <p class=\"label mt-0.5 truncate\" data-kid=\"1-1-1-1-2-2\" data-name=\"location label\">\n                        Authority · Nashik\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-1-1-2\" data-name=\"user status container\">\n                <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[var(--mint)]/35 bg-[var(--mint)]/10 px-2.5 py-1.5 text-[11px] font-bold text-[var(--mint)]\" data-kid=\"1-1-1-2-1\" data-name=\"live status indicator\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--mint)]\" data-kid=\"1-1-1-2-1-1\" data-name=\"live status pulse dot\">\n                    </span>\n                    Live\n                </span>\n                <button aria-label=\"Open profile\" class=\"grid h-10 w-10 place-items-center rounded-[10px] border border-[var(--border)] bg-[var(--slate)]\" data-kid=\"1-1-1-2-2\" data-name=\"profile open button\">\n                    <span class=\"mono text-[11px] font-bold text-[var(--mint)]\" data-kid=\"1-1-1-2-2-1\" data-name=\"user initials\">\n                        NC\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[420px] space-y-4 px-4 pb-8 pt-4\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-1\" data-name=\"header and refresh control container\">\n            <div data-kid=\"1-2-1-1\" data-name=\"main page title container\">\n                <p class=\"label text-[var(--mint)]\" data-kid=\"1-2-1-1-1\" data-name=\"command center label\">\n                    Command center\n                </p>\n                <h1 class=\"mt-1 text-[22px] font-extrabold tracking-tight\" data-kid=\"1-2-1-1-2\" data-name=\"operational picture heading\">\n                    Operational picture\n                </h1>\n                <p class=\"mt-1 text-[12px] leading-5 text-[var(--muted)]\" data-dynamic=\"true\" data-kid=\"1-2-1-1-3\" data-name=\"last updated timestamp\" data-reason=\"text updated by refresh script\">\n                    Nashik district · updated 08:42 UTC\n                </p>\n            </div>\n            <button aria-label=\"Refresh network\" class=\"button shrink-0 px-3\" data-kid=\"1-2-1-2\" data-name=\"refresh network button\" id=\"refresh\">\n                <i class=\"h-4 w-4\" data-kid=\"1-2-1-2-1\" data-lucide=\"refresh-cw\" data-name=\"refresh icon\">\n                </i>\n            </button>\n        </div>\n        <div class=\"hairline flex items-start gap-3 rounded-[10px] bg-[var(--elevated)] px-3 py-3\" data-kid=\"1-2-2\" data-name=\"offline sync warning banner\">\n            <i class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--amber)]\" data-kid=\"1-2-2-1\" data-lucide=\"cloud-off\" data-name=\"cloud off icon\">\n            </i>\n            <div class=\"min-w-0\" data-kid=\"1-2-2-2\" data-name=\"sync warning text container\">\n                <p class=\"text-[12px] font-bold text-white\" data-kid=\"1-2-2-2-1\" data-name=\"sync warning title\">\n                    Offline sync queue · 3 packets\n                </p>\n                <p class=\"mt-1 text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-2-2-2\" data-name=\"sync warning explanation\">\n                    Local GPS and SOS remain active. Pending updates will reconcile automatically when coverage returns.\n                </p>\n            </div>\n            <button class=\"shrink-0 text-[12px] font-extrabold text-[var(--mint)]\" data-kid=\"1-2-2-3\" data-name=\"sync button\" id=\"sync\">\n                Sync\n            </button>\n        </div>\n        <section aria-label=\"Network summary\" class=\"grid grid-cols-2 gap-2\" data-kid=\"1-2-3\" data-name=\"network summary grid\">\n            <div class=\"hairline rounded-[10px] bg-[var(--slate)] p-3\" data-kid=\"1-2-3-1\" data-name=\"active tourists statistic card\">\n                <p class=\"label\" data-kid=\"1-2-3-1-1\" data-name=\"active tourists label\">\n                    Active tourists\n                </p>\n                <p class=\"mono mt-2 text-[20px] font-bold\" data-kid=\"1-2-3-1-2\" data-name=\"active tourists count\">\n                    1,250\n                </p>\n                <p class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-3-1-3\" data-name=\"zones count\">\n                    12 zones\n                </p>\n            </div>\n            <div class=\"hairline rounded-[10px] bg-[rgba(255,104,112,.10)] p-3\" data-kid=\"1-2-3-2\" data-name=\"open emergencies statistic card\">\n                <p class=\"label text-[#FFB5B8]\" data-kid=\"1-2-3-2-1\" data-name=\"open emergencies label\">\n                    Open emergencies\n                </p>\n                <p class=\"mono mt-2 text-[20px] font-bold text-[#FFD6D9]\" data-kid=\"1-2-3-2-2\" data-name=\"open emergencies count\">\n                    4\n                </p>\n                <p class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-3-2-3\" data-name=\"critical now label\">\n                    1 critical now\n                </p>\n            </div>\n            <div class=\"hairline rounded-[10px] bg-[rgba(255,104,112,.06)] p-3\" data-kid=\"1-2-3-3\" data-name=\"critical risk statistic card\">\n                <p class=\"label text-[#FFB5B8]\" data-kid=\"1-2-3-3-1\" data-name=\"critical risk label\">\n                    Critical risk\n                </p>\n                <p class=\"mono mt-2 text-[20px] font-bold text-[#FFD6D9]\" data-kid=\"1-2-3-3-2\" data-name=\"critical risk count\">\n                    12\n                </p>\n                <p class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-3-3-3\" data-name=\"escalation threshold label\">\n                    Escalation threshold\n                </p>\n            </div>\n            <div class=\"hairline rounded-[10px] bg-[var(--slate)] p-3\" data-kid=\"1-2-3-4\" data-name=\"offline statistic card\">\n                <p class=\"label\" data-kid=\"1-2-3-4-1\" data-name=\"offline label\">\n                    Offline\n                </p>\n                <p class=\"mono mt-2 text-[20px] font-bold text-[var(--amber)]\" data-kid=\"1-2-3-4-2\" data-name=\"offline count\">\n                    18\n                </p>\n                <p class=\"mt-1 text-[12px] text-[var(--muted)]\" data-kid=\"1-2-3-4-3\" data-name=\"last seen label\">\n                    Last seen < 10m\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"queue-heading\" class=\"hairline rounded-[10px] bg-[var(--slate)] p-3\" data-kid=\"1-2-4\" data-name=\"priority queue section\">\n            <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-2-4-1\" data-name=\"priority queue header container\">\n                <div data-kid=\"1-2-4-1-1\" data-name=\"priority queue text header\">\n                    <p class=\"label\" data-kid=\"1-2-4-1-1-1\" data-name=\"priority queue label\">\n                        Priority queue\n                    </p>\n                    <h2 class=\"mt-1 text-[16px] font-extrabold\" data-kid=\"1-2-4-1-1-2\" data-name=\"priority queue heading\" id=\"queue-heading\">\n                        Incidents requiring action\n                    </h2>\n                </div>\n                <button class=\"button px-3\" data-kid=\"1-2-4-1-2\" data-name=\"filter incidents button\" id=\"filter\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-4-1-2-1\" data-lucide=\"list-filter\" data-name=\"filter icon\">\n                    </i>\n                    Open\n                </button>\n            </div>\n            <div class=\"mt-3 space-y-2\" data-kid=\"1-2-4-2\" data-name=\"incidents list\">\n                <button aria-pressed=\"true\" class=\"incident-row hairline flex w-full items-start gap-3 rounded-[10px] bg-[rgba(255,104,112,.11)] p-3 text-left\" data-incident=\"critical\" data-kid=\"1-2-4-2-1\" data-name=\"critical incident row button\">\n                    <span class=\"mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-[8px] bg-[rgba(255,104,112,.18)] text-[#FFD6D9]\" data-kid=\"1-2-4-2-1-1\" data-name=\"siren icon container\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-4-2-1-1-1\" data-lucide=\"siren\" data-name=\"siren icon\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0 flex-1\" data-kid=\"1-2-4-2-1-2\" data-name=\"incident row content\">\n                        <span class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"incident row metadata\">\n                            <span class=\"mono text-[11px] font-bold text-white\" data-kid=\"1-2-4-2-1-2-1-1\" data-name=\"incident id text\">\n                                INC-2026-001\n                            </span>\n                            <span class=\"rounded-full bg-[var(--coral)] px-2 py-1 text-[10px] font-extrabold text-[var(--ink)]\" data-kid=\"1-2-4-2-1-2-1-2\" data-name=\"critical tag\">\n                                CRITICAL\n                            </span>\n                        </span>\n                        <span class=\"mt-2 block text-[13px] font-bold text-white\" data-kid=\"1-2-4-2-1-2-2\" data-name=\"incident description\">\n                            Aarav Mehta · SY-1001\n                        </span>\n                        <span class=\"mt-1 block text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-4-2-1-2-3\" data-name=\"incident details\">\n                            SOS + live GPS · Gangapur Dam Service Road\n                        </span>\n                    </span>\n                </button>\n                <button class=\"incident-row hairline flex w-full items-start gap-3 rounded-[10px] bg-[var(--slate)] p-3 text-left\" data-incident=\"high\" data-kid=\"1-2-4-2-2\" data-name=\"high priority incident row button\">\n                    <span class=\"mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-[8px] bg-[rgba(231,184,75,.15)] text-[var(--amber)]\" data-kid=\"1-2-4-2-2-1\" data-name=\"alert icon container\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-4-2-2-1-1\" data-lucide=\"triangle-alert\" data-name=\"triangle alert icon\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0 flex-1\" data-kid=\"1-2-4-2-2-2\" data-name=\"incident row content\">\n                        <span class=\"flex items-center justify-between gap-2\" data-kid=\"1-2-4-2-2-2-1\" data-name=\"incident row metadata\">\n                            <span class=\"mono text-[11px] font-bold\" data-kid=\"1-2-4-2-2-2-1-1\" data-name=\"incident id text\">\n                                INC-2026-004\n                            </span>\n                            <span class=\"rounded-full bg-[rgba(231,184,75,.16)] px-2 py-1 text-[10px] font-extrabold text-[var(--amber)]\" data-kid=\"1-2-4-2-2-2-1-2\" data-name=\"high priority tag\">\n                                HIGH\n                            </span>\n                        </span>\n                        <span class=\"mt-2 block text-[13px] font-bold\" data-kid=\"1-2-4-2-2-2-2\" data-name=\"incident description\">\n                            Meera Shah · SY-1028\n                        </span>\n                        <span class=\"mt-1 block text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-4-2-2-2-3\" data-name=\"incident details\">\n                            Geo-fence entry · Kalsubai trail\n                        </span>\n                    </span>\n                </button>\n            </div>\n        </section>\n        <section aria-labelledby=\"map-heading\" class=\"hairline overflow-hidden rounded-[10px] bg-[var(--slate)]\" data-kid=\"1-2-5\" data-name=\"tactical map section\">\n            <div class=\"flex items-center justify-between gap-3 border-b border-[var(--border)] px-3 py-3\" data-kid=\"1-2-5-1\" data-name=\"tactical map header container\">\n                <div data-kid=\"1-2-5-1-1\" data-name=\"tactical map text header\">\n                    <p class=\"label\" data-kid=\"1-2-5-1-1-1\" data-name=\"tactical map label\">\n                        Spatial intelligence\n                    </p>\n                    <h2 class=\"mt-1 text-[16px] font-extrabold\" data-kid=\"1-2-5-1-1-2\" data-name=\"tactical map heading\" id=\"map-heading\">\n                        Live tactical map\n                    </h2>\n                </div>\n                <span class=\"mono text-[10px] text-[var(--soft)]\" data-kid=\"1-2-5-1-2\" data-name=\"map timestamp\">\n                    NASHIK / 08:42\n                </span>\n            </div>\n            <div class=\"relative h-[250px] overflow-hidden bg-[#102536]\" data-kid=\"1-2-5-2\" data-name=\"map view container\">\n                <div class=\"absolute inset-0 opacity-30\" data-kid=\"1-2-5-2-1\" data-name=\"map background gradient overlay\" style=\"background:radial-gradient(circle at 24% 72%, rgba(27,209,165,.22), transparent 28%),radial-gradient(circle at 78% 28%, rgba(255,104,112,.18), transparent 26%);\">\n                </div>\n                <div class=\"map-road one\" data-kid=\"1-2-5-2-2\" data-name=\"road segment one\">\n                </div>\n                <div class=\"map-road two\" data-kid=\"1-2-5-2-3\" data-name=\"road segment two\">\n                </div>\n                <div class=\"map-road three\" data-kid=\"1-2-5-2-4\" data-name=\"road segment three\">\n                </div>\n                <div class=\"map-road four\" data-kid=\"1-2-5-2-5\" data-name=\"road segment four\">\n                </div>\n                <div class=\"zone left-[18px] top-[52px] h-[120px] w-[120px] border border-[var(--mint)]/70 bg-[var(--mint)]/15\" data-kid=\"1-2-5-2-6\" data-name=\"zone area indicator one\">\n                </div>\n                <div class=\"zone left-[188px] top-[84px] h-[126px] w-[126px] border border-[var(--amber)]/75 bg-[var(--amber)]/15\" data-kid=\"1-2-5-2-7\" data-name=\"zone area indicator two\">\n                </div>\n                <div class=\"zone left-[232px] top-[18px] h-[90px] w-[90px] border border-[var(--coral)]/85 bg-[var(--coral)]/18\" data-kid=\"1-2-5-2-8\" data-name=\"zone area indicator three\">\n                </div>\n                <div class=\"marker left-[76px] top-[132px] bg-[var(--mint)]\" data-kid=\"1-2-5-2-9\" data-name=\"map marker one\">\n                </div>\n                <div class=\"marker left-[258px] top-[52px] bg-[var(--coral)]\" data-kid=\"1-2-5-2-10\" data-name=\"map marker two\">\n                </div>\n                <div class=\"marker left-[238px] top-[146px] bg-[var(--amber)]\" data-kid=\"1-2-5-2-11\" data-name=\"map marker three\">\n                </div>\n                <div class=\"absolute left-3 bottom-3 rounded-[8px] border border-[var(--border)] bg-[var(--ink)]/90 px-3 py-2\" data-kid=\"1-2-5-2-12\" data-name=\"map selection info box\">\n                    <p class=\"label text-[var(--mint)]\" data-kid=\"1-2-5-2-12-1\" data-name=\"selected status label\">\n                        Selected\n                    </p>\n                    <p class=\"mt-1 text-[12px] font-bold\" data-kid=\"1-2-5-2-12-2\" data-name=\"selected incident id\">\n                        INC-2026-001\n                    </p>\n                    <p class=\"mt-1 mono text-[10px] text-[var(--muted)]\" data-kid=\"1-2-5-2-12-3\" data-name=\"selected coordinates\">\n                        20.0012 · 73.7440\n                    </p>\n                </div>\n                <div class=\"absolute right-3 top-3 rounded-[8px] border border-[var(--border)] bg-[var(--ink)]/90 px-2.5 py-2 text-[10px] text-[var(--muted)]\" data-kid=\"1-2-5-2-13\" data-name=\"map legend container\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-5-2-13-1\" data-name=\"map legend safe entry\">\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--mint)]\" data-kid=\"1-2-5-2-13-1-1\" data-name=\"map legend safe dot\">\n                        </span>\n                        Safe\n                    </div>\n                    <div class=\"mt-1.5 flex items-center gap-2\" data-kid=\"1-2-5-2-13-2\" data-name=\"map legend caution entry\">\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--amber)]\" data-kid=\"1-2-5-2-13-2-1\" data-name=\"map legend caution dot\">\n                        </span>\n                        Caution\n                    </div>\n                    <div class=\"mt-1.5 flex items-center gap-2\" data-kid=\"1-2-5-2-13-3\" data-name=\"map legend danger entry\">\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--coral)]\" data-kid=\"1-2-5-2-13-3-1\" data-name=\"map legend danger dot\">\n                        </span>\n                        Danger\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex items-start gap-2 border-t border-[var(--border)] px-3 py-3\" data-kid=\"1-2-5-3\" data-name=\"map fallback notice container\">\n                <i class=\"mt-0.5 h-4 w-4 shrink-0 text-[var(--amber)]\" data-kid=\"1-2-5-3-1\" data-lucide=\"map-pin-off\" data-name=\"map pin off icon\">\n                </i>\n                <p class=\"text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-2-5-3-2\" data-name=\"map fallback notice text\">\n                    <span class=\"font-bold text-white\" data-kid=\"1-2-5-3-2-1\" data-name=\"map fallback bold text\">\n                        Map fallback ready.\n                    </span>\n                    If tiles fail, marker coordinates and incident actions remain available.\n                </p>\n                <button class=\"ml-auto shrink-0 text-[12px] font-extrabold text-[var(--cyan)]\" data-kid=\"1-2-5-3-3\" data-name=\"test map fallback button\" id=\"map-test\">\n                    Test\n                </button>\n            </div>\n        </section>\n        <section aria-labelledby=\"inspector-heading\" class=\"hairline rounded-[10px] bg-[var(--slate)] p-3\" data-kid=\"1-2-6\" data-name=\"incident inspector section\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-6-1\" data-name=\"incident inspector header\">\n                <div data-kid=\"1-2-6-1-1\" data-name=\"incident inspector text header\">\n                    <p class=\"label\" data-kid=\"1-2-6-1-1-1\" data-name=\"selected incident label\">\n                        Selected incident\n                    </p>\n                    <h2 class=\"mt-1 text-[16px] font-extrabold\" data-kid=\"1-2-6-1-1-2\" data-name=\"selected incident heading\" id=\"inspector-heading\">\n                        INC-2026-001\n                    </h2>\n                </div>\n                <span class=\"rounded-full bg-[rgba(255,104,112,.16)] px-2.5 py-1 text-[10px] font-extrabold text-[#FFD6D9]\" data-kid=\"1-2-6-1-2\" data-name=\"incident status tag\">\n                    DETECTED\n                </span>\n            </div>\n            <div class=\"mt-3 grid grid-cols-2 gap-x-4 gap-y-3 border-y border-[var(--border)] py-3\" data-kid=\"1-2-6-2\" data-name=\"incident details grid\">\n                <div data-kid=\"1-2-6-2-1\" data-name=\"tourist info box\">\n                    <p class=\"label\" data-kid=\"1-2-6-2-1-1\" data-name=\"tourist label\">\n                        Tourist\n                    </p>\n                    <p class=\"mt-1 text-[12px] font-bold\" data-kid=\"1-2-6-2-1-2\" data-name=\"tourist name\">\n                        Aarav Mehta\n                    </p>\n                </div>\n                <div data-kid=\"1-2-6-2-2\" data-name=\"risk score box\">\n                    <p class=\"label\" data-kid=\"1-2-6-2-2-1\" data-name=\"risk score label\">\n                        Risk score\n                    </p>\n                    <p class=\"mono mt-1 text-[12px] font-bold text-[var(--coral)]\" data-kid=\"1-2-6-2-2-2\" data-name=\"risk score value\">\n                        94% / CRITICAL\n                    </p>\n                </div>\n                <div data-kid=\"1-2-6-2-3\" data-name=\"location coordinates box\">\n                    <p class=\"label\" data-kid=\"1-2-6-2-3-1\" data-name=\"location label\">\n                        Location\n                    </p>\n                    <p class=\"mono mt-1 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-6-2-3-2\" data-name=\"coordinates value\">\n                        20.0012, 73.7440\n                    </p>\n                </div>\n                <div data-kid=\"1-2-6-2-4\" data-name=\"responder box\">\n                    <p class=\"label\" data-kid=\"1-2-6-2-4-1\" data-name=\"responder label\">\n                        Responder\n                    </p>\n                    <p class=\"mt-1 text-[12px] font-bold text-[var(--amber)]\" data-kid=\"1-2-6-2-4-2\" data-name=\"responder name\">\n                        Unassigned\n                    </p>\n                </div>\n                <div data-kid=\"1-2-6-2-5\" data-name=\"source box\">\n                    <p class=\"label\" data-kid=\"1-2-6-2-5-1\" data-name=\"source label\">\n                        Source\n                    </p>\n                    <p class=\"mt-1 text-[12px] font-bold\" data-kid=\"1-2-6-2-5-2\" data-name=\"source value\">\n                        SOS + AI escalation\n                    </p>\n                </div>\n                <div data-kid=\"1-2-6-2-6\" data-name=\"digital id box\">\n                    <p class=\"label\" data-kid=\"1-2-6-2-6-1\" data-name=\"digital id label\">\n                        Digital ID\n                    </p>\n                    <p class=\"mt-1 text-[12px] font-bold text-[var(--mint)]\" data-kid=\"1-2-6-2-6-2\" data-name=\"digital id value\">\n                        Verified · 08:36\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-3\" data-kid=\"1-2-6-3\" data-name=\"escalation path section\">\n                <p class=\"label\" data-kid=\"1-2-6-3-1\" data-name=\"escalation label\">\n                    Escalation path\n                </p>\n                <div class=\"mt-3 space-y-3\" data-kid=\"1-2-6-3-2\" data-name=\"escalation timeline container\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"1-2-6-3-2-1\" data-name=\"escalation step one\">\n                        <span class=\"grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[var(--coral)] text-[var(--ink)]\" data-kid=\"1-2-6-3-2-1-1\" data-name=\"step icon container\">\n                            <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-6-3-2-1-1-1\" data-lucide=\"siren\" data-name=\"siren icon\">\n                            </i>\n                        </span>\n                        <div data-kid=\"1-2-6-3-2-1-2\" data-name=\"step details container\">\n                            <p class=\"text-[12px] font-bold\" data-kid=\"1-2-6-3-2-1-2-1\" data-name=\"step title\">\n                                SOS detected\n                            </p>\n                            <p class=\"text-[12px] text-[var(--muted)]\" data-kid=\"1-2-6-3-2-1-2-2\" data-name=\"step description\">\n                                Live location attached · 08:41:28\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-start gap-3\" data-kid=\"1-2-6-3-2-2\" data-name=\"escalation step two\">\n                        <span class=\"grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[var(--amber)] text-[var(--ink)]\" data-kid=\"1-2-6-3-2-2-1\" data-name=\"step icon container\">\n                            <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-6-3-2-2-1-1\" data-lucide=\"bell-ring\" data-name=\"bell ring icon\">\n                            </i>\n                        </span>\n                        <div data-kid=\"1-2-6-3-2-2-2\" data-name=\"step details container\">\n                            <p class=\"text-[12px] font-bold\" data-kid=\"1-2-6-3-2-2-2-1\" data-name=\"step title\">\n                                Authority notified\n                            </p>\n                            <p class=\"text-[12px] text-[var(--muted)]\" data-kid=\"1-2-6-3-2-2-2-2\" data-name=\"step description\">\n                                Awaiting acknowledgement\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-start gap-3 opacity-55\" data-kid=\"1-2-6-3-2-3\" data-name=\"escalation step three\">\n                        <span class=\"grid h-6 w-6 shrink-0 place-items-center rounded-full border border-[var(--border)] text-[var(--soft)]\" data-kid=\"1-2-6-3-2-3-1\" data-name=\"step icon container\">\n                            <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-6-3-2-3-1-1\" data-lucide=\"users\" data-name=\"users icon\">\n                            </i>\n                        </span>\n                        <div data-kid=\"1-2-6-3-2-3-2\" data-name=\"step details container\">\n                            <p class=\"text-[12px] font-bold\" data-kid=\"1-2-6-3-2-3-2-1\" data-name=\"step title\">\n                                Responder pending\n                            </p>\n                            <p class=\"text-[12px] text-[var(--muted)]\" data-kid=\"1-2-6-3-2-3-2-2\" data-name=\"step description\">\n                                Assign a field unit to continue\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-4 grid gap-2\" data-kid=\"1-2-6-4\" data-name=\"incident actions container\">\n                <button class=\"button primary w-full\" data-kid=\"1-2-6-4-1\" data-name=\"acknowledge incident button\" id=\"ack\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-6-4-1-1\" data-lucide=\"clipboard-check\" data-name=\"acknowledge icon\">\n                    </i>\n                    Acknowledge incident\n                </button>\n                <div class=\"grid grid-cols-2 gap-2\" data-kid=\"1-2-6-4-2\" data-name=\"secondary actions row\">\n                    <button class=\"button w-full\" data-kid=\"1-2-6-4-2-1\" data-name=\"assign unit button\" id=\"assign\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-6-4-2-1-1\" data-lucide=\"radio-tower\" data-name=\"radio tower icon\">\n                        </i>\n                        Assign Alpha-07\n                    </button>\n                    <button class=\"button w-full\" data-kid=\"1-2-6-4-2-2\" data-name=\"verify id button\" id=\"verify\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-2-6-4-2-2-1\" data-lucide=\"badge-check\" data-name=\"badge check icon\">\n                        </i>\n                        Verify ID\n                    </button>\n                </div>\n                <button class=\"button w-full\" data-kid=\"1-2-6-4-3\" data-name=\"mark resolved button\" id=\"resolve\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-2-6-4-3-1\" data-lucide=\"check-circle-2\" data-name=\"resolved icon\">\n                    </i>\n                    Mark resolved\n                </button>\n            </div>\n            <p aria-live=\"polite\" class=\"status mt-3\" data-dynamic=\"true\" data-kid=\"1-2-6-5\" data-name=\"status feedback message\" data-reason=\"text updated by script in response to user actions\" id=\"feedback\" role=\"status\">\n                Select an action to update the incident trail.\n            </p>\n        </section>\n    </main>\n</div>\n<script>\n    lucide.createIcons();\n  const feedback = document.getElementById('feedback');\n  const setFeedback = (text, tone='normal') => { feedback.textContent = text; feedback.style.color = tone === 'good' ? 'var(--mint)' : tone === 'warn' ? 'var(--amber)' : 'var(--muted)'; };\n  document.querySelectorAll('.incident-row').forEach((row) => row.addEventListener('click', () => { document.querySelectorAll('.incident-row').forEach((item) => item.style.outline='none'); row.style.outline='2px solid var(--mint)'; setFeedback(row.dataset.incident === 'critical' ? 'Focused INC-2026-001 · inspector updated.' : 'Focused INC-2026-004 · inspector preview ready.'); }));\n  document.getElementById('ack').addEventListener('click', () => setFeedback('Incident acknowledged · audit event added at 08:42:16.', 'good'));\n  document.getElementById('assign').addEventListener('click', () => setFeedback('Unit Alpha-07 assigned · responder notified.', 'good'));\n  document.getElementById('verify').addEventListener('click', () => setFeedback('Digital ID hash verified · privacy-safe receipt ready.', 'good'));\n  document.getElementById('resolve').addEventListener('click', () => setFeedback('Resolution saved locally · sync will reconcile when online.', 'warn'));\n  document.getElementById('sync').addEventListener('click', () => setFeedback('Sync queued · 3 packets will upload when coverage returns.', 'warn'));\n  document.getElementById('refresh').addEventListener('click', () => setFeedback('Network snapshot refreshed · last update 08:42 UTC.', 'good'));\n  document.getElementById('filter').addEventListener('click', () => setFeedback('Showing open incidents · critical items stay pinned first.'));\n  document.getElementById('map-test').addEventListener('click', () => setFeedback('Map fallback tested · coordinates remain available without tiles.', 'good'));\n</script>\n",
