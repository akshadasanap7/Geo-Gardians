                     </span>\n                        <i data-kid=\"1-2-7-2-3-1-2\" data-lucide=\"ambulance\" style=\"width:15px;height:15px;color:#E7B84B;\">\n                        </i>\n                    </div>\n                    <div data-kid=\"1-2-7-2-3-2\" style=\"font-size:11px;color:#B7C8D1;margin-top:8px;line-height:1.4;\">\n                        Assigned cases · resolve\n                    </div>\n                </div>\n                <div data-kid=\"1-2-7-2-4\" style=\"border:1px solid rgba(27,209,165,.5);border-radius:8px;padding:11px;background:rgba(27,209,165,.08);\">\n                    <div data-kid=\"1-2-7-2-4-1\" style=\"display:flex;justify-content:space-between;gap:4px;\">\n                        <span class=\"label\" data-kid=\"1-2-7-2-4-1-1\" style=\"color:#8DE8D0;\">\n                            Admin\n                        </span>\n                        <i data-kid=\"1-2-7-2-4-1-2\" data-lucide=\"settings-2\" style=\"width:15px;height:15px;color:#1BD1A5;\">\n                        </i>\n                    </div>\n                    <div data-kid=\"1-2-7-2-4-2\" style=\"font-size:11px;color:#C9D9D8;margin-top:8px;line-height:1.4;\">\n                        Users · policies · audit\n                    </div>\n                </div>\n            </div>\n            <div data-dynamic=\"true\" data-kid=\"1-2-7-3\" data-name=\"role message notification\" data-reason=\"content and visibility toggled by click\" id=\"role-message\" style=\"display:none;margin-top:10px;padding:9px 10px;border:1px solid rgba(90,167,255,.35);border-radius:8px;background:rgba(90,167,255,.08);font-size:12px;color:#AFCFFF;\">\n            </div>\n        </section>\n        <section class=\"panel\" data-kid=\"1-2-8\" style=\"padding:14px;margin-bottom:14px;\">\n            <div data-kid=\"1-2-8-1\" style=\"display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:11px;\">\n                <div data-kid=\"1-2-8-1-1\">\n                    <div class=\"label\" data-kid=\"1-2-8-1-1-1\" style=\"color:#E7B84B;\">\n                        Policy management\n                    </div>\n                    <h2 data-kid=\"1-2-8-1-1-2\" style=\"font-size:16px;margin:6px 0 0;font-weight:800;\">\n                        Configured zones\n                    </h2>\n                </div>\n                <span class=\"mono\" data-kid=\"1-2-8-1-2\" style=\"font-size:11px;color:#9DB2BF;\">\n                    12 active\n                </span>\n            </div>\n            <div data-kid=\"1-2-8-2\" style=\"position:relative;margin-bottom:10px;\">\n                <i data-kid=\"1-2-8-2-1\" data-lucide=\"search\" style=\"position:absolute;left:11px;top:13px;width:15px;height:15px;color:#8299A8;\">\n                </i>\n                <input aria-label=\"Search zone or policy\" data-kid=\"1-2-8-2-2\" data-name=\"zone search input field\" id=\"zone-search\" placeholder=\"Search zone or policy\" style=\"width:100%;height:42px;border:1px solid #29465C;border-radius:8px;background:#152A3D;color:#EDF5F8;padding:0 12px 0 34px;font-size:12px;outline:none;\" type=\"search\"/>\n            </div>\n            <div data-dynamic=\"true\" data-kid=\"1-2-8-3\" data-name=\"zone search results list\" data-reason=\"visibility of row children toggled by search input\" id=\"zone-list\" style=\"display:grid;gap:6px;\">\n                <div class=\"zone-row\" data-kid=\"1-2-8-3-1\" data-zone=\"gangapur dam service road\" style=\"display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid rgba(255,104,112,.28);border-radius:8px;padding:10px 11px;background:rgba(255,104,112,.05);\">\n                    <div data-kid=\"1-2-8-3-1-1\" style=\"display:flex;align-items:center;gap:9px;min-width:0;\">\n                        <span data-kid=\"1-2-8-3-1-1-1\" style=\"width:8px;height:8px;border-radius:50%;background:#FF6870;flex:0 0 auto;\">\n                        </span>\n                        <div data-kid=\"1-2-8-3-1-1-2\" style=\"min-width:0;\">\n                            <div data-kid=\"1-2-8-3-1-1-2-1\" style=\"font-size:12px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;\">\n                                Gangapur Dam Service Road\n                            </div>\n                            <div class=\"mono\" data-kid=\"1-2-8-3-1-1-2-2\" style=\"font-size:10px;color:#9DB2BF;margin-top:3px;\">\n                                danger · r=1.2km\n                            </div>\n                        </div>\n                    </div>\n                    <span class=\"label\" data-kid=\"1-2-8-3-1-2\" style=\"color:#FF8C92;\">\n                        HIGH\n                    </span>\n                </div>\n                <div class=\"zone-row\" data-kid=\"1-2-8-3-2\" data-zone=\"kalsubai trail\" style=\"display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid #29465C;border-radius:8px;padding:10px 11px;background:#152A3D;\">\n                    <div data-kid=\"1-2-8-3-2-1\" style=\"display:flex;align-items:center;gap:9px;min-width:0;\">\n                        <span data-kid=\"1-2-8-3-2-1-1\" style=\"width:8px;height:8px;border-radius:50%;background:#E7B84B;flex:0 0 auto;\">\n                        </span>\n                        <div data-kid=\"1-2-8-3-2-1-2\" style=\"min-width:0;\">\n                            <div data-kid=\"1-2-8-3-2-1-2-1\" style=\"font-size:12px;font-weight:800;\">\n                                Kalsubai trail\n                            </div>\n                            <div class=\"mono\" data-kid=\"1-2-8-3-2-1-2-2\" style=\"font-size:10px;color:#9DB2BF;margin-top:3px;\">\n                                caution · r=0.8km\n                            </div>\n                        </div>\n                    </div>\n                    <span class=\"label\" data-kid=\"1-2-8-3-2-2\" style=\"color:#F2CE76;\">\n                        WATCH\n                    </span>\n                </div>\n                <div class=\"zone-row\" data-kid=\"1-2-8-3-3\" data-zone=\"trimbakeshwar corridor\" style=\"display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid #29465C;border-radius:8px;padding:10px 11px;background:#152A3D;\">\n                    <div data-kid=\"1-2-8-3-3-1\" style=\"display:flex;align-items:center;gap:9px;min-width:0;\">\n                        <span data-kid=\"1-2-8-3-3-1-1\" style=\"width:8px;height:8px;border-radius:50%;background:#1BD1A5;flex:0 0 auto;\">\n                        </span>\n                        <div data-kid=\"1-2-8-3-3-1-2\" style=\"min-width:0;\">\n                            <div data-kid=\"1-2-8-3-3-1-2-1\" style=\"font-size:12px;font-weight:800;\">\n                                Trimbakeshwar corridor\n                            </div>\n                            <div class=\"mono\" data-kid=\"1-2-8-3-3-1-2-2\" style=\"font-size:10px;color:#9DB2BF;margin-top:3px;\">\n                                safe · r=2.4km\n                            </div>\n                        </div>\n                    </div>\n                    <span class=\"label\" data-kid=\"1-2-8-3-3-2\" style=\"color:#80E8CD;\">\n                        SAFE\n                    </span>\n                </div>\n            </div>\n            <div data-dynamic=\"true\" data-kid=\"1-2-8-4\" data-name=\"no matching zone message\" data-reason=\"visibility toggled by search results\" id=\"zone-empty\" style=\"display:none;padding:14px 8px;text-align:center;color:#A7B8C1;font-size:12px;border:1px dashed #29465C;border-radius:8px;\">\n                No matching zone. Try “Kalsubai” or “Trimbakeshwar”.\n            </div>\n        </section>\n        <section class=\"panel\" data-kid=\"1-2-9\" style=\"padding:14px;\">\n            <div data-kid=\"1-2-9-1\" style=\"display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px;\">\n                <div data-kid=\"1-2-9-1-1\">\n                    <div class=\"label\" data-kid=\"1-2-9-1-1-1\" style=\"color:#1BD1A5;\">\n                        Accountability\n                    </div>\n                    <h2 data-kid=\"1-2-9-1-1-2\" style=\"font-size:16px;margin:6px 0 0;font-weight:800;\">\n                        Recent audit events\n                    </h2>\n                </div>\n                <button data-dynamic=\"true\" data-kid=\"1-2-9-1-2\" data-name=\"audit event filter button\" data-reason=\"text toggled by click\" id=\"audit-filter\" style=\"min-height:44px;padding:0 11px;border:1px solid #29465C;border-radius:8px;background:#152A3D;color:#C7D7DF;font-size:11px;font-weight:800;\">\n                    All events\n                </button>\n            </div>\n            <div data-kid=\"1-2-9-2\" style=\"display:grid;gap:0;\">\n                <div data-kid=\"1-2-9-2-1\" style=\"display:flex;gap:10px;padding:11px 0;border-top:1px solid rgba(41,70,92,.7);\">\n                    <div data-kid=\"1-2-9-2-1-1\" style=\"width:28px;height:28px;border-radius:50%;background:rgba(255,104,112,.12);color:#FF8C92;display:grid;place-items:center;flex:0 0 auto;\">\n                        <i data-kid=\"1-2-9-2-1-1-1\" data-lucide=\"siren\" style=\"width:14px;height:14px;\">\n                        </i>\n                    </div>\n                    <div data-kid=\"1-2-9-2-1-2\" style=\"min-width:0;\">\n                        <div data-kid=\"1-2-9-2-1-2-1\" style=\"font-size:12px;font-weight:800;line-height:1.35;\">\n                            Incident INC-2026-001 acknowledged\n                        </div>\n                        <div data-kid=\"1-2-9-2-1-2-2\" style=\"font-size:11px;color:#9DB2BF;margin-top:3px;\">\n                            Nashik Control Room · 08:41:28\n                        </div>\n                    </div>\n                </div>\n                <div data-kid=\"1-2-9-2-2\" style=\"display:flex;gap:10px;padding:11px 0;border-top:1px solid rgba(41,70,92,.7);\">\n                    <div data-kid=\"1-2-9-2-2-1\" style=\"width:28px;height:28px;border-radius:50%;background:rgba(90,167,255,.12);color:#7DBAFF;display:grid;place-items:center;flex:0 0 auto;\">\n                        <i data-kid=\"1-2-9-2-2-1-1\" data-lucide=\"user-plus\" style=\"width:14px;height:14px;\">\n                        </i>\n                    </div>\n                    <div data-kid=\"1-2-9-2-2-2\" style=\"min-width:0;\">\n                        <div data-kid=\"1-2-9-2-2-2-1\" style=\"font-size:12px;font-weight:800;line-height:1.35;\">\n                            Unit Alpha-07 assigned\n                        </div>\n                        <div data-kid=\"1-2-9-2-2-2-2\" style=\"font-size:11px;color:#9DB2BF;margin-top:3px;\">\n                            Ravi Patil · 08:40:12\n                        </div>\n                    </div>\n                </div>\n                <div data-kid=\"1-2-9-2-3\" style=\"display:flex;gap:10px;padding:11px 0;border-top:1px solid rgba(41,70,92,.7);\">\n                    <div data-kid=\"1-2-9-2-3-1\" style=\"width:28px;height:28px;border-radius:50%;background:rgba(27,209,165,.12);color:#80E8CD;display:grid;place-items:center;flex:0 0 auto;\">\n                        <i data-kid=\"1-2-9-2-3-1-1\" data-lucide=\"refresh-cw\" style=\"width:14px;height:14px;\">\n                        </i>\n                    </div>\n                    <div data-kid=\"1-2-9-2-3-2\" style=\"min-width:0;\">\n                        <div data-kid=\"1-2-9-2-3-2-1\" style=\"font-size:12px;font-weight:800;line-height:1.35;\">\n                            Offline packet queue reconciled\n                        </div>\n                        <div data-kid=\"1-2-9-2-3-2-2\" style=\"font-size:11px;color:#9DB2BF;margin-top:3px;\">\n                            Sync worker · 08:36:02\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div data-kid=\"1-2-9-3\" style=\"margin-top:11px;padding-top:10px;border-top:1px solid #29465C;display:flex;justify-content:space-between;align-items:center;gap:10px;\">\n                <span class=\"muted\" data-kid=\"1-2-9-3-1\" style=\"font-size:11px;\">\n                    Last full sync\n                    <span class=\"mono\" data-dynamic=\"true\" data-kid=\"1-2-9-3-1-1\" data-name=\"last full sync timestamp\" data-reason=\"value updated by system clock\" style=\"color:#EDF5F8;\">\n                        08:42 UTC\n                    </span>\n                </span>\n                <span data-dynamic=\"true\" data-kid=\"1-2-9-3-2\" data-name=\"audit health status label\" data-reason=\"value updated by system monitor\" style=\"font-size:11px;color:#80E8CD;font-weight:800;\">\n                    Audit healthy\n                </span>\n            </div>\n        </section>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n  const sync=document.getElementById('retry-sync'); const syncStatus=document.getElementById('sync-status');\n  sync.addEventListener('click',()=>{sync.disabled=true;sync.textContent='Syncing…';syncStatus.style.display='block';syncStatus.textContent='Sync started · uploading 3 queued packets';setTimeout(()=>{sync.textContent='Synced';syncStatus.textContent='Sync complete · 3 packets reconciled with command center';},1100);});\n  const menu=document.getElementById('admin-menu'); const menuNote=document.getElementById('menu-note'); menu.addEventListener('click',()=>{menuNote.style.display=menuNote.style.display==='none'?'block':'none';});\n  document.getElementById('role-info').addEventListener('click',()=>{const x=document.getElementById('role-message');x.style.display='block';x.textContent='Role matrix opened · admin can manage users, zones, settings, and audit logs.';});\n  document.getElementById('audit-filter').addEventListener('click',(e)=>{e.currentTarget.textContent=e.currentTarget.textContent==='All events'?'System + operator':'All events';});\n  const search=document.getElementById('zone-search'); const rows=[...document.querySelectorAll('.zone-row')]; const empty=document.getElementById('zone-empty'); search.addEventListener('input',()=>{const q=search.value.toLowerCase().trim();let shown=0;rows.forEach(r=>{const match=!q||r.dataset.zone.includes(q);r.style.display=match?'flex':'none';if(match)shown++;});empty.style.display=shown?'none':'block';});\n</script>\n",
