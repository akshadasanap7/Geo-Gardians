      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap');\n  :root { font-family: 'Inter', ui-sans-serif, system-ui, sans-serif; color-scheme: dark; }\n  .sy-mono { font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace; }\n  .sy-muted { color: rgba(237,245,248,.64); }\n  .sy-soft { color: rgba(237,245,248,.46); }\n  .sy-line { border-color: #29465C; }\n  .sy-focus:focus { outline: 2px solid #1BD1A5; outline-offset: 3px; }\n  .role-button[aria-pressed=\"true\"] { border-color: rgba(27,209,165,.7); background: rgba(27,209,165,.1); color: #fff; }\n  .role-button[aria-pressed=\"true\"] .role-dot { background: #1BD1A5; box-shadow: 0 0 0 4px rgba(27,209,165,.12); }\n  .role-button:hover { border-color: rgba(90,167,255,.65); background: rgba(90,167,255,.08); }\n  .status-pop { animation: sy-in .18s ease-out both; }\n  @keyframes sy-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }\n  @media (max-width: 900px) { .sy-layout { grid-template-columns: 1fr !important; } .sy-aside { display: none; } }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<div class=\"min-h-screen bg-[#08121D] text-[#EDF5F8]\" data-kid=\"1\" data-name=\"page root container\" style=\"--ink:#08121D;--slate:#0E1D2C;--elevated:#152A3D;--line:#29465C;--mint:#1BD1A5;--cyan:#5AA7FF;--amber:#E7B84B;--coral:#FF6870;\">\n    <div class=\"mx-auto min-h-screen max-w-[1440px] px-5 py-5 sm:px-8 lg:px-10\" data-kid=\"1-1\" data-name=\"page layout wrapper\">\n        <header class=\"flex items-center justify-between border-b border-[#29465C] pb-5\" data-kid=\"1-1-1\" data-name=\"header navigation container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name group\">\n                <div class=\"grid h-10 w-10 place-items-center rounded-[10px] border border-[#1BD1A5]/50 bg-[#1BD1A5]/10 text-[#1BD1A5]\" data-kid=\"1-1-1-1-1\" data-name=\"shield check icon wrapper\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-1-1-1-1-1\" data-lucide=\"shield-check\" data-name=\"shield check icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"brand name and tagline\">\n                    <p class=\"text-sm font-extrabold tracking-tight\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        SafeYatra\n                        <span class=\"text-[#1BD1A5]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"AI brand suffix\">\n                            AI\n                        </span>\n                    </p>\n                    <p class=\"mt-0.5 text-[10px] font-bold uppercase tracking-[.18em] text-white/42\" data-kid=\"1-1-1-1-2-2\" data-name=\"safety network tagline\">\n                        Safety network\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-3 text-xs\" data-kid=\"1-1-1-2\" data-name=\"header status and help group\">\n                <div class=\"hidden items-center gap-2 text-[#80E8CD] sm:flex\" data-kid=\"1-1-1-2-1\" data-name=\"system operational status group\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#1BD1A5]\" data-kid=\"1-1-1-2-1-1\" data-name=\"status indicator dot\">\n                    </span>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"system operational status text\">\n                        System operational\n                    </span>\n                </div>\n                <div class=\"sy-mono hidden text-[10px] text-white/40 md:block\" data-kid=\"1-1-1-2-2\" data-name=\"current location and time display\">\n                    NASHIK / 08:42 UTC\n                </div>\n                <button class=\"sy-focus flex min-h-10 items-center gap-2 rounded-[8px] border border-[#29465C] px-3 font-semibold text-white/70 hover:border-[#5AA7FF]/60 hover:text-white\" data-kid=\"1-1-1-2-3\" data-name=\"help button\" id=\"help-btn\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-1-2-3-1\" data-lucide=\"circle-help\" data-name=\"help icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-3-2\" data-name=\"help text\">\n                        Help\n                    </span>\n                </button>\n            </div>\n        </header>\n        <div class=\"mt-5 flex items-start gap-3 rounded-[10px] border border-[#FF6870]/45 bg-[#FF6870]/[.08] px-4 py-3 sm:items-center\" data-kid=\"1-1-2\" data-name=\"demo ready alert box\">\n            <i class=\"mt-0.5 h-4 w-4 shrink-0 text-[#FF9B9F] sm:mt-0\" data-kid=\"1-1-2-1\" data-lucide=\"radio-tower\" data-name=\"radio tower alert icon\">\n            </i>\n            <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-2\" data-name=\"alert text container\">\n                <p class=\"text-xs font-bold text-[#FFD7D9]\" data-kid=\"1-1-2-2-1\" data-name=\"alert title text\">\n                    Demo path ready · all four roles available\n                </p>\n                <p class=\"mt-1 text-xs text-[#FFD7D9]/65\" data-kid=\"1-1-2-2-2\" data-name=\"alert description text\">\n                    Use a role shortcut to enter the walkthrough without waiting for backend access.\n                </p>\n            </div>\n            <span class=\"sy-mono hidden text-[10px] text-[#FFB8BC] sm:block\" data-kid=\"1-1-2-3\" data-name=\"demo ready status label\">\n                DEMO-READY\n            </span>\n        </div>\n        <main class=\"sy-layout mt-10 grid grid-cols-[minmax(0,1.05fr)_minmax(440px,.95fr)] gap-12 lg:mt-14 lg:gap-20\" data-kid=\"1-1-3\" data-name=\"main content grid layout\">\n            <section class=\"sy-aside flex flex-col justify-between\" data-kid=\"1-1-3-1\" data-name=\"hero information section\">\n                <div data-kid=\"1-1-3-1-1\" data-name=\"hero text container\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[.16em] text-[#1BD1A5]\" data-kid=\"1-1-3-1-1-1\" data-name=\"role access category label\">\n                        Role-based access\n                    </p>\n                    <h1 class=\"mt-4 max-w-xl text-5xl font-extrabold leading-[1.02] tracking-[-.045em] text-white xl:text-6xl\" data-kid=\"1-1-3-1-1-2\" data-name=\"hero main headline\">\n                        One safety network.\n                        <br data-kid=\"1-1-3-1-1-2-1\" data-name=\"headline line break\"/>\n                        <span class=\"text-[#1BD1A5]\" data-kid=\"1-1-3-1-1-2-2\" data-name=\"headline accent text\">\n                            Four ways to act.\n                        </span>\n                    </h1>\n                    <p class=\"mt-6 max-w-lg text-base leading-7 text-white/60\" data-kid=\"1-1-3-1-1-3\" data-name=\"hero description text\">\n                        SafeYatra connects the tourist, control room, responder and system administrator around one verified incident record.\n                    </p>\n                </div>\n                <div class=\"mt-14 grid max-w-xl grid-cols-3 gap-4 border-t border-[#29465C] pt-5\" data-kid=\"1-1-3-1-2\" data-name=\"hero stats container\">\n                    <div data-kid=\"1-1-3-1-2-1\" data-name=\"tourists monitored stat\">\n                        <p class=\"sy-mono text-2xl font-bold text-white\" data-kid=\"1-1-3-1-2-1-1\" data-name=\"tourists monitored count\">\n                            1,250\n                        </p>\n                        <p class=\"mt-1 text-[11px] text-white/45\" data-kid=\"1-1-3-1-2-1-2\" data-name=\"tourists monitored label\">\n                            tourists monitored\n                        </p>\n                    </div>\n                    <div data-kid=\"1-1-3-1-2-2\" data-name=\"risk refresh stat\">\n                        <p class=\"sy-mono text-2xl font-bold text-[#5AA7FF]\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"risk refresh rate count\">\n                            18ms\n                        </p>\n                        <p class=\"mt-1 text-[11px] text-white/45\" data-kid=\"1-1-3-1-2-2-2\" data-name=\"risk refresh rate label\">\n                            risk refresh\n                        </p>\n                    </div>\n                    <div data-kid=\"1-1-3-1-2-3\" data-name=\"sync reliability stat\">\n                        <p class=\"sy-mono text-2xl font-bold text-[#1BD1A5]\" data-kid=\"1-1-3-1-2-3-1\" data-name=\"sync reliability percent\">\n                            99.2%\n                        </p>\n                        <p class=\"mt-1 text-[11px] text-white/45\" data-kid=\"1-1-3-1-2-3-2\" data-name=\"sync reliability label\">\n                            sync reliability\n                        </p>\n                    </div>\n                </div>\n            </section>\n            <section class=\"rounded-[12px] border border-[#29465C] bg-[#0E1D2C] p-5 sm:p-7\" data-kid=\"1-1-3-2\" data-name=\"login card container\">\n                <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-1-3-2-1\" data-name=\"login header group\">\n                    <div data-kid=\"1-1-3-2-1-1\" data-name=\"login header text\">\n                        <p class=\"text-[11px] font-bold uppercase tracking-[.16em] text-[#5AA7FF]\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"login category label\">\n                            Enter workspace\n                        </p>\n                        <h2 class=\"mt-2 text-2xl font-extrabold tracking-[-.025em] text-white\" data-kid=\"1-1-3-2-1-1-2\" data-name=\"login main title\">\n                            Sign in to SafeYatra\n                        </h2>\n                        <p class=\"mt-2 text-sm leading-6 text-white/55\" data-kid=\"1-1-3-2-1-1-3\" data-name=\"login subtitle text\">\n                            Choose a role or use your registered credentials.\n                        </p>\n                    </div>\n                    <div class=\"grid h-10 w-10 shrink-0 place-items-center rounded-[9px] border border-[#29465C] bg-[#152A3D] text-[#5AA7FF]\" data-kid=\"1-1-3-2-1-2\" data-name=\"key icon container\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-3-2-1-2-1\" data-lucide=\"key-round\" data-name=\"key icon\">\n                        </i>\n                    </div>\n                </div>\n                <div aria-label=\"Choose demo role\" class=\"mt-7 grid grid-cols-2 gap-2 sm:grid-cols-4\" data-kid=\"1-1-3-2-2\" data-name=\"demo role selection group\" role=\"group\">\n                    <button aria-pressed=\"true\" class=\"role-button sy-focus min-h-[72px] rounded-[9px] border border-[#29465C] bg-[#152A3D]/55 px-3 text-left text-xs font-bold text-white/72\" data-email=\"tourist@safeyatra.com\" data-kid=\"1-1-3-2-2-1\" data-name=\"tourist role button\" data-password=\"tour123\" data-role=\"tourist\">\n                        <span class=\"role-dot mb-3 block h-2 w-2 rounded-full bg-[#5AA7FF]\" data-kid=\"1-1-3-2-2-1-1\" data-name=\"role indicator dot\">\n                        </span>\n                        <span class=\"block\" data-kid=\"1-1-3-2-2-1-2\" data-name=\"role name\">\n                            Tourist\n                        </span>\n                        <span class=\"mt-1 block truncate text-[11px] font-medium text-white/42\" data-kid=\"1-1-3-2-2-1-3\" data-name=\"role description\">\n                            Aarav Mehta\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"role-button sy-focus min-h-[72px] rounded-[9px] border border-[#29465C] bg-[#152A3D]/55 px-3 text-left text-xs font-bold text-white/72\" data-email=\"auth@safeyatra.com\" data-kid=\"1-1-3-2-2-2\" data-name=\"authority role button\" data-password=\"auth123\" data-role=\"authority\">\n                        <span class=\"role-dot mb-3 block h-2 w-2 rounded-full bg-[#5AA7FF]\" data-kid=\"1-1-3-2-2-2-1\" data-name=\"role indicator dot\">\n                        </span>\n                        <span class=\"block\" data-kid=\"1-1-3-2-2-2-2\" data-name=\"role name\">\n                            Authority\n                        </span>\n                        <span class=\"mt-1 block truncate text-[11px] font-medium text-white/42\" data-kid=\"1-1-3-2-2-2-3\" data-name=\"role description\">\n                            Nashik Control\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"role-button sy-focus min-h-[72px] rounded-[9px] border border-[#29465C] bg-[#152A3D]/55 px-3 text-left text-xs font-bold text-white/72\" data-email=\"resp@safeyatra.com\" data-kid=\"1-1-3-2-2-3\" data-name=\"responder role button\" data-password=\"resp123\" data-role=\"responder\">\n                        <span class=\"role-dot mb-3 block h-2 w-2 rounded-full bg-[#5AA7FF]\" data-kid=\"1-1-3-2-2-3-1\" data-name=\"role indicator dot\">\n                        </span>\n                        <span class=\"block\" data-kid=\"1-1-3-2-2-3-2\" data-name=\"role name\">\n                            Responder\n                        </span>\n                        <span class=\"mt-1 block truncate text-[11px] font-medium text-white/42\" data-kid=\"1-1-3-2-2-3-3\" data-name=\"role description\">\n                            Ravi Patil\n                        </span>\n                    </button>\n                    <button aria-pressed=\"false\" class=\"role-button sy-focus min-h-[72px] rounded-[9px] border border-[#29465C] bg-[#152A3D]/55 px-3 text-left text-xs font-bold text-white/72\" data-email=\"admin@safeyatra.com\" data-kid=\"1-1-3-2-2-4\" data-name=\"admin role button\" data-password=\"admin123\" data-role=\"admin\">\n                        <span class=\"role-dot mb-3 block h-2 w-2 rounded-full bg-[#5AA7FF]\" data-kid=\"1-1-3-2-2-4-1\" data-name=\"role indicator dot\">\n                        </span>\n                        <span class=\"block\" data-kid=\"1-1-3-2-2-4-2\" data-name=\"role name\">\n                            Admin\n                        </span>\n                        <span class=\"mt-1 block truncate text-[11px] font-medium text-white/42\" data-kid=\"1-1-3-2-2-4-3\" data-name=\"role description\">\n                            System Admin\n                        </span>\n                    </button>\n                </div>\n                <form class=\"mt-7 space-y-4\" data-kid=\"1-1-3-2-3\" data-name=\"login form\" id=\"login-form\">\n                    <label class=\"block\" data-kid=\"1-1-3-2-3-1\" data-name=\"email input field\">\n                        <span class=\"mb-2 block text-xs font-bold text-white/75\" data-kid=\"1-1-3-2-3-1-1\" data-name=\"email label text\">\n                            Email address\n                        </span>\n                        <div class=\"relative\" data-kid=\"1-1-3-2-3-1-2\" data-name=\"email input wrapper\">\n                            <i class=\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-white/35\" data-kid=\"1-1-3-2-3-1-2-1\" data-lucide=\"mail\" data-name=\"email icon\">\n                            </i>\n                            <input autocomplete=\"email\" class=\"sy-focus h-12 w-full rounded-[8px] border border-[#29465C] bg-[#08121D] pl-10 pr-3 text-sm text-white outline-none placeholder:text-white/28\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3-1-2-2\" data-name=\"email input element\" data-reason=\"value updated by script based on role button selection\" id=\"email\" type=\"email\" value=\"tourist@safeyatra.com\"/>\n                        </div>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-1-3-2-3-2\" data-name=\"password input field\">\n                        <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-1-3-2-3-2-1\" data-name=\"password header group\">\n                            <span class=\"text-xs font-bold text-white/75\" data-kid=\"1-1-3-2-3-2-1-1\" data-name=\"password label text\">\n                                Password\n                            </span>\n                            <button class=\"sy-focus rounded text-xs font-semibold text-[#5AA7FF] hover:text-white\" data-kid=\"1-1-3-2-3-2-1-2\" data-name=\"forgot password button\" id=\"forgot-btn\" type=\"button\">\n                                Forgot password?\n                            </button>\n                        </div>\n                        <div class=\"relative\" data-kid=\"1-1-3-2-3-2-2\" data-name=\"password input wrapper\">\n                            <i class=\"pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-white/35\" data-kid=\"1-1-3-2-3-2-2-1\" data-lucide=\"lock-keyhole\" data-name=\"password icon\">\n                            </i>\n                            <input autocomplete=\"current-password\" class=\"sy-focus h-12 w-full rounded-[8px] border border-[#29465C] bg-[#08121D] pl-10 pr-12 text-sm text-white outline-none placeholder:text-white/28\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3-2-2-2\" data-name=\"password input element\" data-reason=\"value updated by script based on role button selection; type changed by toggle\" id=\"password\" type=\"password\" value=\"tour123\"/>\n                            <button aria-label=\"Show password\" class=\"sy-focus absolute right-3 top-1/2 grid h-8 w-8 -translate-y-1/2 place-items-center rounded text-white/45 hover:text-white\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3-2-2-3\" data-name=\"password visibility toggle button\" data-reason=\"aria-label and icon reinitialized by script on toggle\" id=\"password-toggle\" type=\"button\">\n                                <i class=\"h-4 w-4\" data-dynamic=\"true\" data-kid=\"1-1-3-2-3-2-2-3-1\" data-lucide=\"eye\" data-name=\"password toggle icon\" data-reason=\"replaced by script on toggle\">\n                                </i>\n                            </button>\n                        </div>\n                    </label>\n                    <button class=\"sy-focus flex min-h-12 w-full items-center justify-center gap-2 rounded-[8px] bg-[#1BD1A5] px-4 text-sm font-extrabold text-[#08121D] hover:bg-white\" data-kid=\"1-1-3-2-3-3\" data-name=\"submit sign-in button\" id=\"sign-in\" type=\"submit\">\n                        <span data-kid=\"1-1-3-2-3-3-1\" data-name=\"submit button text\">\n                            Sign in to workspace\n                        </span>\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-3-2-3-3-2\" data-lucide=\"arrow-up-right\" data-name=\"submit button icon\">\n                        </i>\n                    </button>\n                </form>\n                <div class=\"mt-5 flex flex-col gap-2 sm:flex-row\" data-kid=\"1-1-3-2-4\" data-name=\"login action buttons\">\n                    <button class=\"sy-focus flex min-h-11 flex-1 items-center justify-center gap-2 rounded-[8px] border border-[#29465C] px-3 text-xs font-bold text-white/72 hover:border-[#1BD1A5]/60 hover:text-white\" data-kid=\"1-1-3-2-4-1\" data-name=\"continue offline button\" id=\"offline-btn\" type=\"button\">\n                        <i class=\"h-4 w-4 text-[#E7B84B]\" data-kid=\"1-1-3-2-4-1-1\" data-lucide=\"cloud-off\" data-name=\"offline button icon\">\n                        </i>\n                        Continue offline\n                    </button>\n                    <button class=\"sy-focus flex min-h-11 flex-1 items-center justify-center gap-2 rounded-[8px] border border-[#29465C] px-3 text-xs font-bold text-white/72 hover:border-[#5AA7FF]/60 hover:text-white\" data-kid=\"1-1-3-2-4-2\" data-name=\"register account button\" id=\"register-btn\" type=\"button\">\n                        <i class=\"h-4 w-4 text-[#5AA7FF]\" data-kid=\"1-1-3-2-4-2-1\" data-lucide=\"user-plus\" data-name=\"register button icon\">\n                        </i>\n                        Register account\n                    </button>\n                </div>\n                <div class=\"mt-6 flex items-start gap-3 rounded-[9px] border border-[#1BD1A5]/25 bg-[#1BD1A5]/[.06] p-3.5\" data-kid=\"1-1-3-2-5\" data-name=\"offline information box\">\n                    <i class=\"mt-0.5 h-4 w-4 shrink-0 text-[#1BD1A5]\" data-kid=\"1-1-3-2-5-1\" data-lucide=\"wifi-off\" data-name=\"wifi off icon\">\n                    </i>\n                    <p class=\"text-xs leading-5 text-white/60\" data-kid=\"1-1-3-2-5-2\" data-name=\"offline info description\">\n                        <span class=\"font-bold text-[#80E8CD]\" data-kid=\"1-1-3-2-5-2-1\" data-name=\"offline ready bold text\">\n                            Offline-ready.\n                        </span>\n                        GPS, geo-fencing, AI risk analysis and SOS remain available locally. Pending events sync automatically when the network returns.\n                    </p>\n                </div>\n                <div aria-live=\"polite\" class=\"mt-4 hidden\" data-dynamic=\"true\" data-kid=\"1-1-3-2-6\" data-name=\"status feedback message\" data-reason=\"content replaced by feedback script\" id=\"feedback\" role=\"status\">\n                </div>\n            </section>\n        </main>\n        <footer class=\"mt-10 flex flex-col gap-3 border-t border-[#29465C] pt-5 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-4\" data-name=\"footer section\">\n            <span data-kid=\"1-1-4-1\" data-name=\"footer copyright text\">\n                Built for resilient travel across India.\n            </span>\n            <span class=\"sy-mono text-[10px]\" data-kid=\"1-1-4-2\" data-name=\"footer process flow text\">\n                DETECT → WARN → RESPOND → SYNC\n            </span>\n        </footer>\n    </div>\n</div>\n<script>\n    lucide.createIcons();\n  const $ = (s) => document.querySelector(s);\n  const $$ = (s) => [...document.querySelectorAll(s)];\n  const email = $('#email'); const password = $('#password'); const feedback = $('#feedback');\n  function showFeedback(message, tone = 'good') { feedback.className = `status-pop mt-4 rounded-[9px] border px-3 py-2.5 text-xs ${tone === 'warn' ? 'border-[#E7B84B]/35 bg-[#E7B84B]/10 text-[#F6D98A]' : 'border-[#1BD1A5]/30 bg-[#1BD1A5]/10 text-[#80E8CD]'}`; feedback.textContent = message; }\n  $$('.role-button').forEach((button) => button.addEventListener('click', () => { $$('.role-button').forEach((item) => item.setAttribute('aria-pressed', String(item === button))); email.value = button.dataset.email; password.value = button.dataset.password; showFeedback(`${button.dataset.role[0].toUpperCase() + button.dataset.role.slice(1)} demo selected · credentials loaded.`); }));\n  $('#login-form').addEventListener('submit', (event) => { event.preventDefault(); showFeedback(`Workspace ready for ${email.value}. Demo sign-in accepted.`); });\n  $('#password-toggle').addEventListener('click', () => { const next = password.type === 'password' ? 'text' : 'password'; password.type = next; $('#password-toggle').setAttribute('aria-label', next === 'password' ? 'Show password' : 'Hide password'); $('#password-toggle').innerHTML = `<i data-lucide=\"${next === 'password' ? 'eye' : 'eye-off'}\" class=\"h-4 w-4\"></i>`; lucide.createIcons(); });\n  $('#offline-btn').addEventListener('click', () => showFeedback('Offline workspace enabled · local safety signals remain active.', 'warn'));\n  $('#register-btn').addEventListener('click', () => showFeedback('Registration opens from the protected account flow.', 'warn'));\n  $('#forgot-btn').addEventListener('click', () => showFeedback('Demo mode uses the role shortcuts above instead of email recovery.', 'warn'));\n  $('#help-btn').addEventListener('click', () => showFeedback('Choose a role shortcut, then sign in. The demo path is ready.', 'good'));\n</script>\n",
      "comments": [],
      "created": "2026-07-26T05:40:00.463649+00:00",
      "modified": "2026-07-26T05:40:56.429027+00:00",
      "id": "var_379fa05aae4b"
    },
    "var_a9c4a8baa49d": {
      "type": "variant",
      "label": "Tourist Dashboard · High Alert",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 5995,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap');\n  .sy-tourist{min-height:100vh;background:#08121D;color:#EDF5F8;font-family:Inter,system-ui,sans-serif;padding:24px 30px 40px;box-sizing:border-box;letter-spacing:-.01em}\n  .sy-tourist button{font:inherit;cursor:pointer}\n  .sy-mono{font-family:'JetBrains Mono',ui-monospace,monospace;letter-spacing:.01em}\n  .sy-top{max-width:1240px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:4px 0 21px;border-bottom:1px solid #29465C}\n  .sy-brand{display:flex;align-items:center;gap:12px}\n  .sy-brand-mark{width:34px;height:34px;border:1px solid rgba(27,209,165,.55);border-radius:9px;display:grid;place-items:center;color:#1BD1A5;background:rgba(27,209,165,.08)}\n  .sy-brand-name{font-size:14px;font-weight:800;line-height:1.15}.sy-brand-name span{color:#1BD1A5}.sy-brand-sub{display:block;margin-top:4px;color:#7890A2;font-size:10px;letter-spacing:.15em;text-transform:uppercase}\n  .sy-top-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:flex-end}.sy-chip{display:inline-flex;align-items:center;gap:8px;border:1px solid #29465C;background:#0E1D2C;border-radius:8px;padding:9px 11px;color:#AFC0CC;font-size:11px;font-weight:700}.sy-chip.offline{color:#F5D48A;border-color:rgba(231,184,75,.52);background:rgba(231,184,75,.08)}.sy-chip .dot{width:7px;height:7px;border-radius:50%;background:#E7B84B;box-shadow:0 0 0 4px rgba(231,184,75,.1)}\n  .sy-user{display:flex;align-items:center;gap:9px;border-left:1px solid #29465C;padding-left:14px}.sy-avatar{width:30px;height:30px;border-radius:8px;background:#152A3D;display:grid;place-items:center;color:#8EEBD3;font:700 11px 'JetBrains Mono',monospace}.sy-user-name{font-size:11px;font-weight:700}.sy-user-role{margin-top:3px;color:#7890A2;font-size:10px}\n  .sy-wrap{max-width:1240px;margin:0 auto}.sy-alert{margin-top:18px;border:1px solid rgba(255,104,112,.52);border-left:4px solid #FF6870;border-radius:10px;background:rgba(255,104,112,.09);padding:13px 15px;display:flex;align-items:center;justify-content:space-between;gap:16px}.sy-alert-main{display:flex;align-items:center;gap:12px}.sy-alert-icon{width:32px;height:32px;display:grid;place-items:center;border-radius:8px;background:rgba(255,104,112,.16);color:#FF9096}.sy-alert-title{font-size:12px;font-weight:800}.sy-alert-copy{margin-top:4px;color:#D6A8AB;font-size:11px}.sy-alert-time{color:#E8B6B9;font:600 10px 'JetBrains Mono',monospace;white-space:nowrap}\n  .sy-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin:24px 0 16px}.sy-eyebrow{margin:0 0 7px;color:#69DDBE;font-size:10px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.sy-h1{margin:0;font-size:26px;line-height:1.12;letter-spacing:-.04em}.sy-heading-copy{margin:8px 0 0;color:#95A9B8;font-size:12px;line-height:1.55;max-width:610px}.sy-action{min-height:42px;border-radius:8px;padding:0 15px;border:1px solid #29465C;background:#152A3D;color:#EAF4F5;font-size:11px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;gap:8px}.sy-action:hover{border-color:#5AA7FF;color:#fff}.sy-action.primary{background:#1BD1A5;border-color:#1BD1A5;color:#071D20}.sy-action.primary:hover{background:#70E7CB}.sy-action.critical{background:#FF6870;border-color:#FF6870;color:#250A0C}.sy-action.critical:hover{background:#FF8A90}.sy-action.ghost{background:transparent;color:#AED1E6}\n  .sy-grid{display:grid;grid-template-columns:340px minmax(0,1fr) 325px;gap:14px;align-items:stretch}.sy-panel{background:#0E1D2C;border:1px solid #29465C;border-radius:10px;overflow:hidden}.sy-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:16px 17px 13px;border-bottom:1px solid #29465C}.sy-panel-kicker{margin:0 0 6px;color:#7890A2;font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.sy-panel-title{margin:0;color:#F4F8FA;font-size:14px;font-weight:800}.sy-panel-body{padding:16px 17px}\n  .sy-risk{height:100%;min-height:476px;background:#102333;border-color:rgba(255,104,112,.42)}.sy-risk-top{padding:19px 18px;border-bottom:1px solid #29465C;background:rgba(255,104,112,.065)}.sy-risk-row{display:flex;align-items:center;justify-content:space-between;gap:12px}.sy-risk-label{color:#F0B8BB;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.sy-risk-status{display:inline-flex;align-items:center;gap:6px;padding:6px 8px;border-radius:7px;background:rgba(255,104,112,.14);color:#FFB4B8;font-size:10px;font-weight:800}.sy-risk-score{margin-top:13px;display:flex;align-items:baseline;gap:8px}.sy-risk-score strong{font-size:48px;line-height:1;color:#FF7B82;letter-spacing:-.06em}.sy-risk-score span{color:#E7A9AE;font-size:12px;font-weight:700}.sy-risk-zone{margin-top:10px;color:#F2F5F6;font-size:13px;font-weight:700}.sy-risk-location{margin-top:5px;color:#AAB7C1;font-size:11px}.sy-meter{height:7px;background:#08121D;border-radius:99px;margin-top:17px;overflow:hidden}.sy-meter span{display:block;height:100%;width:87%;background:#FF6870;border-radius:99px}.sy-factors{padding:17px 18px}.sy-factors-title{margin:0 0 12px;color:#9FB1BE;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.sy-factor{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-top:1px solid rgba(41,70,92,.7)}.sy-factor:first-of-type{border-top:0;padding-top:0}.sy-factor-icon{width:24px;height:24px;display:grid;place-items:center;border-radius:6px;background:rgba(255,104,112,.11);color:#FF9096;flex:0 0 auto}.sy-factor-text{min-width:0}.sy-factor-name{font-size:11px;font-weight:700}.sy-factor-detail{margin-top:3px;color:#8DA3B1;font-size:10px;line-height:1.4}.sy-factor-score{margin-left:auto;color:#FF9CA1;font:700 11px 'JetBrains Mono',monospace;white-space:nowrap}.sy-factors-note{margin-top:13px;border:1px solid rgba(231,184,75,.36);background:rgba(231,184,75,.08);border-radius:8px;padding:10px;color:#F1D99E;font-size:10px;line-height:1.5}\n  .sy-map-panel{min-width:0}.sy-map-wrap{position:relative;height:476px;background:#0B2029}.sy-map-svg{position:absolute;inset:0;width:100%;height:100%}.sy-map-overlay{position:absolute;left:15px;top:14px;right:15px;display:flex;justify-content:space-between;gap:12px;pointer-events:none}.sy-map-context{border:1px solid rgba(41,70,92,.88);background:rgba(8,18,29,.89);border-radius:8px;padding:10px 11px}.sy-map-context .label{color:#6DDEC0;font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.sy-map-context .value{margin-top:5px;color:#F3F8F8;font-size:12px;font-weight:800}.sy-map-context .meta{margin-top:3px;color:#8FA5B3;font:10px 'JetBrains Mono',monospace}.sy-map-tools{display:flex;gap:7px}.sy-map-tool{width:32px;height:32px;border:1px solid #29465C;border-radius:7px;background:rgba(8,18,29,.9);color:#B3C4CF;display:grid;place-items:center}.sy-map-footer{position:absolute;bottom:13px;left:15px;right:15px;display:flex;justify-content:space-between;align-items:flex-end;gap:15px}.sy-legend{display:flex;gap:11px;flex-wrap:wrap;border:1px solid rgba(41,70,92,.9);background:rgba(8,18,29,.92);border-radius:8px;padding:9px 10px}.sy-legend-item{display:inline-flex;align-items:center;gap:6px;color:#C5D1D8;font-size:10px}.sy-legend-dot{width:8px;height:8px;border-radius:50%}.safe{background:#1BD1A5}.caution{background:#E7B84B}.danger{background:#FF6870}.sy-coord{border:1px solid rgba(41,70,92,.9);background:rgba(8,18,29,.92);border-radius:8px;padding:9px 10px;color:#C2D0D8;font:10px 'JetBrains Mono',monospace;white-space:nowrap}.sy-map-fallback{display:flex;align-items:center;gap:8px;padding:10px 13px;border-top:1px solid #29465C;background:#102333;color:#A8B9C4;font-size:10px;line-height:1.4}.sy-map-fallback strong{color:#DCE7EB}.sy-fallback-icon{color:#E7B84B;flex:0 0 auto}\n  .sy-inspector{min-height:476px}.sy-id{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 17px;border-bottom:1px solid #29465C;background:rgba(90,167,255,.06)}.sy-id-label{color:#8CB9E2;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.sy-id-value{margin-top:4px;color:#F2F7F9;font:700 12px 'JetBrains Mono',monospace}.sy-verified{display:inline-flex;align-items:center;gap:5px;color:#72E3C5;font-size:10px;font-weight:800}.sy-details{padding:16px 17px}.sy-detail{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:10px 0;border-top:1px solid rgba(41,70,92,.7)}.sy-detail:first-child{border-top:0;padding-top:0}.sy-detail-label{color:#8299A8;font-size:10px}.sy-detail-value{text-align:right;color:#F0F5F6;font-size:11px;font-weight:700}.sy-detail-value.mono{font:600 10px 'JetBrains Mono',monospace}.sy-detail-value.critical{color:#FF9EA4}.sy-timeline{padding:0 17px 17px}.sy-timeline-title{margin:0 0 10px;color:#8299A8;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.sy-step{display:flex;gap:10px;position:relative;padding:0 0 15px}.sy-step:not(:last-child)::before{content:'';position:absolute;left:9px;top:20px;bottom:0;width:1px;background:#35546A}.sy-step-dot{width:19px;height:19px;border-radius:50%;border:1px solid #547286;background:#152A3D;color:#AFC2CE;display:grid;place-items:center;z-index:1;flex:0 0 auto}.sy-step.done .sy-step-dot{background:rgba(27,209,165,.15);border-color:#1BD1A5;color:#76E4C7}.sy-step.active .sy-step-dot{background:rgba(255,104,112,.16);border-color:#FF6870;color:#FF9EA4;box-shadow:0 0 0 4px rgba(255,104,112,.1)}.sy-step-title{font-size:11px;font-weight:800}.sy-step-copy{margin-top:3px;color:#879DAA;font-size:10px;line-height:1.35}.sy-step-time{float:right;color:#7D96A4;font:9px 'JetBrains Mono',monospace}.sy-inspector-actions{padding:0 17px 17px;display:grid;gap:8px}.sy-button-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}.sy-button-row .sy-action{width:100%;padding:0 8px}.sy-bottom{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);gap:14px;margin-top:14px}.sy-sync{border:1px solid rgba(231,184,75,.42);background:rgba(231,184,75,.075);border-radius:10px;padding:15px 17px;display:flex;align-items:flex-start;gap:12px}.sy-sync-icon{width:30px;height:30px;border-radius:8px;background:rgba(231,184,75,.15);color:#F0CB74;display:grid;place-items:center;flex:0 0 auto}.sy-sync-title{font-size:12px;font-weight:800;color:#F4DB9B}.sy-sync-copy{margin-top:4px;color:#C8B783;font-size:11px;line-height:1.5}.sy-sync-copy strong{color:#F1D79A}.sy-progress{margin-top:10px;height:5px;border-radius:99px;background:#102333;overflow:hidden}.sy-progress span{display:block;width:63%;height:100%;background:#E7B84B}.sy-contact{border:1px solid #29465C;background:#0E1D2C;border-radius:10px;padding:15px 17px;display:flex;align-items:center;justify-content:space-between;gap:12px}.sy-contact-main{display:flex;align-items:center;gap:11px}.sy-contact-icon{width:30px;height:30px;border-radius:8px;background:rgba(27,209,165,.1);color:#61DDBE;display:grid;place-items:center}.sy-contact-title{font-size:11px;font-weight:800}.sy-contact-copy{margin-top:4px;color:#8EA3B0;font-size:10px}.sy-contact-link{border:0;background:transparent;color:#69DDBE;font-size:10px;font-weight:800;padding:8px}.sy-toast{position:fixed;right:26px;bottom:24px;width:285px;border:1px solid rgba(255,104,112,.58);background:#132637;border-radius:10px;padding:13px 14px;box-shadow:0 10px 24px rgba(0,0,0,.24);z-index:4}.sy-toast-top{display:flex;align-items:center;gap:8px;color:#FF9EA4;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.sy-toast-copy{margin-top:7px;color:#D7E2E6;font-size:11px;line-height:1.45}.sy-toast-close{float:right;border:0;background:transparent;color:#8FA6B3;font-size:14px;padding:0 0 0 10px}.sy-hidden{display:none!important}\n  @media (max-width:1100px){.sy-grid{grid-template-columns:310px minmax(0,1fr)}.sy-inspector{grid-column:1/-1;min-height:auto}.sy-bottom{grid-template-columns:1fr}.sy-map-wrap{height:430px}.sy-risk{min-height:auto}.sy-timeline{padding-bottom:12px}.sy-inspector-actions{padding-bottom:14px}}\n  @media (max-width:760px){.sy-tourist{padding:16px 14px 34px}.sy-top{align-items:flex-start;flex-direction:column}.sy-top-right{width:100%;justify-content:flex-start}.sy-user{margin-left:auto}.sy-heading{align-items:flex-start;flex-direction:column}.sy-h1{font-size:23px}.sy-heading>.sy-action{width:100%}.sy-alert{align-items:flex-start;flex-direction:column}.sy-alert-time{padding-left:44px}.sy-grid{display:flex;flex-direction:column}.sy-map-wrap{height:360px}.sy-map-footer{align-items:flex-start;flex-direction:column}.sy-coord{font-size:9px}.sy-button-row{grid-template-columns:1fr}.sy-toast{right:14px;bottom:14px;left:14px;width:auto}.sy-user-name,.sy-user-role{display:none}}\n</style>\n<div class=\"sy-tourist\" data-kid=\"1\" data-name=\"tourist dashboard layout container\">\n    <header class=\"sy-top\" data-kid=\"1-1\" data-name=\"main header section\">\n        <div class=\"sy-brand\" data-kid=\"1-1-1\" data-name=\"brand identity container\">\n            <div class=\"sy-brand-mark\" data-kid=\"1-1-1-1\" data-name=\"shield check icon\">\n                <i data-kid=\"1-1-1-1-1\" data-lucide=\"shield-check\" data-name=\"shield check svg\" style=\"width:18px;height:18px\">\n                </i>\n            </div>\n            <div data-kid=\"1-1-1-2\" data-name=\"brand text container\">\n                <div class=\"sy-brand-name\" data-kid=\"1-1-1-2-1\" data-name=\"brand name text\">\n                    SafeYatra\n                    <span data-kid=\"1-1-1-2-1-1\" data-name=\"brand ai label\">\n                        AI\n                    </span>\n                </div>\n                <span class=\"sy-brand-sub\" data-kid=\"1-1-1-2-2\" data-name=\"brand subheadline text\">\n                    Tourist safety network\n                </span>\n            </div>\n        </div>\n        <div class=\"sy-top-right\" data-kid=\"1-1-2\" data-name=\"header status and user area\">\n            <div class=\"sy-chip offline\" data-kid=\"1-1-2-1\" data-name=\"offline mode status chip\">\n                <span class=\"dot\" data-kid=\"1-1-2-1-1\" data-name=\"status dot\">\n                </span>\n                Offline mode · 3 queued\n            </div>\n            <div class=\"sy-chip\" data-kid=\"1-1-2-2\" data-name=\"gps active chip\">\n                <i data-kid=\"1-1-2-2-1\" data-lucide=\"navigation\" data-name=\"navigation icon\" style=\"width:14px;height:14px;color:#5AA7FF\">\n                </i>\n                GPS active\n            </div>\n            <div class=\"sy-user\" data-kid=\"1-1-2-3\" data-name=\"user profile summary\">\n                <div class=\"sy-avatar\" data-kid=\"1-1-2-3-1\" data-name=\"user avatar placeholder\">\n                    AM\n                </div>\n                <div data-kid=\"1-1-2-3-2\" data-name=\"user identification text\">\n                    <div class=\"sy-user-name\" data-kid=\"1-1-2-3-2-1\" data-name=\"user name text\">\n                        Aarav Mehta\n                    </div>\n                    <div class=\"sy-user-role\" data-kid=\"1-1-2-3-2-2\" data-name=\"user role text\">\n                        Tourist · SY-1001\n                    </div>\n                </div>\n            </div>\n        </div>\n    </header>\n    <main class=\"sy-wrap\" data-kid=\"1-2\" data-name=\"main content wrap\">\n        <div class=\"sy-alert\" data-kid=\"1-2-1\" data-name=\"alert notification box\">\n            <div class=\"sy-alert-main\" data-kid=\"1-2-1-1\" data-name=\"alert message main content\">\n                <div class=\"sy-alert-icon\" data-kid=\"1-2-1-1-1\" data-name=\"alert icon container\">\n                    <i data-kid=\"1-2-1-1-1-1\" data-lucide=\"triangle-alert\" data-name=\"alert triangle icon\" style=\"width:17px;height:17px\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-1-1-2\" data-name=\"alert text content\">\n                    <div class=\"sy-alert-title\" data-kid=\"1-2-1-1-2-1\" data-name=\"alert title text\">\n                        High risk detected · respond before automatic escalation\n                    </div>\n                    <div class=\"sy-alert-copy\" data-kid=\"1-2-1-1-2-2\" data-name=\"alert body text\">\n                        You entered Gangapur Dam Service Road and have not moved for 25 minutes. Your warning has been sent.\n                    </div>\n                </div>\n            </div>\n            <div class=\"sy-alert-time\" data-dynamic=\"true\" data-kid=\"1-2-1-2\" data-name=\"alert timestamp text\" data-reason=\"text updated to reflect current time or snapshot\">\n                08:47:12 UTC\n            </div>\n        </div>\n        <div class=\"sy-heading\" data-kid=\"1-2-2\" data-name=\"heading section\">\n            <div data-kid=\"1-2-2-1\" data-name=\"heading content\">\n                <p class=\"sy-eyebrow\" data-kid=\"1-2-2-1-1\" data-name=\"heading eyebrow label\">\n                    Active journey · Nashik → Trimbakeshwar\n                </p>\n                <h1 class=\"sy-h1\" data-kid=\"1-2-2-1-2\" data-name=\"main heading text\">\n                    Your safety signal needs attention.\n                </h1>\n                <p class=\"sy-heading-copy\" data-kid=\"1-2-2-1-3\" data-name=\"heading description\">\n                    SafeYatra is keeping your location available locally while the network is offline. SOS can still be created and will sync automatically when coverage returns.\n                </p>\n            </div>\n            <button class=\"sy-action ghost\" data-action=\"location\" data-kid=\"1-2-2-2\" data-name=\"send location button\">\n                <i data-kid=\"1-2-2-2-1\" data-lucide=\"locate-fixed\" data-name=\"locate fixed icon\" style=\"width:15px;height:15px\">\n                </i>\n                Send location update\n            </button>\n        </div>\n        <section class=\"sy-grid\" data-kid=\"1-2-3\" data-name=\"main dashboard grid\">\n            <article class=\"sy-panel sy-risk\" data-kid=\"1-2-3-1\" data-name=\"risk analysis panel\">\n                <div class=\"sy-risk-top\" data-kid=\"1-2-3-1-1\" data-name=\"risk panel header\">\n                    <div class=\"sy-risk-row\" data-kid=\"1-2-3-1-1-1\" data-name=\"risk status row\">\n                        <div class=\"sy-risk-label\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"risk label\">\n                            AI risk score\n                        </div>\n                        <div class=\"sy-risk-status\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"risk severity status\">\n                            <i data-kid=\"1-2-3-1-1-1-2-1\" data-lucide=\"shield-alert\" data-name=\"shield alert icon\" style=\"width:13px;height:13px\">\n                            </i>\n                            HIGH\n                        </div>\n                    </div>\n                    <div class=\"sy-risk-score\" data-kid=\"1-2-3-1-1-2\" data-name=\"risk score container\">\n                        <strong data-kid=\"1-2-3-1-1-2-1\" data-name=\"risk score percentage\">\n                            87%\n                        </strong>\n                        <span data-kid=\"1-2-3-1-1-2-2\" data-name=\"risk score label\">\n                            risk detected\n                        </span>\n                    </div>\n                    <div class=\"sy-risk-zone\" data-kid=\"1-2-3-1-1-3\" data-name=\"risk zone name\">\n                        Gangapur Dam Service Road\n                    </div>\n                    <div class=\"sy-risk-location\" data-kid=\"1-2-3-1-1-4\" data-name=\"risk location category\">\n                        Danger zone · Nashik district\n                    </div>\n                    <div class=\"sy-meter\" data-kid=\"1-2-3-1-1-5\" data-name=\"risk meter track\">\n                        <span data-kid=\"1-2-3-1-1-5-1\" data-name=\"risk meter fill bar\">\n                        </span>\n                    </div>\n                </div>\n                <div class=\"sy-factors\" data-kid=\"1-2-3-1-2\" data-name=\"risk factors list\">\n                    <p class=\"sy-factors-title\" data-kid=\"1-2-3-1-2-1\" data-name=\"factors list title\">\n                        Why the score changed\n                    </p>\n                    <div class=\"sy-factor\" data-kid=\"1-2-3-1-2-2\" data-name=\"risk factor row 1\">\n                        <div class=\"sy-factor-icon\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"factor 1 icon container\">\n                            <i data-kid=\"1-2-3-1-2-2-1-1\" data-lucide=\"map-pin\" data-name=\"map pin icon\" style=\"width:13px;height:13px\">\n                            </i>\n                        </div>\n                        <div class=\"sy-factor-text\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"factor 1 text\">\n                            <div class=\"sy-factor-name\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"factor 1 name\">\n                                Danger geo-fence crossed\n                            </div>\n                            <div class=\"sy-factor-detail\" data-kid=\"1-2-3-1-2-2-2-2\" data-name=\"factor 1 detail\">\n                                Restricted service road boundary\n                            </div>\n                        </div>\n                        <div class=\"sy-factor-score\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"factor 1 score\">\n                            +42\n                        </div>\n                    </div>\n                    <div class=\"sy-factor\" data-kid=\"1-2-3-1-2-3\" data-name=\"risk factor row 2\">\n                        <div class=\"sy-factor-icon\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"factor 2 icon container\">\n                            <i data-kid=\"1-2-3-1-2-3-1-1\" data-lucide=\"timer\" dat